(ns mail-app.desktop.widgets.compose-quote
  "Quoted original — collapse/uncollapse control; body as normal blocks."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [block-editor.widgets.reader :as reader]
            [mail-app.services.compose-export :as export]
            [mail-app.theme :as theme :refer [font-family]]))

(def ^:private reader-cfg
  {:block-style
   (fn [_b-type]
     (m/TextStyle .fontSize 16.0
                  .color theme/ink
                  .fontFamily font-family
                  .height 1.4))
   :block-plugins []})

(defn- label-style []
  (m/TextStyle .fontSize 14.0
               .color theme/ink-muted
               .fontFamily font-family))

(defn- flip-collapsed! [!quote-state]
  (swap! !quote-state update :collapsed? #(not (boolean %)))
  nil)

(defn- quote-plain 
  "Build plain text for normal blocks: From / Date / body."
  [state]
  (let [from (:quote-from state)
        date (:quote-date state)
        body (or (:quote-body state) "")
        lines (cond-> []
                (seq from) (conj (str "From: " from))
                (seq date) (conj (str "Date: " date))
                (and (or (seq from) (seq date)) (seq body)) (conj "")
                (seq body) (into (str/split-lines body)))]
    (str/join "\n" (if (seq lines) lines [""]))))

(defn- content-blocks [plain]
  (let [state (export/state-from-plain-text plain)
        root (:root state)
        blocks (:blocks state)]
    (mapv (fn [id]
            (m/Padding
             .padding (m.EdgeInsets/only .left 16.0)
             .child
             (reader/block-reader-view (get blocks id) [] reader-cfg)))
          root)))

(defn panel
  "Quoted From/Date/body as ordinary blocks.
   Pass `:toggle? false` to always show the body (no collapse/uncollapse)."
  [!quote-state & {:keys [toggle?] :or {toggle? true}}]
  (f/widget
   :watch [state !quote-state]
   (let [collapsed? (if toggle?
                      (boolean (:collapsed? state true))
                      false)
         label (if collapsed? "uncollapse" "collapse")
         plain (quote-plain state)]
     (m/Container
      .decoration (m/BoxDecoration
                   .color theme/paper
                   .border (m/Border
                            .left (m/BorderSide .color theme/divider)))
      .padding (m.EdgeInsets/only .left 8.0 .top 16.0 .bottom 16.0 .right 8.0)
      .child
      (m/SingleChildScrollView
       .scrollDirection m.Axis/horizontal
       .child
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/start
        .children
        (vec
         (concat
          (when toggle?
            [(m/Material
              .color m.Colors/transparent
              .child
              (m/InkWell
               .onTap #(flip-collapsed! !quote-state)
               .borderRadius (m/BorderRadius.circular 4.0)
               .child
               (m/Padding
                .padding (m.EdgeInsets/all 8.0)
                .child
                (mgl/MongolText label .style (label-style)))))])
          (when-not collapsed?
            (content-blocks plain))))))))))
