(ns mail-app.desktop.widgets.maillist
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]))

(def ^:private font-family "MongolianBaiZheng")

(defn- subject-of [^mc/MailMessageDto msg]
  (let [s (.-subject msg)]
    (if (or (nil? s) (empty? s)) "No Subject" s)))

(defn- pad2 [n]
  (.padLeft (.toString n) 2 "0"))

(defn- format-date [^DateTime d]
  (when d
    (str (pad2 (.month d)) "/" (pad2 (.day d)))))

(defn- is-modifier-pressed? [^s/HardwareKeyboard kb key1 key2]
  (or (.isLogicalKeyPressed kb key1)
      (.isLogicalKeyPressed kb key2)))

(defn- cmd-or-ctrl-pressed? [^s/HardwareKeyboard kb]
  (or (is-modifier-pressed? kb s.LogicalKeyboardKey/metaLeft s.LogicalKeyboardKey/metaRight)
      (is-modifier-pressed? kb s.LogicalKeyboardKey/controlLeft s.LogicalKeyboardKey/controlRight)))

(defn- shift-pressed? [^s/HardwareKeyboard kb]
  (is-modifier-pressed? kb s.LogicalKeyboardKey/shiftLeft s.LogicalKeyboardKey/shiftRight))

(defn- message-item [idx ^mc/MailMessageDto msg]
  (f/widget
   :get [m/Navigator]
   :watch [{:keys [selected-mailbox selected-message-ids last-clicked-index mail-list]}
           store/app-state]
   (let [draft? (or (= selected-mailbox :draft)
                    (= (.-state msg) "draft")
                    (= (.-folderRole msg) "draft"))
         selected? (contains? selected-message-ids (.-id msg))
         unread? (not (.-isRead msg))
         title-color (if unread? m.Colors/black87 m.Colors/black45)
         subtitle-color (if unread? m.Colors/black54 m.Colors/black38)]
     (m/Container
      .color (if selected?
               (-> m.Colors/blue (.withOpacity 0.1))
               m.Colors/transparent)
      .child
      (mgl/MongolListTile
       .leading (when unread?
                  (m/Container
                   .width 8.0
                   .height 8.0
                   .decoration (m/BoxDecoration
                                .color m.Colors/blue
                                .shape m.BoxShape/circle)))
       .title (m/Padding
               .padding (m.EdgeInsets/only .top 8.0)
               .child
               (mgl/MongolText
                (subject-of msg)
                .style (m/TextStyle
                        .fontSize 16.0
                        .fontFamily font-family
                        .color title-color
                        .fontWeight (if unread?
                                      m/FontWeight.bold
                                      m/FontWeight.normal))))
       .subtitle (m/Column
                  .crossAxisAlignment m.CrossAxisAlignment/start
                  .mainAxisSize m.MainAxisSize/min
                  .children
                  [(mgl/MongolText
                    (or (.-fromName msg) (.-from msg) "")
                    .style (m/TextStyle .fontSize 13.0
                                        .fontFamily font-family
                                        .color subtitle-color))
                   (m/SizedBox .height 4.0)
                   (m/Text (or (format-date (.-date msg)) "")
                           .style (m/TextStyle .fontSize 11.0
                                               .color m.Colors/black45))])
       .trailing (m/Row
                  .mainAxisSize m.MainAxisSize/min
                  .children
                  (cond-> []
                    (.-isStarred msg)
                    (conj (m/Icon m.Icons/star .size 14.0 .color m.Colors/amber))
                    (.-hasAttachment msg)
                    (conj (m/Icon m.Icons/attach_file .size 16.0
                                  .color m.Colors/black45))))
       .onTap (fn []
                (let [kb (.-instance s/HardwareKeyboard)
                      cmd? (cmd-or-ctrl-pressed? kb)
                      shift? (shift-pressed? kb)
                      has-selection? (seq selected-message-ids)]
                  (cond
                    ;; Shift: range select from last-clicked to this index
                    shift?
                    (let [last-idx (or last-clicked-index 0)
                          start (min last-idx idx)
                          end (max last-idx idx)
                          target-msgs (->> mail-list
                                           (drop start)
                                           (take (inc (- end start))))
                          ids (set (map #(.-id ^mc/MailMessageDto %) target-msgs))]
                      (store/set-selected-message-ids!
                       (into selected-message-ids ids))
                      (store/set-last-clicked-index! idx))

                    ;; Cmd/Ctrl: toggle individual selection
                    cmd?
                    (do
                      (store/toggle-message-selection! (.-id msg))
                      (store/set-last-clicked-index! idx))

                    ;; Already in multi-select: clear and open
                    has-selection?
                    (do
                      (store/clear-message-selection!)
                      (mail/open-message! (.-id msg))
                      (.pushNamed navigator "/mail_detail"))

                    ;; Normal single open / edit draft
                    :else
                    (do
                      (store/set-last-clicked-index! idx)
                      (if draft?
                        (-> (mail/edit-draft! (.-id msg))
                            (.then (fn [_]
                                     (.pushNamed navigator "/compose")
                                     nil))
                            (.catchError (fn [_]
                                           (mail/open-message! (.-id msg))
                                           (.pushNamed navigator "/mail_detail")
                                           nil)))
                        (do
                          (mail/open-message! (.-id msg))
                          (.pushNamed navigator "/mail_detail"))))))
                nil))))))

(defn- outbox-item [^mc/MailOutboxDto row]
  (f/widget
   :get [m/Navigator]
   (mgl/MongolListTile
    .title (m/Padding
            .padding (m.EdgeInsets/only .top 8.0)
            .child
            (mgl/MongolText
             (or (.-subject row) "No Subject")
             .style (m/TextStyle .fontSize 16.0 .fontFamily font-family)))
    .subtitle (mgl/MongolText
               (str (.-status row)
                    (when (.-lastError row)
                      (str " · " (.-lastError row))))
               .style (m/TextStyle .fontSize 12.0
                                   .fontFamily font-family
                                   .color m.Colors/black54))
    .trailing (when (or (= (.-status row) "failed")
                         (= (.-status row) "pending"))
                (m/IconButton
                 .icon (m/Icon m.Icons/refresh)
                 .tooltip "Retry"
                 .onPressed (fn []
                              (mail/retry-outbox! (.-id row))
                              nil)))
    .onTap (fn []
             (mail/open-message! (.-messageId row))
             (.pushNamed navigator "/mail_detail")
             nil))))

(defn list-view
  []
  (f/widget
   :watch [{:keys [selected-mailbox mail-list outbox-list]} store/app-state]
   (let [outbox? (= selected-mailbox :outbox)
         items (if outbox? outbox-list mail-list)]
     (if (empty? items)
       (m/Center
        .child (mgl/MongolText
                "empty."
                .style (m/TextStyle .fontFamily font-family
                                    .color m.Colors/black54)))
       (m/ListView
        .scrollDirection m.Axis/horizontal
        .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
        .children
        (if outbox?
          (mapv outbox-item items)
          (map-indexed (fn [idx msg] (message-item idx msg)) items)))))))
