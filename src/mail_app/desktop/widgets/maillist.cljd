(ns mail-app.desktop.widgets.maillist
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [mail-app.shared.utils.format :as fmt]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

;; --- Conversation threading (Message-ID / threadId) ---

(defn- thread-key-of
  "Stable conversation key from mail_core threadId."
  [^mc/MailMessageDto msg]
  (let [t (.-threadId msg)]
    (if (or (nil? t) (empty? t))
      (str "id-" (.-id msg))
      t)))

(defn- thread-messages
  "Group a flat mail list into threads ordered by latest date desc."
  [msgs]
  (let [grouped (group-by thread-key-of msgs)
        threads (map (fn [[k v]]
                       (let [sorted (sort-by #(.-date ^mc/MailMessageDto %)
                                             (fn [^DateTime d1 ^DateTime d2] (.compareTo d2 d1))
                                             v)]
                         {:thread-key k
                          :latest (first sorted)
                          :messages sorted
                          :count (count sorted)}))
                     grouped)]
    (sort-by #(.-date ^mc/MailMessageDto (:latest %))
             (fn [^DateTime d1 ^DateTime d2] (.compareTo d2 d1))
             threads)))

;; --- UI ---

(defn- subject-of [^mc/MailMessageDto msg]
  (let [s (.-subject msg)]
    (if (or (nil? s) (empty? s)) "No Subject" s)))

(defn- format-date [^DateTime d]
  (when d
    (str (fmt/pad2 (.month d)) "/" (fmt/pad2 (.day d)))))

(defn- sender-subtitle [^mc/MailMessageDto msg]
  (let [name (or (.-fromName msg) "")
        addr (or (.-from msg) "")]
    (cond
      (and (seq name) (seq addr)
           (not= name addr))
      (str name "\n" addr)
      (seq name) name
      :else addr)))

(defn- sender-initial [^mc/MailMessageDto msg]
  (let [s (or (.-fromName msg) (.-from msg) "")]
    (if (pos? (.-length s))
      (.substring s 0 1)
      "?")))

(defn- is-modifier-pressed? [^s/HardwareKeyboard kb key1 key2]
  (or (.isLogicalKeyPressed kb key1)
      (.isLogicalKeyPressed kb key2)))

(defn- cmd-or-ctrl-pressed? [^s/HardwareKeyboard kb]
  (or (is-modifier-pressed? kb s.LogicalKeyboardKey/metaLeft s.LogicalKeyboardKey/metaRight)
      (is-modifier-pressed? kb s.LogicalKeyboardKey/controlLeft s.LogicalKeyboardKey/controlRight)))

(defn- shift-pressed? [^s/HardwareKeyboard kb]
  (is-modifier-pressed? kb s.LogicalKeyboardKey/shiftLeft s.LogicalKeyboardKey/shiftRight))

(defn- mail-card [_bg selected? child]
  (m/Container
   .width theme/mail-col-width
   .margin (m.EdgeInsets/symmetric .horizontal theme/space-sm .vertical theme/space-md)
   .decoration (m/BoxDecoration
                .color (if selected? (theme/sky-soft) (theme/surface))
                .borderRadius (m/BorderRadius.circular theme/radius-md)
                .border (when selected?
                          (m/Border.all .color (theme/sky) .width 1.5))
                .boxShadow (if selected? 
                             (theme/card-shadow) 
                             (theme/hair-shadow)))
   .child
   (m/ClipRRect
    .borderRadius (m/BorderRadius.circular theme/radius-md)
    .child child)))

(defn- message-item [idx ^mc/MailMessageDto msg & {:keys [thread-count thread-key is-child? header?]}]
  (f/widget
   :get [m/Navigator]
   :watch [{:keys [selected-mailbox selected-message-ids selected-message-id
                   last-clicked-index mail-list expanded-threads]}
           store/app-state]
   (let [draft? (or (= selected-mailbox :draft)
                    (= (.-state msg) "draft")
                    (= (.-folderRole msg) "draft"))
         multi-selected? (contains? selected-message-ids (.-id msg))
         open-selected? (= selected-message-id (.-id msg))
         selected? (or multi-selected? open-selected?)
         unread? (not (.-isRead msg))
         title-color (if unread? (theme/ink) (theme/ink-muted))
         subtitle-color (if unread? (theme/ink-muted) (.withOpacity (theme/ink-muted) 0.8))
         expanded? (contains? expanded-threads thread-key)
         display-subject (if (and header? (> thread-count 1))
                           (str (subject-of msg) " (" thread-count ")")
                           (subject-of msg))
         bg (cond
              multi-selected? (theme/sky-soft)
              open-selected? (theme/sky-light)
              is-child? (theme/paper)
              :else (theme/surface))
         open-or-edit!
         (fn []
           (store/set-last-clicked-index! idx)
           (if draft?
             (-> (mail/edit-draft! (.-id msg))
                 (.then (fn [_] (.pushNamed navigator "/compose") nil))
                 (.catchError (fn [_]
                                (mail/open-message! (.-id msg))
                                nil)))
             (mail/open-message! (.-id msg)))
           nil)]
     (mail-card
      bg selected?
      (m/Material
       .color bg
       .child
       (m/InkWell
        .hoverColor (theme/hover)
        .onTap (fn []
                 (let [kb (.-instance s/HardwareKeyboard)
                       cmd? (cmd-or-ctrl-pressed? kb)
                       shift? (shift-pressed? kb)
                       has-selection? (seq selected-message-ids)]
                   (cond
                     shift?
                     (let [last-idx (or last-clicked-index 0)
                           start (min last-idx idx)
                           end (max last-idx idx)
                           target-msgs (->> mail-list (drop start) (take (inc (- end start))))
                           ids (set (map #(.-id ^mc/MailMessageDto %) target-msgs))]
                       (store/set-selected-message-ids! (into selected-message-ids ids))
                       (store/set-last-clicked-index! idx))

                     cmd?
                     (do
                       (store/toggle-message-selection! (.-id msg))
                       (store/set-last-clicked-index! idx))

                     has-selection?
                     (do
                       (store/clear-message-selection!)
                       (mail/open-message! (.-id msg)))

                     :else
                     (open-or-edit!)))
                 nil)
        .child
        (m/Padding
         .padding (if is-child?
                    (m.EdgeInsets/only .top theme/space-2xl .left theme/space-sm .right theme/space-sm)
                    (m.EdgeInsets/symmetric .horizontal theme/space-xs .vertical theme/space-sm))
         .child
         (mgl/MongolListTile
          .leading (m/Container
                    .width 32.0
                    .height 32.0
                    .alignment m.Alignment/center
                    .decoration (m/BoxDecoration
                                 .color (if unread? (theme/sky-soft) (theme/paper-deep))
                                 .shape m.BoxShape/circle)
                    .child
                    (m/Text (sender-initial msg)
                            .style (m/TextStyle
                                    .fontSize theme/text-sm
                                    .fontWeight m/FontWeight.w600
                                    .color (if unread? (theme/sky-deep) (theme/ink-muted))
                                    .fontFamily font-family)))
          .title (m/Padding
                  .padding (m.EdgeInsets/only .top theme/space-md)
                  .child
                  (mgl/MongolText
                   display-subject
                   .style (m/TextStyle
                           .fontSize theme/text-md
                           .fontFamily font-family
                           .color title-color
                           .height 1.5
                           .letterSpacing 0.2
                           .fontWeight (if unread?
                                         m/FontWeight.w700
                                         m/FontWeight.normal))))
          .subtitle (m/Column
                     .crossAxisAlignment m.CrossAxisAlignment/start
                     .mainAxisSize m.MainAxisSize/min
                     .children
                     [(mgl/MongolText
                       (sender-subtitle msg)
                       .style (m/TextStyle .fontSize theme/text-sm
                                           .fontFamily font-family
                                           .color subtitle-color
                                           .height 1.45
                                           .letterSpacing 0.1))
                      (m/SizedBox .height theme/space-sm)
                      (mgl/MongolText (or (format-date (.-date msg)) "")
                                      .style (m/TextStyle .fontSize theme/text-xs
                                                          .color (theme/ink-muted)
                                                          .letterSpacing 0.1))])
          .trailing (m/Padding
                     .padding (m.EdgeInsets/only .top theme/space-sm)
                     .child
                     (m/Row
                      .mainAxisSize m.MainAxisSize/min
                      .children
                      (cond-> []
                        unread?
                        (conj (m/Container
                               .width 8.0
                               .height 8.0
                               .margin (m.EdgeInsets/only .right theme/space-xs)
                               .decoration (m/BoxDecoration
                                            .color (theme/sky)
                                            .shape m.BoxShape/circle
                                            .boxShadow [(m/BoxShadow
                                                         .color (.withOpacity (theme/sky) 0.3)
                                                         .blurRadius 4.0
                                                         .spreadRadius 1.0)])))
                        (and header? (> thread-count 1))
                        (conj (m/GestureDetector
                               .behavior m.HitTestBehavior/opaque
                               .onTap (fn []
                                        (store/toggle-thread-expansion! thread-key)
                                        nil)
                               .child (m/Padding
                                       .padding (m.EdgeInsets/all theme/space-xs)
                                       .child
                                       (m/Icon (if expanded?
                                                 m.Icons/unfold_less
                                                 m.Icons/unfold_more)
                                               .size 18.0 .color (theme/sky)))))
                        (.-isStarred msg)
                        (conj (m/Padding
                               .padding (m.EdgeInsets/symmetric .horizontal theme/space-xs)
                               .child
                               (m/Icon m.Icons/star .size 16.0 .color (theme/gold))))
                        (.-hasAttachment msg)
                        (conj (m/Padding
                               .padding (m.EdgeInsets/symmetric .horizontal theme/space-xs)
                               .child
                               (m/Icon m.Icons/attach_file .size 17.0
                                       .color (theme/ink-muted)))))))))))))))

(defn- outbox-item [^mc/MailOutboxDto row]
  (f/widget
   (mail-card
    (theme/surface) false
    (m/Padding
     .padding (m.EdgeInsets/symmetric .horizontal theme/space-sm .vertical theme/space-md)
     .child
     (mgl/MongolListTile
      .title (m/Padding
              .padding (m.EdgeInsets/only .top theme/space-md)
              .child
              (mgl/MongolText
               (or (.-subject row) "No Subject")
               .style (m/TextStyle .fontSize theme/text-md 
                                   .fontFamily font-family 
                                   .height 1.5
                                   .letterSpacing 0.2
                                   .color (theme/ink)
                                   .fontWeight m/FontWeight.w600)))
      .subtitle (mgl/MongolText
                 (str (.-status row)
                      (when (.-lastError row)
                        (str " · " (.-lastError row))))
                 .style (m/TextStyle .fontSize theme/text-sm
                                     .fontFamily font-family
                                     .height 1.4
                                     .letterSpacing 0.1
                                     .color (theme/ink-muted)))
      .trailing (when (or (= (.-status row) "failed")
                          (= (.-status row) "pending"))
                  (m/Container
                   .margin (m.EdgeInsets/only .top theme/space-sm)
                   .child
                   (m/IconButton
                    .icon (m/Icon m.Icons/refresh .color (theme/sky) .size 20.0)
                    .tooltip "Retry"
                    .style (m/IconButton.styleFrom
                            .backgroundColor (theme/sky-light)
                            .shape (m/RoundedRectangleBorder
                                    .borderRadius (m/BorderRadius.circular theme/radius-sm)))
                    .onPressed (fn []
                                 (mail/retry-outbox! (.-id row))
                                 nil))))
      .onTap (fn []
               (mail/open-message! (.-messageId row))
               nil))))))

(defn- make-scroll-resource []
  (let [ctrl (m/ScrollController.)
        listener
        (fn []
          (when (.-hasClients ctrl)
            (let [pos (.-position ctrl)]
              (when (>= (.-pixels pos)
                        (- (.-maxScrollExtent pos) 150.0))
                (mail/load-more!)))))]
    (.addListener ctrl listener)
    {:controller ctrl :listener listener}))

(defn- dispose-scroll-resource! [{:keys [controller listener]}]
  (.removeListener ^m/ScrollController controller listener)
  (.dispose ^m/ScrollController controller)
  nil)

(defn list-view
  "Horizontal Mongol conversation columns."
  []
  (f/widget
   :managed [scroll-resource (make-scroll-resource)
             :dispose dispose-scroll-resource!]
   :watch [{:keys [selected-mailbox mail-list outbox-list expanded-threads
                   loading-more?]} store/app-state]
   (let [scroll-ctrl (:controller scroll-resource)
         outbox? (= selected-mailbox :outbox)
         items (if outbox? outbox-list mail-list)]
     (if (empty? items)
       (theme/empty-state
        (if outbox? m.Icons/outbox m.Icons/inbox_outlined)
        "ᠬᠣᠭᠣᠰᠣᠨ")
       (let [visual-items
             (if outbox?
               (vec items)
               (let [threads (thread-messages items)]
                 (vec
                  (mapcat (fn [{:keys [thread-key latest messages count]}]
                            (if (and (> count 1) (contains? expanded-threads thread-key))
                              (into [{:msg latest :thread-count count :thread-key thread-key :header? true}]
                                    (map #(hash-map :msg % :is-child? true) (rest messages)))
                              [{:msg latest :thread-count count :thread-key thread-key :header? true}]))
                          threads))))]
         (m/ListView.separated
          .controller scroll-ctrl
          .scrollDirection m.Axis/horizontal
          .padding (m.EdgeInsets/symmetric .horizontal theme/space-lg .vertical theme/space-lg)
          .itemCount (if (and loading-more? (not outbox?))
                       (inc (count visual-items))
                       (count visual-items))
          .separatorBuilder (fn [_ _] (m/SizedBox .width theme/space-sm))
          .itemBuilder (fn [_ idx]
                         (if (= idx (count visual-items))
                           (m/Container
                            .width 80.0
                            .alignment m.Alignment/center
                            .child 
                            (m/Column
                             .mainAxisSize m.MainAxisSize/min
                             .children
                             [(m/CircularProgressIndicator.
                               .strokeWidth 2.5
                               .color (theme/sky))
                              (m/SizedBox .height theme/space-md)
                              (m/Text "Loading..."
                                      .style (m/TextStyle
                                              .fontSize theme/text-xs
                                              .color (theme/ink-muted)))]))
                           (if outbox?
                             (outbox-item (nth visual-items idx))
                             (let [{:keys [msg thread-count thread-key is-child? header?]}
                                   (nth visual-items idx)]
                               (message-item idx msg
                                             :thread-count thread-count
                                             :thread-key thread-key
                                             :is-child? is-child?
                                             :header? header?)))))))))))