(ns mail-app.desktop.widgets.account-menu
  "Account switcher + remove / add / edit / signature actions."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [components.dialog :as dialog]
            [components.menu :as menu]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]
            [rich-editor.components.text-field :as custom-tf]
            [shared-ime.overlay-view :as overlay]))

(defn- edit-account-dialog!
  [ctx ^mc/MailAccountDto account]
  (let [oauth? (= (.-authType account) "oauth2")
        display-ctrl (m/TextEditingController.
                      .text (or (.-displayName account) ""))
        pass-ctrl (m/TextEditingController.)
        imap-ctrl (m/TextEditingController.
                   .text (or (.-imapHost account) ""))
        smtp-ctrl (m/TextEditingController.
                   .text (or (.-smtpHost account) ""))
        imap-port-ctrl (m/TextEditingController.
                        .text (str (or (.-imapPort account) 993)))
        smtp-port-ctrl (m/TextEditingController.
                        .text (str (or (.-smtpPort account) 465)))]
    (-> (m/showDialog
         .context ctx
         .builder
         (fn [dialog-ctx]
           (dialog/vertical-custom-dialog
            {:title "Edit account"
             :width-factor 0.85
             :height-factor 0.75
             :body
             (m/SingleChildScrollView
              .child
              (m/Column
               .mainAxisSize m.MainAxisSize/min
               .crossAxisAlignment m.CrossAxisAlignment/start
               .children
               [(m/Text (.-email account)
                        .style (m/TextStyle .color m.Colors/black54))
                (m/SizedBox .height 12.0)
                (m/TextField .controller display-ctrl
                             .decoration (m/InputDecoration .labelText "Display name"))
                (when-not oauth?
                  (m/TextField .controller pass-ctrl
                               .obscureText true
                               .decoration (m/InputDecoration
                                            .labelText "New password (optional)")))
                (m/TextField .controller imap-ctrl
                             .decoration (m/InputDecoration .labelText "IMAP host"))
                (m/TextField .controller imap-port-ctrl
                             .keyboardType m.TextInputType/number
                             .decoration (m/InputDecoration .labelText "IMAP port"))
                (m/TextField .controller smtp-ctrl
                             .decoration (m/InputDecoration .labelText "SMTP host"))
                (m/TextField .controller smtp-port-ctrl
                             .keyboardType m.TextInputType/number
                             .decoration (m/InputDecoration .labelText "SMTP port"))]))
             :actions
             [(m/TextButton
               .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx) false) nil)
               .child (mgl/MongolText "Cancel"))
              (m/TextButton
               .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx) true) nil)
               .child (mgl/MongolText "Save"))]})))
        (.then (fn [ok?]
                 (when ok?
                   (let [imap-port (try (int (str/trim (.-text imap-port-ctrl)))
                                        (catch Exception _ nil))
                         smtp-port (try (int (str/trim (.-text smtp-port-ctrl)))
                                        (catch Exception _ nil))
                         pass (str/trim (.-text pass-ctrl))]
                     (-> (mail/update-account!
                          {:account-id (.-id account)
                           :display-name (let [d (str/trim (.-text display-ctrl))]
                                           (when (seq d) d))
                           :password (when (and (not oauth?) (seq pass)) pass)
                           :imap-host (let [h (str/trim (.-text imap-ctrl))]
                                        (when (seq h) h))
                           :imap-port imap-port
                           :smtp-host (let [h (str/trim (.-text smtp-ctrl))]
                                        (when (seq h) h))
                           :smtp-port smtp-port})
                         (.then (fn [_]
                                  (toast/success! ctx "Account updated")
                                  nil))
                         (.catchError (fn [e]
                                        (toast/error! ctx (str e))
                                        nil)))))
                 nil))
        (.catchError (fn [_] nil)))
    nil))

(defn signature-dialog!
  [ctx account-id email]
  (let [ctrl (m/TextEditingController.
              .text (or (store/get-signature account-id) ""))
        !ime (atom {})]
    (m/showDialog
     .context ctx
     .builder
     (fn [d-ctx]
       (f/widget
        :managed [focus-node (m/FocusNode)]
        (overlay/ime-global-wrapper
         (dialog/vertical-custom-dialog
          {:title "Signature"
           :width-factor 0.7
           :height-factor 0.7
           :body
           (m/Column
            .crossAxisAlignment m.CrossAxisAlignment/stretch
            .children
            [(m/Text (or email "")
                     .style (m/TextStyle .color m.Colors/black54 .fontSize 13.0))
             (m/SizedBox .height 8.0)
             (m/Expanded
              .child
              (m/GestureDetector
               .behavior m.HitTestBehavior/opaque
               .onTap (fn [] (.requestFocus focus-node) nil)
               .child
               (m/Container
                .padding (m.EdgeInsets/all 8.0)
                .alignment m.Alignment/topLeft
                .decoration (m/BoxDecoration
                             .color theme/paper
                             .border (m/Border.all .color theme/divider)
                             .borderRadius (m/BorderRadius.circular 8.0))
                .child
                (custom-tf/text-field
                 !ime
                 {:controller ctrl
                  :focus-node focus-node
                  :hint "Enter your signature..."
                  :max-lines nil
                  :style (m/TextStyle .fontSize 18.0
                                      .fontFamily font-family
                                      .color theme/ink)
                  :decoration (m/InputDecoration .border m/InputBorder.none)}))))])
           :actions
           [(mgl/MongolTextButton
             .onPressed #(.pop (m/Navigator.of d-ctx))
             .child (mgl/MongolText "Cancel"))
            (mgl/MongolTextButton
             .onPressed (fn []
                          (store/set-signature! account-id (.-text ctrl))
                          (toast/success! ctx "Signature updated")
                          (.pop (m/Navigator.of d-ctx))
                          nil)
             .child (mgl/MongolText "Save"))]})
         "signature-dialog-ime"))))
    nil))

(defn- account-menu-items [ctx navigator accounts current current-account-id]
  (let [muted (m/TextStyle .color theme/ink-muted)
        selected-style (m/TextStyle .color theme/sky .fontWeight m/FontWeight.w600)
        all? (nil? current-account-id)
        account-entries
        (mapv (fn [^mc/MailAccountDto a]
                (let [selected? (= (.-id a) current-account-id)]
                  {:type :item
                   :title (or (.-displayName a) (.-email a))
                   :leading (when selected? m.Icons/check)
                   :leading-color theme/sky
                   :title-style (when selected? selected-style)
                   :on-tap (fn [] (mail/set-current-account! (.-id a)) nil)}))
              accounts)]
    (into [{:type :item
            :title "All accounts"
            :leading (when all? m.Icons/check)
            :leading-color theme/sky
            :title-style (when all? selected-style)
            :on-tap (fn [] (mail/set-current-account! nil) nil)}]
          (concat
           account-entries
           [{:type :divider}
            {:type :item
             :title "Add account"
             :on-tap (fn [] (.pushNamed navigator "/signup") nil)}
            {:type :item
             :title "Edit current"
             :title-style (when-not current muted)
             :on-tap (when current
                       (fn [] (edit-account-dialog! ctx current) nil))}
            {:type :item
             :title "Signature"
             :title-style (when-not current muted)
             :on-tap (when current
                       (fn []
                         (signature-dialog! ctx
                                            (.-id ^mc/MailAccountDto current)
                                            (.-email ^mc/MailAccountDto current))
                         nil))}
            {:type :item
             :title "Remove current"
             :title-style (m/TextStyle .color theme/danger)
             :on-tap (when current-account-id
                       (fn []
                         (-> (mail/remove-account! current-account-id)
                             (.then (fn [_] (toast/success! ctx "Account removed") nil))
                             (.catchError (fn [e]
                                            (dart:core/print (str "remove account failed: " e))
                                            (toast/error! ctx (str e))
                                            nil)))
                         nil))}]))))

(defn account-chip
  "Modern workspace/account header designed for the top of the sidebar."
  []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [!hover? (atom false) :dispose nil]
   :watch [hover? !hover?
           {:keys [accounts current-account-id]} store/app-state]
   (let [current (some #(when (= (.-id ^mc/MailAccountDto %) current-account-id) %)
                       accounts)
         label (cond
                 (nil? current-account-id) "All accounts"
                 current (or (.-displayName ^mc/MailAccountDto current)
                             (.-email ^mc/MailAccountDto current))
                 :else "Account")
         sub-label (if current (.-email ^mc/MailAccountDto current) "Unified Inbox")]
     (menu/custom-popup-menu
      {:offset-y 8.0
       :menu-width 280.0
       :bg-color theme/surface
       :items (account-menu-items ctx navigator accounts current current-account-id)
       :trigger-builder
       (fn [show-menu]
         (m/Tooltip
          .message "Switch Account"
          .child
          (m/MouseRegion
           .onEnter (fn [_] (reset! !hover? true) nil)
           .onExit (fn [_] (reset! !hover? false) nil)
           .cursor m.SystemMouseCursors/click
           .child
           (m/GestureDetector
            .behavior m.HitTestBehavior/opaque
            .onTap show-menu
            .child
            (m/AnimatedContainer
             .duration (dart:core/Duration. .milliseconds 150)
             .padding (m.EdgeInsets/symmetric .horizontal 16.0 .vertical 16.0)
             .decoration (m/BoxDecoration
                          .color (if hover? (.withOpacity theme/ink 0.04) m.Colors/transparent))
             .child
             (m/Row
              .children
              [(m/CircleAvatar
                .radius 18.0
                .backgroundColor theme/sky
                .child
                (m/Text (if (seq label) (str (first label)) "?")
                        .style (m/TextStyle .color m.Colors/white
                                            .fontSize 16.0
                                            .fontWeight m/FontWeight.w600)))
               (m/SizedBox .width 12.0)
               (m/Expanded
                .child
                (m/Column
                 .crossAxisAlignment m.CrossAxisAlignment/start
                 .mainAxisSize m.MainAxisSize/min
                 .children
                 [(m/Text label
                          .maxLines 1
                          .overflow m.TextOverflow/ellipsis
                          .style (m/TextStyle .fontSize 14.0
                                              .color theme/ink
                                              .fontWeight m/FontWeight.w600))
                  (m/SizedBox .height 2.0)
                  (m/Text sub-label
                          .maxLines 1
                          .overflow m.TextOverflow/ellipsis
                          .style (m/TextStyle .fontSize 12.0
                                              .color theme/ink-muted))]))
               (m/Icon m.Icons/unfold_more .size 20.0 .color theme/ink-muted)]))))))}))))
