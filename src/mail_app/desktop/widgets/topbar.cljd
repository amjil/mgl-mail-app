(ns mail-app.desktop.widgets.topbar
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [components.dialog :as dialog]
            [mail-app.desktop.toast :as toast]
            [mail-app.desktop.widgets.account-menu :as accounts]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [shared-ime.overlay-view :as overlay]
            [rich-editor.components.text-field :as custom-tf]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- create-folder-dialog! [ctx]
  (let [ctrl (m/TextEditingController.)
        !ime (atom {})] ;; Create a local empty state for custom-tf/text-field
    (m/showDialog
     .context ctx
     .builder
     (fn [d-ctx]
       (f/widget
        :managed [focus-node (m/FocusNode)]
        ;; Wrap the entire dialog in the IME overlay so candidates can pop up
        (overlay/ime-global-wrapper
         (dialog/vertical-custom-dialog
          {:title "New Folder"
           :width-factor 0.7
           :height-factor 0.5
           :body (m/GestureDetector
                  .behavior m.HitTestBehavior/opaque
                  .onTap (fn [] (.requestFocus focus-node) nil)
                  .child
                  (m/Container
                   .height 200.0
                   .padding (m.EdgeInsets/all 8.0)
                   .alignment m.Alignment/topLeft
                   .decoration (m/BoxDecoration 
                                .color (-> theme/ink (.withOpacity 0.05))
                                .border (m/Border.all .color theme/divider)
                                .borderRadius (m/BorderRadius.circular 8.0))
                   .child
                   ;; Use the exact same custom-tf/text-field as search.cljd
                   (custom-tf/text-field
                    !ime
                    {:controller ctrl
                     :focus-node focus-node
                     :hint "Folder name"
                     :max-lines nil
                     :style (m/TextStyle .fontSize 18.0 .fontFamily font-family .color theme/ink)
                     :decoration (m/InputDecoration .border m/InputBorder.none)})))
           :actions
           [(mgl/MongolTextButton
             .onPressed #(.pop (m/Navigator.of d-ctx))
             .child (mgl/MongolText "Cancel"))
            (mgl/MongolTextButton
             .onPressed (fn []
                          (let [name (str/trim (.-text ctrl))]
                            (if (empty? name)
                              (toast/error! ctx "Folder name is empty")
                              (-> (mail/create-folder! name)
                                  (.then (fn [_]
                                           (toast/success! ctx "Folder created")
                                           (.pop (m/Navigator.of d-ctx))
                                           nil))
                                  (.catchError (fn [e]
                                                 (toast/error! ctx (str e))
                                                 nil))))))
             .child (mgl/MongolText "Create"))]})
         "folder-dialog-ime"))))))

(declare bulk-action-bar)

(defn- icon-btn
  [tooltip on-pressed icon & {:keys [color]}]
  (m/IconButton
   .padding (m.EdgeInsets/all 10.0)
   .constraints (m/BoxConstraints.)
   .tooltip tooltip
   .onPressed on-pressed
   .icon (m/Icon icon .color color)))

(defn- chrome-actions [navigator ctx syncing?]
  (m/Row
   .children
   [(icon-btn "New Folder" (fn [] (create-folder-dialog! ctx) nil)
              m.Icons/create_new_folder)
    (icon-btn "Search"
              (fn [] (.pushNamed navigator "/search") nil)
              m.Icons/search)
    (m/IconButton
     .padding (m.EdgeInsets/all 10.0)
     .constraints (m/BoxConstraints.)
     .tooltip "Sync"
     .onPressed (fn [] (mail/sync!) nil)
     .icon (if syncing?
             (m/SizedBox
              .width 20.0 .height 20.0
              .child (m/CircularProgressIndicator. .strokeWidth 2.0 .color theme/sky))
             (m/Icon m.Icons/sync)))
    (icon-btn "Compose"
              (fn []
                (store/clear-compose-draft!)
                (.pushNamed navigator "/compose")
                nil)
              m.Icons/edit)]))

(defn- mail-actions
  [{:keys [on-reply on-reply-all on-forward on-archive on-unarchive on-delete
           on-star on-toggle-read on-edit-draft
           archived? draft? starred? read?]}]
  (m/Row
   .children
   (cond-> []
     on-edit-draft
     (conj (icon-btn "Edit draft" on-edit-draft m.Icons/edit_note))
     on-reply
     (conj (icon-btn "Reply" on-reply m.Icons/reply))
     on-reply-all
     (conj (icon-btn "Reply All" on-reply-all m.Icons/reply_all))
     on-forward
     (conj (icon-btn "Forward" on-forward m.Icons/forward))
     on-star
     (conj (icon-btn (if starred? "Unstar" "Star") on-star
                     (if starred? m.Icons/star m.Icons/star_border)
                     :color (when starred? theme/gold)))
     on-toggle-read
     (conj (icon-btn (if read? "Mark unread" "Mark read") on-toggle-read
                     (if read?
                       m.Icons/mark_email_unread_outlined
                       m.Icons/mark_email_read_outlined)))
     (and (not draft?) (not archived?) on-archive)
     (conj (icon-btn "Archive" on-archive m.Icons/archive_outlined))
     (and archived? on-unarchive)
     (conj (icon-btn "Move to Inbox" on-unarchive m.Icons/unarchive_outlined))
     on-delete
     (conj (icon-btn "Delete" on-delete m.Icons/delete_outline
                     :color theme/danger)))))

(defn shell
  "Unified home chrome: browse / reading / bulk-select."
  [& {:keys [on-back] :as action-opts}]
  (f/widget
   :get [m/Navigator]
   :context ctx
   :watch [{:keys [syncing? reading-mail? selected-message-ids]} store/app-state]
   (let [bulk? (and (not reading-mail?) (seq selected-message-ids))]
     (cond
       bulk?
       (bulk-action-bar)

       reading-mail?
       (m/SafeArea
        .bottom false
        .child
        (m/Row
         .mainAxisAlignment m.MainAxisAlignment/spaceBetween
         .children
         [(icon-btn "Back" on-back m.Icons/arrow_back_ios_new)
          (mail-actions action-opts)]))

       :else
       (m/SafeArea
        .bottom false
        .child
        (m/Row
         .mainAxisAlignment m.MainAxisAlignment/spaceBetween
         .children
         [(accounts/account-chip)
          (chrome-actions navigator ctx syncing?)]))))))

(defn mail-box
  []
  (f/widget
   :get [m/Navigator]
   :context ctx
   :watch [{:keys [syncing?]} store/app-state]
   (m/SafeArea
    .bottom false
    .child
    (m/Row
     .mainAxisAlignment m.MainAxisAlignment/spaceBetween
     .children
     [(accounts/account-chip)
      (m/Row
       .children
       [(m/IconButton
         .padding (m.EdgeInsets/all 10.0)
         .constraints (m/BoxConstraints.)
         .tooltip "New Folder"
         .onPressed (fn [] (create-folder-dialog! ctx) nil)
         .icon (m/Icon m.Icons/create_new_folder))
        (m/IconButton
         .padding (m.EdgeInsets/all 10.0)
         .constraints (m/BoxConstraints.)
         .tooltip "Search"
         .onPressed (fn []
                      (.pushNamed navigator "/search")
                      nil)
         .icon (m/Icon m.Icons/search))
        (m/IconButton
         .padding (m.EdgeInsets/all 10.0)
         .constraints (m/BoxConstraints.)
         .tooltip "Sync"
         .onPressed (fn [] (mail/sync!) nil)
         .icon (if syncing?
                 (m/SizedBox
                  .width 20.0 .height 20.0
                  .child (m/CircularProgressIndicator. .strokeWidth 2.0))
                 (m/Icon m.Icons/sync)))
        (m/IconButton
         .padding (m.EdgeInsets/all 10.0)
         .constraints (m/BoxConstraints.)
         .tooltip "Compose"
         .onPressed (fn []
                      (store/clear-compose-draft!)
                      (.pushNamed navigator "/compose")
                      nil)
         .icon (m/Icon m.Icons/edit))])]))))

(defn mail-list
  []
  (f/widget
   :get [m/Navigator]
   (m/SafeArea
    .bottom false
    .child
    (m/Row
     .mainAxisAlignment m.MainAxisAlignment/spaceBetween
     .children
     [(m/IconButton
       .padding (m.EdgeInsets/all 10.0)
       .constraints (m/BoxConstraints.)
       .tooltip "Back"
       .onPressed (fn [] (.pop navigator) nil)
       .icon (m/Icon m.Icons/arrow_back_ios_new))
      (m/Row
       .children
       [(m/IconButton
         .padding (m.EdgeInsets/all 10.0)
         .constraints (m/BoxConstraints.)
         .tooltip "Search"
         .onPressed (fn []
                      (.pushNamed navigator "/search")
                      nil)
         .icon (m/Icon m.Icons/search))
        (m/IconButton
         .padding (m.EdgeInsets/all 10.0)
         .constraints (m/BoxConstraints.)
         .tooltip "Compose"
         .onPressed (fn []
                      (store/clear-compose-draft!)
                      (.pushNamed navigator "/compose")
                      nil)
         .icon (m/Icon m.Icons/edit))])]))))

(defn mail-detail
  [& {:keys [on-reply on-reply-all on-forward on-archive on-unarchive on-delete
             on-star on-toggle-read on-edit-draft
             archived? draft? starred? read?]}]
  (f/widget
   :get [m/Navigator]
   (m/SafeArea
    .bottom false
    .child
    (m/Row
     .mainAxisAlignment m.MainAxisAlignment/spaceBetween
     .children
     [(m/IconButton
       .padding (m.EdgeInsets/all 10.0)
       .constraints (m/BoxConstraints.)
       .tooltip "Back"
       .onPressed (fn []
                    (store/clear-message-detail!)
                    (.pop navigator)
                    nil)
       .icon (m/Icon m.Icons/arrow_back_ios_new))
      (m/Row
       .children
       (cond-> []
         on-edit-draft
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Edit draft"
                .onPressed on-edit-draft
                .icon (m/Icon m.Icons/edit_note)))

         on-reply
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Reply"
                .onPressed on-reply
                .icon (m/Icon m.Icons/reply)))

         on-reply-all
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Reply All"
                .onPressed on-reply-all
                .icon (m/Icon m.Icons/reply_all)))

         on-forward
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Forward"
                .onPressed on-forward
                .icon (m/Icon m.Icons/forward)))

         on-star
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip (if starred? "Unstar" "Star")
                .onPressed on-star
                .icon (m/Icon (if starred? m.Icons/star m.Icons/star_border)
                              .color (when starred? theme/gold))))

         on-toggle-read
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip (if read? "Mark unread" "Mark read")
                .onPressed on-toggle-read
                .icon (m/Icon (if read?
                                m.Icons/mark_email_unread_outlined
                                m.Icons/mark_email_read_outlined))))

         (and (not draft?) (not archived?) on-archive)
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Archive"
                .onPressed on-archive
                .icon (m/Icon m.Icons/archive_outlined)))

         (and archived? on-unarchive)
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Move to Inbox"
                .onPressed on-unarchive
                .icon (m/Icon m.Icons/unarchive_outlined)))

         on-delete
         (conj (m/IconButton
                .padding (m.EdgeInsets/all 10.0)
                .constraints (m/BoxConstraints.)
                .tooltip "Delete"
                .onPressed on-delete
                .icon (m/Icon m.Icons/delete_outline)))))]))))

(defn bulk-action-bar
  "Shown in place of mail-list topbar when messages are selected."
  []
  (f/widget
   :watch [{:keys [selected-message-ids]} store/app-state]
   (let [cnt (count selected-message-ids)]
     (m/SafeArea
      .bottom false
      .child
      (m/Container
       .padding (m.EdgeInsets/symmetric .horizontal 16.0 .vertical 8.0)
       .color theme/sky-light
       .child
       (m/Row
        .mainAxisAlignment m.MainAxisAlignment/spaceBetween
        .children
        [(m/Row
          .children
          [(m/IconButton
            .padding (m.EdgeInsets/all 10.0)
            .constraints (m/BoxConstraints.)
            .tooltip "Cancel selection"
            .onPressed (fn [] (store/clear-message-selection!) nil)
            .icon (m/Icon m.Icons/close .color theme/sky))
           (m/SizedBox .width 8.0)
           (m/Text (str cnt " selected")
                   .style (m/TextStyle .fontWeight m/FontWeight.bold
                                       .color theme/sky))])
         (m/Row
          .children
          [(m/IconButton
            .padding (m.EdgeInsets/all 10.0)
            .constraints (m/BoxConstraints.)
            .tooltip "Mark Read"
            .onPressed (fn [] (mail/bulk-set-read! true) nil)
            .icon (m/Icon m.Icons/mark_email_read))
           (m/IconButton
            .padding (m.EdgeInsets/all 10.0)
            .constraints (m/BoxConstraints.)
            .tooltip "Mark Unread"
            .onPressed (fn [] (mail/bulk-set-read! false) nil)
            .icon (m/Icon m.Icons/mark_email_unread))
           (m/IconButton
            .padding (m.EdgeInsets/all 10.0)
            .constraints (m/BoxConstraints.)
            .tooltip "Archive"
            .onPressed (fn [] (mail/bulk-archive!) nil)
            .icon (m/Icon m.Icons/archive))
           (m/IconButton
            .padding (m.EdgeInsets/all 10.0)
            .constraints (m/BoxConstraints.)
            .tooltip "Delete"
            .onPressed (fn [] (mail/bulk-delete!) nil)
            .icon (m/Icon m.Icons/delete .color theme/danger))])]))))))