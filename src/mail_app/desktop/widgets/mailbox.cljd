(ns mail-app.desktop.widgets.mailbox
  "IMAP folder list (+ local Outbox)."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]))

(def ^:private font-family "MongolianBaiZheng")

(def ^:private role-order
  {"inbox" 0
   "sent" 1
   "draft" 2
   "archive" 3
   "trash" 4
   "junk" 5
   "custom" 6})

(defn- folder-sort-key [^mc/MailFolderDto f]
  [(get role-order (or (.-role f) "") 50)
   (or (.-path f) "")
   (or (.-id f) 0)])

(defn- has-role? [folders role]
  (let [want (keyword role)]
    (boolean
     (some (fn [^mc/MailFolderDto f]
             (or (= (.-role f) role)
                 (= (role-key (.-role f) (.-name f)) want)))
           folders))))

(defn- role-key
  "Map DB role / display name → UI mailbox key. Name wins for stale custom rows."
  [role name]
  (let [n (str/lower-case (or name ""))]
    (cond
      (= role "inbox") :inbox
      (= role "sent") :sent
      (or (= role "draft")
          (str/includes? n "草稿")
          (= n "drafts")
          (= n "draft"))
      :draft
      (or (= role "archive")
          (str/includes? n "归档")
          (str/includes? n "歸檔")
          (str/includes? n "档案")
          (str/includes? n "檔案")
          (str/includes? n "archive"))
      :archive
      (= role "trash") :trash
      (or (= role "junk")
          (str/includes? n "垃圾邮件")
          (str/includes? n "垃圾郵件")
          (str/includes? n "spam")
          (str/includes? n "junk")
          (str/includes? n "迷惑メール"))
      :junk
      :else nil)))

;; ==========================================
;; Dialogs for Folder Management
;; ==========================================

(defn- rename-folder-dialog! [ctx folder-path current-name]
  (let [ctrl (m/TextEditingController. .text current-name)]
    (m/showDialog
     .context ctx
     .builder
     (fn [d-ctx]
       (m/AlertDialog
        .title (m/Text "Rename Folder")
        .content (m/TextField .controller ctrl .autofocus true)
        .actions
        [(m/TextButton .onPressed #(.pop (m/Navigator.of d-ctx)) .child (m/Text "Cancel"))
         (m/TextButton
          .onPressed (fn []
                       (let [new-name (str/trim (.-text ctrl))]
                         (when (and (seq new-name) (not= new-name current-name))
                           (-> (mail/rename-folder! folder-path new-name)
                               (.then (fn [_]
                                        (toast/success! ctx "Folder renamed")
                                        (.pop (m/Navigator.of d-ctx))))
                               (.catchError (fn [e]
                                              (toast/error! ctx (str e))
                                              nil)))))
                       nil)
          .child (m/Text "Rename"))])))))

(defn- confirm-delete-folder! [ctx folder-path folder-key]
  (m/showDialog
   .context ctx
   .builder
   (fn [d-ctx]
     (m/AlertDialog
      .title (m/Text "Delete Folder?")
      .content (m/Text (str "Are you sure you want to delete folder '"
                            folder-path
                            "'? This may also delete the emails inside it on the server."))
      .actions
      [(m/TextButton .onPressed #(.pop (m/Navigator.of d-ctx)) .child (m/Text "Cancel"))
       (m/TextButton
        .onPressed (fn []
                     (-> (mail/delete-folder! folder-path)
                         (.then (fn [_]
                                  ;; Custom folders select by id; also match path just in case.
                                  (let [sel (:selected-mailbox @store/app-state)]
                                    (when (or (= sel folder-key)
                                              (= sel folder-path))
                                      (mail/select-mailbox! :inbox)))
                                  (toast/success! ctx "Folder deleted")
                                  (.pop (m/Navigator.of d-ctx))))
                         (.catchError (fn [e]
                                        (toast/error! ctx (str e))
                                        nil)))
                     nil)
        .child (m/Text "Delete" .style (m/TextStyle .color m.Colors/red)))]))))


;; ==========================================
;; UI Components
;; ==========================================

(defn- unread-badge [badge-count]
  (m/Positioned
   .right 4.0
   .top 4.0
   .child
   (m/Container
    .padding (m.EdgeInsets/all 4.0)
    .decoration (m/BoxDecoration
                 .color m.Colors/red
                 .shape m.BoxShape/circle)
    .child
    (m/Text (if (> badge-count 99) "99+" (str badge-count))
            .style (m/TextStyle .color m.Colors/white
                                .fontSize 10.0
                                .fontWeight m/FontWeight.bold)))))

(defn- mailbox-item [key label selected? badge-count & {:keys [folder-path]}]
  (f/widget
   :get [m/Navigator]
   :context ctx
   (let [tile (mgl/MongolListTile
               .selected selected?
               .title (m/Padding
                       .padding (m.EdgeInsets/only .top 8.0)
                       .child
                       (mgl/MongolText
                        label
                        .style (m/TextStyle .fontSize 18.0 .fontFamily font-family)))
               .onTap (fn []
                        (mail/select-mailbox! key)
                        (.pushNamed navigator "/mail_list")
                        nil))
         children (cond-> [tile]
                    (and badge-count (> badge-count 0))
                    (conj (unread-badge badge-count))

                    ;; Custom folders: overflow menu for rename / delete
                    (some? folder-path)
                    (conj
                     (m/Positioned
                      .bottom 4.0
                      .right 0.0
                      .child
                      (m/PopupMenuButton
                       .icon (m/Icon m.Icons/more_vert .size 16.0 .color m.Colors/black45)
                       .tooltip "Folder Options"
                       .onSelected (fn [val]
                                     (cond
                                       (= val :rename)
                                       (rename-folder-dialog! ctx folder-path label)
                                       (= val :delete)
                                       (confirm-delete-folder! ctx folder-path key))
                                     nil)
                       .itemBuilder
                       (fn [_]
                         (.cast
                          [(m/PopupMenuItem .value :rename .child (m/Text "Rename"))
                           (m/PopupMenuItem .value :delete
                                            .child (m/Text "Delete"
                                                           .style (m/TextStyle .color m.Colors/red)))]))))))]
     (m/Stack
      .alignment m.Alignment/topRight
      .children children))))

(defn- dedupe-by-role-key
  "Keep one folder per UI mailbox key (e.g. Drafts + 草稿箱 → one :draft)."
  [folders]
  (let [ordered (->> folders (sort-by folder-sort-key) vec)]
    (loop [xs ordered
           seen #{}
           out []]
      (if (empty? xs)
        out
        (let [^mc/MailFolderDto f (first xs)
              rk (or (role-key (.-role f) (.-name f)) (.-id f))]
          (if (contains? seen rk)
            (recur (rest xs) seen out)
            (recur (rest xs) (conj seen rk) (conj out f))))))))

(defn- folder-item [^mc/MailFolderDto f selected]
  (let [id (.-id f)
        role (.-role f)
        name (.-name f)
        path (.-path f)
        rk (role-key role name)
        key (or rk id)
        count (.-unreadCount f)
        selected? (or (= selected key)
                      (= selected id)
                      (and (= selected :inbox) (or (= role "inbox") (= rk :inbox)))
                      (and (= selected :sent) (or (= role "sent") (= rk :sent)))
                      (and (= selected :draft) (or (= role "draft") (= rk :draft)))
                      (and (= selected :archive) (or (= role "archive") (= rk :archive)))
                      (and (= selected :trash) (or (= role "trash") (= rk :trash)))
                      (and (= selected :junk) (or (= role "junk") (= rk :junk))))
        ;; Treat name-mapped special folders as system (no rename/delete menu).
        is-custom? (and (= role "custom") (nil? rk))]
    (if is-custom?
      (mailbox-item key name selected? count :folder-path path)
      (mailbox-item key (or name role "Folder") selected? count))))

(defn- build-items [folder-list selected]
  (let [folders (dedupe-by-role-key folder-list)
        head (cond-> []
               (not (has-role? folders "inbox"))
               (conj (mailbox-item :inbox "Inbox" (= selected :inbox) nil))
               (not (has-role? folders "sent"))
               (conj (mailbox-item :sent "Sent" (= selected :sent) nil)))
        mid (mapv #(folder-item % selected) folders)
        tail [(mailbox-item :outbox "Outbox" (= selected :outbox) nil)]]
    (into (into head mid) tail)))

(defn mailbox-list
  []
  (f/widget
   :watch [{:keys [selected-mailbox accounts folder-list]} store/app-state]
   (if (empty? accounts)
     (m/Center
      .child (mgl/MongolText
              "No account"
              .style (m/TextStyle .fontFamily font-family .color m.Colors/black54)))
     (m/ListView
      .scrollDirection m.Axis/horizontal
      .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
      .children (build-items folder-list selected-mailbox)))))