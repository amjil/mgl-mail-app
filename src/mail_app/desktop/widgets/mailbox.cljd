(ns mail-app.desktop.widgets.mailbox
  "IMAP folder list (+ local Outbox)."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [components.dialog :as dialog]
            [components.menu :as menu]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [shared-ime.overlay-view :as overlay]
            [rich-editor.components.text-field :as custom-tf]
            [mail-app.theme :as theme :refer [font-family]]))

(def ^:private role-order
  {"inbox" 0
   "sent" 1
   "draft" 2
   "archive" 3
   "trash" 4
   "junk" 5
   "custom" 6})

(defn- folder-sort-key [^mc/MailFolderDto f]
  [(get role-order (or (.-role f) "") 50)
   (or (.-path f) "")
   (or (.-id f) 0)])

(defn- role-key
  "Map DB role / display name → UI mailbox key. Name wins for stale custom rows."
  [role name]
  (let [n (str/lower-case (or name ""))]
    (cond
      (= role "inbox") :inbox
      (= role "sent") :sent
      (or (= role "draft")
          (str/includes? n "草稿")
          (= n "drafts")
          (= n "draft"))
      :draft
      (or (= role "archive")
          (str/includes? n "归档")
          (str/includes? n "歸檔")
          (str/includes? n "档案")
          (str/includes? n "檔案")
          (str/includes? n "archive"))
      :archive
      (= role "trash") :trash
      (or (= role "junk")
          (str/includes? n "垃圾邮件")
          (str/includes? n "垃圾郵件")
          (str/includes? n "spam")
          (str/includes? n "junk")
          (str/includes? n "迷惑メール"))
      :junk
      :else nil)))

(defn- has-role? [folders role]
  (let [want (keyword role)]
    (boolean
     (some (fn [^mc/MailFolderDto f]
             (or (= (.-role f) role)
                 (= (role-key (.-role f) (.-name f)) want)))
           folders))))

;; ==========================================
;; Dialogs for Folder Management
;; ==========================================

(defn- rename-folder-dialog! [ctx folder-path current-name]
  (let [ctrl (m/TextEditingController. .text current-name)
        !ime (atom {})]
    (m/showDialog
     .context ctx
     .builder
     (fn [d-ctx]
       (f/widget
        :managed [focus-node (m/FocusNode)]
        (overlay/ime-global-wrapper
         (dialog/vertical-custom-dialog
          {:title "Rename Folder"
           :width-factor 0.7
           :height-factor 0.5
           :body (m/GestureDetector
                  .behavior m.HitTestBehavior/opaque
                  .onTap (fn [] (.requestFocus focus-node) nil)
                  .child
                  (m/Container
                   .height 200.0
                   .padding (m.EdgeInsets/all 8.0)
                   .alignment m.Alignment/topLeft
                   .decoration (m/BoxDecoration
                                .color theme/paper
                                .border (m/Border.all .color theme/divider)
                                .borderRadius (m/BorderRadius.circular 8.0))
                   .child
                   (custom-tf/text-field
                    !ime
                    {:controller ctrl
                     :focus-node focus-node
                     :hint "Folder name"
                     :max-lines nil
                     :style (m/TextStyle .fontSize 18.0 .fontFamily font-family .color theme/ink)
                     :decoration (m/InputDecoration .border m/InputBorder.none)})))
           :actions
           [(mgl/MongolTextButton
             .onPressed #(.pop (m/Navigator.of d-ctx))
             .child (mgl/MongolText "Cancel"))
            (mgl/MongolTextButton
             .onPressed (fn []
                          (let [new-name (str/trim (.-text ctrl))]
                            (cond
                              (empty? new-name)
                              (toast/error! ctx "Folder name is empty")
                              (= new-name current-name)
                              (.pop (m/Navigator.of d-ctx))
                              :else
                              (-> (mail/rename-folder! folder-path new-name)
                                  (.then (fn [_]
                                           (toast/success! ctx "Folder renamed")
                                           (.pop (m/Navigator.of d-ctx))
                                           nil))
                                  (.catchError (fn [e]
                                                 (toast/error! ctx (str e))
                                                 nil))))))
             .child (mgl/MongolText "Rename"))]})
         "folder-dialog-ime"))))))

(defn- confirm-delete-folder! [ctx folder-path folder-key folder-name]
  (m/showDialog
   .context ctx
   .builder
   (fn [d-ctx]
     (dialog/vertical-custom-dialog
      {:title "Delete Folder?"
       :width-factor 0.7
       :height-factor 0.5
       :body (mgl/MongolText
              (str "Are you sure you want to delete folder '"
                   folder-name
                   "'? This may also delete the emails inside it on the server."))
       :actions
       [(mgl/MongolTextButton
         .onPressed #(.pop (m/Navigator.of d-ctx))
         .child (mgl/MongolText "Cancel"))
        (mgl/MongolTextButton
         .onPressed (fn []
                      (-> (mail/delete-folder! folder-path)
                          (.then (fn [_]
                                   ;; Custom folders select by id; also match path just in case.
                                   (let [sel (:selected-mailbox @store/app-state)]
                                     (when (or (= sel folder-key)
                                               (= sel folder-path))
                                       (mail/select-mailbox! :inbox)))
                                   (toast/success! ctx "Folder deleted")
                                   (.pop (m/Navigator.of d-ctx))))
                          (.catchError (fn [e]
                                         (toast/error! ctx (str e))
                                         nil)))
                      nil)
         .child (mgl/MongolText "Delete"
                               .style (m/TextStyle .color theme/danger)))]}))))


;; ==========================================
;; UI Components
;; ==========================================

(defn- unread-badge [badge-count]
  (m/Positioned
   .right 4.0
   .top 4.0
   .child
   (m/Container
    .padding (m.EdgeInsets/symmetric .horizontal 5.0 .vertical 2.0)
    .decoration (m/BoxDecoration
                 .color theme/sky
                 .borderRadius (m.BorderRadius/circular 8.0))
    .child
    (m/Text (if (> badge-count 99) "99+" (str badge-count))
            .style (m/TextStyle .color m.Colors/white
                                .fontSize 10.0
                                .fontWeight m/FontWeight.bold)))))

(defn- folder-icon [key]
  (case key
    :inbox m.Icons/inbox
    :sent m.Icons/send_outlined
    :draft m.Icons/drafts_outlined
    :archive m.Icons/archive_outlined
    :trash m.Icons/delete_outline
    :junk m.Icons/report
    :outbox m.Icons/outbox
    m.Icons/folder))

(defn- mailbox-item [key label selected? badge-count & {:keys [folder-path]}]
  (f/widget
   :context ctx
   (let [tile (mgl/MongolListTile
               .selected selected?
               .leading (m/Icon (folder-icon key)
                                .size 20.0
                                .color (if selected? theme/sky theme/ink-muted))
               .title (m/Padding
                       .padding (m.EdgeInsets/only .top 8.0)
                       .child
                       (mgl/MongolText
                        label
                        .style (m/TextStyle
                                .fontSize 18.0
                                .fontFamily font-family
                                .height 1.4
                                .color (if selected? theme/ink theme/ink-muted)
                                .fontWeight (if selected?
                                              m/FontWeight.w600
                                              m/FontWeight.normal))))
               .onTap (fn []
                        (mail/select-mailbox! key)
                        nil))
         children (cond-> [tile]
                    (and badge-count (> badge-count 0))
                    (conj (unread-badge badge-count))

                    ;; Custom folders: overflow menu for rename / delete
                    (some? folder-path)
                    (conj
                     (m/Positioned
                      .bottom 4.0
                      .right 0.0
                      .child
                      (menu/custom-popup-menu
                       {:offset-y 4.0
                        :menu-width 160.0
                        :bg-color theme/surface
                        :trigger-builder
                        (fn [show-menu]
                          (m/IconButton
                           .icon (m/Icon m.Icons/more_vert
                                         .size 16.0
                                         .color theme/ink-muted)
                           .iconSize 16.0
                           .tooltip "Folder Options"
                           .padding (m.EdgeInsets/all 2.0)
                           .constraints (m/BoxConstraints
                                         .minWidth 24.0
                                         .minHeight 24.0)
                           .onPressed show-menu))
                        :items [{:type :item
                                 :title "Rename"
                                 :on-tap (fn []
                                           (rename-folder-dialog! ctx folder-path label)
                                           nil)}
                                {:type :item
                                 :title "Delete"
                                 :title-style (m/TextStyle .color theme/danger)
                                 :on-tap (fn []
                                           (confirm-delete-folder! ctx folder-path key label)
                                           nil)}]}))))]
     (m/Container
      .width theme/folder-col-width
      .decoration (m/BoxDecoration
                   .color (when selected? theme/surface)
                   .border (m/Border
                            .left (m/BorderSide
                                   .color (if selected? theme/sky theme/divider)
                                   .width (if selected? 3.0 0.0))))
      .child
      (m/Stack
       .alignment m.Alignment/topCenter
       .children children)))))

(defn- mailbox-dedupe-key
  "System folders collapse by role; custom folders by display name.
  Needed for All-accounts view, where each account contributes its own row."
  [^mc/MailFolderDto f]
  (or (role-key (.-role f) (.-name f))
      (let [n (str/lower-case (str/trim (or (.-name f) "")))]
        (when (seq n) n))
      (.-id f)))

(defn- dedupe-by-role-key
  "Keep one folder per UI mailbox key (e.g. Drafts + 草稿箱 → one :draft,
  and same-named custom folders across accounts → one row)."
  [folders]
  (let [ordered (->> folders (sort-by folder-sort-key) vec)]
    (loop [xs ordered
           seen #{}
           out []]
      (if (empty? xs)
        out
        (let [^mc/MailFolderDto f (first xs)
              rk (mailbox-dedupe-key f)]
          (if (contains? seen rk)
            (recur (rest xs) seen out)
            (recur (rest xs) (conj seen rk) (conj out f))))))))

(defn- folder-item [^mc/MailFolderDto f selected]
  (let [id (.-id f)
        role (.-role f)
        name (.-name f)
        path (.-path f)
        rk (role-key role name)
        key (or rk id)
        count (.-unreadCount f)
        selected? (or (= selected key)
                      (= selected id)
                      (and (= selected :inbox) (or (= role "inbox") (= rk :inbox)))
                      (and (= selected :sent) (or (= role "sent") (= rk :sent)))
                      (and (= selected :draft) (or (= role "draft") (= rk :draft)))
                      (and (= selected :archive) (or (= role "archive") (= rk :archive)))
                      (and (= selected :trash) (or (= role "trash") (= rk :trash)))
                      (and (= selected :junk) (or (= role "junk") (= rk :junk))))
        ;; Treat name-mapped special folders as system (no rename/delete menu).
        is-custom? (and (= role "custom") (nil? rk))]
    (if is-custom?
      (mailbox-item key name selected? count :folder-path path)
      (mailbox-item key (or name role "Folder") selected? count))))

(defn- build-items [folder-list selected]
  (let [folders (dedupe-by-role-key folder-list)
        head (cond-> []
               (not (has-role? folders "inbox"))
               (conj (mailbox-item :inbox "Inbox" (= selected :inbox) nil))
               (not (has-role? folders "sent"))
               (conj (mailbox-item :sent "Sent" (= selected :sent) nil)))
        mid (mapv #(folder-item % selected) folders)
        tail [(mailbox-item :outbox "Outbox" (= selected :outbox) nil)]]
    (into (into head mid) tail)))

(defn mailbox-list
  "Horizontal Mongol folder columns."
  []
  (f/widget
   :watch [{:keys [selected-mailbox accounts folder-list]} store/app-state]
   (if (empty? accounts)
     (m/Center
      .child (mgl/MongolText
              "ᠬᠠᠶᠢᠭᠤᠯᠤᠭᠰᠠᠨ ᠦᠭᠡᠢ"
              .style (m/TextStyle .fontFamily font-family .color theme/ink-muted .height 1.4)))
     (m/ListView
      .scrollDirection m.Axis/horizontal
      .padding (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 12.0)
      .children (build-items folder-list selected-mailbox)))))