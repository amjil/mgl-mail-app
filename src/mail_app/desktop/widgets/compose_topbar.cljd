(ns mail-app.desktop.widgets.compose-topbar
  (:require ["package:flutter/material.dart" :as m]
            ["package:file_selector/file_selector.dart" :as fs]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.compose-export :as export]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme]))

(declare compose-body)

(defn- parse-ready? [to]
  (seq (str/trim (or to ""))))

(defn- basename [path]
  (or (last (str/split (or path "") #"[\\/]")) path))

(defn- pick-attachments! [!paths]
  (-> (fs/openFiles)
      (.then (fn [files]
               (let [new-paths (->> (or files [])
                                    (map #(.-path ^fs/XFile %))
                                    (remove empty?)
                                    vec)]
                 (when (seq new-paths)
                   (swap! !paths #(vec (distinct (concat % new-paths))))))
               nil))
      (.catchError (fn [_] nil))))

(defn- compose-body
  [!doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl show-cc?
   show-bcc? attachment-paths draft-meta]
  (let [reply-plain (export/to-plain-text @!doc-state)
        reply-html (export/to-html @!doc-state)
        quote-state (when !quote-state @!quote-state)
        quote-plain (when quote-state (export/quote-state-to-plain quote-state))
        quote-html (when quote-state (export/quote-state-to-html quote-state))
        plain (if (seq quote-plain)
                (str reply-plain (when (seq reply-plain) "\n\n") quote-plain)
                reply-plain)
        html (if (seq quote-html)
               (str (if (or (str/blank? reply-html) (= reply-html "<p></p>"))
                      ""
                      reply-html)
                    quote-html)
               reply-html)]
    (merge
     {:to (.-text to-ctrl)
      :cc (when show-cc? (.-text cc-ctrl))
      :bcc (when show-bcc? (.-text bcc-ctrl))
      :subject (.-text subject-ctrl)
      :plain-text plain
      :html-text html
      :attachment-paths attachment-paths}
     (select-keys (or draft-meta {})
                  [:draft-message-id :in-reply-to :references :account-id]))))

(defn send-pressed!
  [ctx navigator !doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
   show-cc? show-bcc? sending? current-account-id attachment-paths draft-meta]
  (let [tctx (toast/safe-ctx ctx)]
    (cond
      sending?
      nil

      (nil? current-account-id)
      (toast/error! tctx "No account configured")

      (not (parse-ready? (.-text to-ctrl)))
      (toast/warn! tctx "Recipient required")

      :else
      (let [payload (compose-body !doc-state !quote-state to-ctrl cc-ctrl
                                  bcc-ctrl subject-ctrl show-cc? show-bcc?
                                  attachment-paths draft-meta)]
        (-> (mail/send! payload)
            (.then (fn [_]
                     (toast/success! tctx "Queued for send")
                     (when (.canPop navigator) (.pop navigator))
                     nil))
            (.catchError (fn [e]
                           (toast/error! tctx (str "Send failed: " e))
                           nil)))))
    nil))

(defn save-draft-pressed!
  [ctx navigator !doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
   show-cc? show-bcc? sending? current-account-id attachment-paths draft-meta]
  (let [tctx (toast/safe-ctx ctx)]
    (cond
      sending?
      nil

      (nil? current-account-id)
      (toast/error! tctx "No account configured")

      :else
      (let [payload (compose-body !doc-state !quote-state to-ctrl cc-ctrl
                                  bcc-ctrl subject-ctrl show-cc? show-bcc?
                                  attachment-paths draft-meta)]
        (-> (mail/save-draft! payload)
            (.then (fn [_]
                     (toast/success! tctx "Saved to Drafts")
                     (when (.canPop navigator) (.pop navigator))
                     nil))
            (.catchError (fn [e]
                           (toast/error! tctx (str "Save draft failed: " e))
                           nil)))))
    nil))

(defn silent-save-draft!
  "Auto-save without toast or navigation. Updates !draft-meta with the
  returned draft id so subsequent saves overwrite instead of creating anew.

  !gate coalesces overlapping runs: if a save is in flight, mark pending and
  run once more after it finishes (with the latest draft-message-id)."
  [!doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
   show-cc? show-bcc? current-account-id attachment-paths !draft-meta !gate]
  (if (:inflight? @!gate)
    (do (swap! !gate assoc :pending? true) nil)
    (do
      (swap! !gate assoc :inflight? true :pending? false)
      (let [release!
            (fn []
              (let [again? (:pending? @!gate)]
                (swap! !gate assoc :inflight? false :pending? false)
                (when again?
                  (silent-save-draft!
                   !doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                   show-cc? show-bcc? current-account-id attachment-paths
                   !draft-meta !gate))))]
        (try
          (let [aid (or current-account-id (:current-account-id @store/app-state))
                to-val (.-text to-ctrl)
                sub-val (.-text subject-ctrl)
                doc-val @!doc-state
                has-content?
                (or (seq (str/trim (or to-val "")))
                    (seq (str/trim (or sub-val "")))
                    (seq (str/trim (or (export/to-plain-text doc-val) ""))))]
            (if-not (and aid has-content?)
              (do (release!) nil)
              (-> (mail/save-draft!
                   (assoc (compose-body !doc-state !quote-state to-ctrl cc-ctrl
                                        bcc-ctrl subject-ctrl show-cc? show-bcc?
                                        attachment-paths @!draft-meta)
                          :silent? true))
                  (.then (fn [id]
                           (when id
                             (swap! !draft-meta assoc :draft-message-id id))
                           id))
                  (.catchError (fn [e]
                                 (dart:core/print (str "Silent auto-save failed: " e))
                                 nil))
                  (.whenComplete (fn [] (release!) nil)))))
          (catch Exception e
            (dart:core/print (str "Silent auto-save error: " e))
            (release!)
            nil))))))

(defn topbar
  "Back, Cc/Bcc toggle, attach, Save Draft, and Send."
  [{:keys [!doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
           !show-cc? !show-bcc? !attachment-paths !draft-meta]}]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [sending? current-account-id]} store/app-state
           show-cc? !show-cc?
           show-bcc? !show-bcc?
           attachment-paths !attachment-paths]
   (m/Container
    .decoration (m/BoxDecoration
                 .color theme/surface
                 .boxShadow (theme/hair-shadow))
    .child
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .children
     (cond->
       [(m/SizedBox
         .height theme/chrome-height
         .child
         (m/Padding
          .padding (m.EdgeInsets/symmetric .horizontal 10.0)
          .child
          (m/Row
           .mainAxisAlignment m.MainAxisAlignment/spaceBetween
           .children
           [(m/IconButton
             .padding (m.EdgeInsets/all 8.0)
             .constraints (m/BoxConstraints. .minWidth 40.0 .minHeight 40.0)
             .tooltip "Back"
             .onPressed (fn [] (.pop navigator) nil)
             .icon (m/Icon m.Icons/arrow_back_ios_new .size 20.0 .color theme/ink-muted))
            (m/Row
             .children
             [(m/TextButton
               .onPressed (fn [] (swap! !show-cc? not) nil)
               .style (m/TextButton.styleFrom
                       .foregroundColor (if show-cc? theme/sky theme/ink-muted)
                       .padding (m.EdgeInsets/symmetric .horizontal 10.0))
               .child (m/Text "Cc"
                              .style (m/TextStyle
                                      .fontWeight (if show-cc?
                                                    m/FontWeight.w600
                                                    m/FontWeight.normal))))
              (m/TextButton
               .onPressed (fn [] (swap! !show-bcc? not) nil)
               .style (m/TextButton.styleFrom
                       .foregroundColor (if show-bcc? theme/sky theme/ink-muted)
                       .padding (m.EdgeInsets/symmetric .horizontal 10.0))
               .child (m/Text "Bcc"
                              .style (m/TextStyle
                                      .fontWeight (if show-bcc?
                                                    m/FontWeight.w600
                                                    m/FontWeight.normal))))
              (m/IconButton
               .padding (m.EdgeInsets/all 8.0)
               .constraints (m/BoxConstraints. .minWidth 40.0 .minHeight 40.0)
               .tooltip "Attach"
               .onPressed (fn [] (pick-attachments! !attachment-paths) nil)
               .icon (m/Icon m.Icons/attach_file .size 20.0 .color theme/ink-muted))
              (m/IconButton
               .padding (m.EdgeInsets/all 8.0)
               .constraints (m/BoxConstraints. .minWidth 40.0 .minHeight 40.0)
               .tooltip "Save Draft"
               .onPressed (fn []
                            (save-draft-pressed! ctx navigator !doc-state !quote-state
                                                 to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                                 show-cc? show-bcc? sending?
                                                 current-account-id
                                                 attachment-paths @!draft-meta))
               .icon (m/Icon m.Icons/drafts_outlined .size 20.0 .color theme/ink-muted))
              (m/SizedBox .width 4.0)
              (m/FilledButton.icon
               .onPressed (fn []
                            (send-pressed! ctx navigator !doc-state !quote-state
                                           to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                           show-cc? show-bcc? sending?
                                           current-account-id
                                           attachment-paths @!draft-meta))
               .style (m/FilledButton.styleFrom
                       .backgroundColor theme/sky
                       .foregroundColor m.Colors/white
                       .elevation 0.0
                       .padding (m.EdgeInsets/symmetric .horizontal 16.0 .vertical 10.0)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .icon (if sending?
                       (m/SizedBox
                        .width 16.0
                        .height 16.0
                        .child (m/CircularProgressIndicator.
                                .strokeWidth 2.0
                                .color m.Colors/white))
                       (m/Icon m.Icons/send .size 16.0))
               .label (m/Text "Send"))])])))]
       (seq attachment-paths)
       (conj
        (m/Padding
         .padding (m.EdgeInsets/only .left 12.0 .right 12.0 .bottom 10.0)
         .child
         (m/Wrap
          .spacing 6.0
          .runSpacing 4.0
          .children
          (mapv (fn [path]
                  (m/InputChip
                   .label (m/Text (basename path)
                                  .style (m/TextStyle .fontSize 12.0 .color theme/ink))
                   .backgroundColor theme/sky-light
                   .side (m/BorderSide .color theme/sky-soft)
                   .onDeleted (fn []
                                (swap! !attachment-paths
                                       #(vec (remove #{path} %)))
                                nil)))
                attachment-paths)))))))))
