(ns mail-app.desktop.screens.signup
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- field [controller hint & {:keys [obscure?] :or {obscure? false}}]
  (m/TextFormField
   .controller controller
   .obscureText obscure?
   .style (m/TextStyle .fontSize 14.0 .color theme/ink)
   .decoration
   (m/InputDecoration
    .hintText hint)))

(defn- submit!
  [ctx navigator !busy email-ctrl password-ctrl imap-ctrl smtp-ctrl]
  (reset! !busy true)
  (-> (mail/add-account!
       {:email (str/trim (.-text email-ctrl))
        :password (.-text password-ctrl)
        :imap-host (let [h (str/trim (.-text imap-ctrl))]
                     (when (seq h) h))
        :smtp-host (let [h (str/trim (.-text smtp-ctrl))]
                     (when (seq h) h))})
      (.then (fn [_]
               (reset! !busy false)
               (toast/success! ctx "Account added")
               (when (.canPop navigator)
                 (.pop navigator))
               nil))
      (.catchError (fn [e]
                     (reset! !busy false)
                     (dart:core/print (str "add account failed: " e))
                     (toast/error! ctx (str e))
                     nil)))
  nil)

(defn- submit-outlook!
  [ctx navigator !busy]
  (reset! !busy true)
  (-> (mail/add-outlook-account!)
      (.then (fn [_]
               (reset! !busy false)
               (toast/success! ctx "Outlook account added")
               (when (.canPop navigator)
                 (.pop navigator))
               nil))
      (.catchError (fn [e]
                     (reset! !busy false)
                     (dart:core/print (str "add outlook account failed: " e))
                     (toast/error! ctx (str e))
                     nil)))
  nil)

(defn screen
  []
  (let [!busy (atom false)]
    (f/widget
     :context ctx
     :get [m/Navigator]
     :managed [email-ctrl (m/TextEditingController.)
               password-ctrl (m/TextEditingController.)
               imap-ctrl (m/TextEditingController.)
               smtp-ctrl (m/TextEditingController.)]
     :watch [{:keys [accounts]} store/app-state
             busy? !busy]
     (m/Scaffold
      .backgroundColor theme/paper
      .body
      (m/SafeArea
       .child
       (m/Center
        .child
        (m/SingleChildScrollView
         .padding (m.EdgeInsets/all 24.0)
         .child
         (m/Container
          .width 440.0
          .padding (m.EdgeInsets/all 32.0)
          .decoration (m/BoxDecoration
                       .color theme/surface
                       .borderRadius (m/BorderRadius.circular theme/radius-lg)
                       .boxShadow (theme/card-shadow)
                       .border (m/Border.all .color theme/divider))
          .child
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .crossAxisAlignment m.CrossAxisAlignment/stretch
           .children
           [(m/Row
             .children
             (cond-> []
               (seq accounts)
               (conj (m/IconButton
                      .icon (m/Icon m.Icons/arrow_back_ios_new
                                    .color theme/ink-muted)
                      .onPressed (fn [] (.pop navigator) nil)))
               true
               (conj (m/Expanded
                      .child
                      (m/Column
                       .crossAxisAlignment m.CrossAxisAlignment/start
                       .children
                       [(m/Text "Add account"
                                .style (m/TextStyle .fontSize 22.0
                                                    .fontWeight m/FontWeight.w700
                                                    .color theme/ink))
                        (m/SizedBox .height 4.0)
                        (m/Text
                         "Email + password (IMAP/SMTP auto from domain)"
                         .style (m/TextStyle .fontSize 13.0
                                             .fontFamily font-family
                                             .color theme/ink-muted))])))))
            (m/SizedBox .height 28.0)
            (m/OutlinedButton.icon
             .onPressed (if busy?
                          nil
                          #(submit-outlook! ctx navigator !busy))
             .icon (m/Icon m.Icons/mail_outline .color theme/sky)
             .label (m/Text "Sign in with Microsoft (Outlook)")
             .style (m/OutlinedButton.styleFrom
                     .foregroundColor theme/ink
                     .side (m/BorderSide .color theme/sky-soft)
                     .padding (m.EdgeInsets/symmetric .vertical 14.0)
                     .shape (m/RoundedRectangleBorder
                             .borderRadius (m/BorderRadius.circular theme/radius-md))))
            (m/SizedBox .height 20.0)
            (m/Row
             .children
             [(m/Expanded .child (m/Divider .color theme/divider))
              (m/Padding
               .padding (m.EdgeInsets/symmetric .horizontal 12.0)
               .child (m/Text "or"
                              .style (m/TextStyle .color theme/ink-muted
                                                  .fontSize 13.0)))
              (m/Expanded .child (m/Divider .color theme/divider))])
            (m/SizedBox .height 20.0)
            (field email-ctrl "Email")
            (m/SizedBox .height 14.0)
            (field password-ctrl "Password" :obscure? true)
            (m/SizedBox .height 14.0)
            (field imap-ctrl "IMAP host (optional)")
            (m/SizedBox .height 14.0)
            (field smtp-ctrl "SMTP host (optional)")
            (m/SizedBox .height 28.0)
            (m/FilledButton
             .onPressed (if busy?
                          nil
                          #(submit! ctx navigator !busy email-ctrl password-ctrl
                                    imap-ctrl smtp-ctrl))
             .style (m/FilledButton.styleFrom
                     .backgroundColor theme/sky
                     .foregroundColor m.Colors/white
                     .elevation 0.0
                     .padding (m.EdgeInsets/symmetric .vertical 14.0)
                     .shape (m/RoundedRectangleBorder
                             .borderRadius (m/BorderRadius.circular theme/radius-md)))
             .child (if busy?
                      (m/SizedBox
                       .width 22.0
                       .height 22.0
                       .child (m/CircularProgressIndicator.
                               .strokeWidth 2.0
                               .color m.Colors/white))
                      (m/Text "Done"
                              .style (m/TextStyle .fontWeight m/FontWeight.w600))))])))))))))
