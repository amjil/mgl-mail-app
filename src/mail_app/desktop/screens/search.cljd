(ns mail-app.desktop.screens.search
  "Desktop search screen: Fully adapted traditional Mongolian vertical search bar & filter chips."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [shared-ime.overlay-view :as overlay]
            [rich-editor.components.text-field :as custom-tf]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

;; ==========================================
;; Core Component & Disposers
;; ==========================================
(defn- dispose-search-trigger! [{:keys [^m/TextEditingController ctrl trig !timer]}]
  (when-let [t @!timer] (.cancel ^async/Timer t))
  (.removeListener ctrl trig)
  nil)

(defn- mongol-field
  "Vertical text field for search input."
  [!ime controller focus-node hint]
  (custom-tf/text-field
   !ime
   {:controller controller
    :focus-node focus-node
    :hint hint
    :max-lines nil
    :style (m/TextStyle .fontSize 18.0
                        .fontFamily font-family
                        .color (theme/ink))
    :decoration (m/InputDecoration .border m/InputBorder.none)}))

;; ==========================================
;; Custom Vertical Filter Chip
;; ==========================================
(defn- vertical-filter-chip [label icon filter-key filters query-ctrl]
  (let [selected? (get filters filter-key false)]
    (m/GestureDetector
     .behavior m.HitTestBehavior/opaque
     .onTap (fn []
              (store/toggle-search-filter! filter-key)
              ;; Trigger search immediately upon toggling the filter
              (mail/search! (.-text ^m/TextEditingController query-ctrl)
                            (:search-filters @store/app-state))
              nil)
     .child
     (m/AnimatedContainer
      .duration (dart:core/Duration. .milliseconds 200)
      .width 48.0
      .margin (m.EdgeInsets/only .left 12.0 .top 16.0 .bottom 16.0)
      .decoration (m/BoxDecoration
                   .color (if selected? (theme/sky-soft) m.Colors/transparent)
                   .borderRadius (m/BorderRadius.circular 24.0)
                   .border (m/Border.all
                            .color (if selected? (theme/sky) (theme/divider))))
      .child
      (m/Column
       .children
       [(m/Padding
         .padding (m.EdgeInsets/all 12.0)
         .child (m/Icon icon .size 20.0
                        .color (if selected? (theme/sky-deep) (theme/ink-muted))))
        (m/Expanded
         .child
         (m/Padding
          .padding (m.EdgeInsets/only .bottom 16.0 .top 4.0)
          .child
          (mgl/MongolText label
                          .style (m/TextStyle .fontFamily font-family
                                              .color (if selected? (theme/sky-deep) (theme/ink-muted))
                                              .fontSize 14.0
                                              .fontWeight (if selected? m/FontWeight.w600 m/FontWeight.normal)))))])))))

;; ==========================================
;; Search Results UI
;; ==========================================
(defn- result-item [^mc/MailSearchResultDto hit navigator]
  (m/Material
   .color (theme/surface)
   .borderRadius (m/BorderRadius.circular theme/radius-md)
   .child
   (m/InkWell
    .borderRadius (m/BorderRadius.circular theme/radius-md)
    .hoverColor (theme/hover)
    .onTap (fn []
             (mail/open-message! (.-messageId hit))
             (.pop navigator)
             nil)
    .child
    (mgl/MongolListTile
     .title (m/Padding
             .padding (m.EdgeInsets/only .top 8.0)
             .child
             (mgl/MongolText
              (let [s (.-subject hit)]
                (if (or (nil? s) (empty? s)) "ᠭᠠᠷᠴᠢᠭ ᠦᠭᠡᠢ" s)) ;; "No Subject"
              .style (m/TextStyle .fontSize 18.0
                                  .fontFamily font-family
                                  .fontWeight m/FontWeight.bold
                                  .color (theme/ink)
                                  .height 1.4)))
     .subtitle (m/Padding
                .padding (m.EdgeInsets/only .top 8.0)
                .child
                (mgl/MongolText
                 (or (.-snippet hit) "")
                 .style (m/TextStyle .fontSize 14.0
                                     .fontFamily font-family
                                     .color (theme/ink-muted)
                                     .height 1.4)))))))

(defn- results-body [search-results searching? navigator search-query filters]
  (cond
    searching?
    (m/Center .child (m/CircularProgressIndicator. .color (theme/sky)))

    (empty? search-results)
    (theme/empty-state
     m.Icons/search
     (if (or (seq search-query) (some true? (vals filters)))
       "ᠢᠯᠡᠷᠡᠴᠡ ᠣᠯᠳᠣᠭᠰᠠᠨ ᠦᠭᠡᠢ" ;; "No results found"
       "ᠬᠠᠶᠢᠬᠤ ᠤᠳᠬ᠎ᠠ ᠪᠠᠨ ᠣᠷᠣᠭᠤᠯᠤᠨ᠎ᠠ ᠤᠤ")) ;; "Please enter search text"

    :else
    (m/ListView.separated
     .scrollDirection m.Axis/horizontal
     .padding (m.EdgeInsets/symmetric .horizontal 16.0 .vertical 16.0)
     .itemCount (count search-results)
     .separatorBuilder (fn [_ _] (m/SizedBox .width 10.0))
     .itemBuilder (fn [_ idx]
                    (m/Container
                     .width 160.0
                     .decoration (m/BoxDecoration
                                  .color (theme/surface)
                                  .border (m/Border.all .color (theme/divider) .width 0.5)
                                  .borderRadius (m/BorderRadius.circular theme/radius-md)
                                  .boxShadow (theme/hair-shadow))
                     .clipBehavior m.Clip/antiAlias
                     .child (result-item (nth search-results idx) navigator))))))

;; ==========================================
;; Search Screen Main
;; ==========================================
(defn screen []
  (let [!timer (atom nil)
        !ime (atom {})]
    (f/widget
     :context ctx
     :get [m/Navigator]
     
     :managed [query-ctrl (m/TextEditingController.)
               query-focus (m/FocusNode.)
               
               ;; Bind text listener to trigger debounced search
               search-trigger-state
               (let [trig (fn []
                            (when-let [t @!timer] (.cancel ^async/Timer t))
                            (reset! !timer
                                    (async/Timer.
                                     (dart:core/Duration. .milliseconds 350)
                                     (fn []
                                       (let [q (str/trim (.-text query-ctrl))]
                                         ;; Search with current query AND filters
                                         (mail/search! q (:search-filters @store/app-state)))))))]
                 (.addListener query-ctrl trig)
                 {:ctrl query-ctrl :trig trig :!timer !timer})
               :dispose dispose-search-trigger!]
               
     :watch [{:keys [search-results searching? search-query search-filters]} store/app-state]
     (let [filters (or search-filters {})]
       (m/Scaffold
        .backgroundColor (theme/paper)
        .body
        (overlay/ime-global-wrapper
         (m/Row
          .crossAxisAlignment m.CrossAxisAlignment/stretch
          .children
          [;; --- Left panel: Dynamic Search & Filter Zone ---
           (m/Container
            .decoration (m/BoxDecoration
                         .color (theme/sky-light)
                         .border (m/Border .right (m/BorderSide .color (theme/divider))))
            .child
            (m/Row
             .children
             [;; Column 1: The Input Bar
              (m/Container
               .width 80.0
               .decoration (m/BoxDecoration .border (m/Border .right (m/BorderSide .color (theme/divider) .width 0.5)))
               .child
               (m/Column
                .children
                [;; Back button
                 (m/Padding
                  .padding (m.EdgeInsets/only .top 16.0 .bottom 8.0)
                  .child
                  (m/IconButton
                   .icon (m/Icon m.Icons/arrow_back_ios_new
                                 .size 20.0
                                 .color (theme/ink-muted))
                   .tooltip "Back"
                   .onPressed (fn []
                                (when-let [t @!timer] (.cancel ^async/Timer t))
                                (.clear query-ctrl)
                                (store/clear-search-filters!)
                                (store/set-search-results! [])
                                (store/set-search-query! "")
                                (.pop navigator)
                                nil)))
                 
                 ;; Mongol search field
                 (m/Expanded
                  .child
                  (m/GestureDetector
                   .behavior m.HitTestBehavior/opaque
                   .onTap (fn [] (.requestFocus query-focus) nil)
                   .child
                   (m/Container
                    .margin (m.EdgeInsets/symmetric .horizontal 8.0 .vertical 4.0)
                    .padding (m.EdgeInsets/symmetric .horizontal 4.0 .vertical 8.0)
                    .alignment m.Alignment/topCenter
                    .decoration (m/BoxDecoration
                                 .color (theme/surface)
                                 .borderRadius (m/BorderRadius.circular theme/radius-sm)
                                 .border (m/Border.all .color (theme/divider) .width 0.5))
                    .child
                    (mongol-field !ime query-ctrl query-focus "ᠬᠠᠶᠢᠬᠤ...")))) ;; "Search..."
                 
                 ;; Bottom actions: Loading indicator or clear text button
                 (m/Padding
                  .padding (m.EdgeInsets/all 16.0)
                  .child
                  (if searching?
                    (m/SizedBox .width 24.0 .height 24.0
                                .child (m/CircularProgressIndicator .strokeWidth 2.0 .color (theme/sky)))
                    (m/IconButton
                     .icon (m/Icon m.Icons/close .color (theme/ink-muted))
                     .tooltip "Clear"
                     .onPressed (fn []
                                  (.clear query-ctrl)
                                  (store/set-search-query! "")
                                  (store/clear-search-filters!)
                                  (store/set-search-results! [])
                                  nil))))]))
              
              ;; Column 2: The Vertical Filter Chips
              (m/Container
               .padding (m.EdgeInsets/only .right 16.0)
               .child
               (m/Row
                .children
                [(vertical-filter-chip "ᠤᠩᠰᠢᠭᠠᠳᠦᠢ" m.Icons/mark_email_unread_outlined :unread filters query-ctrl) ;; Unread
                 (vertical-filter-chip "ᠬᠠᠪᠰᠤᠷᠠᠯᠲᠠ" m.Icons/attach_file :attachment filters query-ctrl) ;; Attachment
                 (vertical-filter-chip "ᠣᠳᠣ ᠲᠠᠢ" m.Icons/star_border :starred filters query-ctrl) ;; Starred
                 (vertical-filter-chip "ᠡᠨᠡ ᠳᠣᠯᠣᠭ᠎ᠠ ᠬᠣᠨᠣᠭ" m.Icons/date_range :this-week filters query-ctrl)]))])) ;; This Week
           
           ;; --- Right panel: Horizontal scrollable search results ---
           (m/Expanded
            .child
            (results-body search-results searching? navigator search-query filters))])
         "search-ime"))))))
