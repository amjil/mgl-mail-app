(ns mail-app.desktop.screens.home
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [mail-app.desktop.screens.mail-detail :as detail]
            [mail-app.desktop.screens.signup :as signup]
            [mail-app.desktop.shortcuts :as shortcuts]
            [mail-app.desktop.widgets.error-banner :as err]
            [mail-app.desktop.widgets.mailbox :as mailbox]
            [mail-app.desktop.widgets.maillist :as maillist]
            [mail-app.desktop.widgets.reader-pane :as reader-pane]
            [mail-app.desktop.widgets.topbar :as topbar]
            [mail-app.shared.actions.mail-actions :as mail-actions]
            [mail-app.shared.utils.format :as fmt]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme]))

(def ^:private split-handle-width 14.0)

(defn- clamp-folder-width [w max-w]
  (let [lo theme/folder-pane-min-width
        hi (max lo (min theme/folder-pane-max-width max-w))]
    (-> (double (or w theme/folder-pane-width))
        (max lo)
        (min hi))))

(defn- folder-split-handle
  "Interactive split-pane resizer between left mailbox list and right mail list.
   Always shows a subtle grip handle; highlights on hover/drag; double-click resets width."
  [max-w]
  (f/widget
   :managed [!hover? (atom false) :dispose nil
             !dragging? (atom false) :dispose nil]
   :watch [hover? !hover?
           dragging? !dragging?]
   (let [active? (or hover? dragging?)]
     (m/MouseRegion
      .cursor m.SystemMouseCursors/resizeColumn
      .onEnter (fn [_] (reset! !hover? true) nil)
      .onExit (fn [_] (reset! !hover? false) nil)
      .child
      (m/GestureDetector
       .behavior m.HitTestBehavior/opaque
       ;; Double-click to reset to default folder pane width (320.0)
       .onDoubleTap
       (fn []
         (store/set-folder-pane-width! theme/folder-pane-width)
         nil)
       .onHorizontalDragStart (fn [_] (reset! !dragging? true) nil)
       .onHorizontalDragEnd (fn [_] (reset! !dragging? false) nil)
       .onHorizontalDragCancel (fn [] (reset! !dragging? false) nil)
       .onHorizontalDragUpdate
       (fn [^m/DragUpdateDetails d]
         (let [dx (.-dx ^m/Offset (.-delta d))
               cur (or (:folder-pane-width @store/app-state)
                       theme/folder-pane-width)]
           (store/set-folder-pane-width!
            (clamp-folder-width (+ cur dx) max-w)))
         nil)
       .child
       (m/Tooltip
        .message "Drag to resize · Double-click to reset"
        .waitDuration (dart:core/Duration. .milliseconds 700)
        .child
        (m/AnimatedContainer
         .duration theme/pane-anim
         .width split-handle-width
         .decoration (m/BoxDecoration
                      .color (cond
                               dragging? (.withOpacity (theme/sky) 0.14)
                               hover? (.withOpacity (theme/sky) 0.07)
                               :else (theme/paper-deep))
                      .border (m/Border
                               .left (m/BorderSide
                                      .color (if active?
                                               (.withOpacity (theme/sky) 0.45)
                                               (theme/divider))
                                      .width 0.8)
                               .right (m/BorderSide
                                       .color (if active?
                                                (.withOpacity (theme/sky) 0.45)
                                                (theme/divider))
                                       .width 0.8)))
         .child
         (m/Center
          .child
          ;; Center pill grip with subtle dual vertical ridges
          (m/AnimatedContainer
           .duration theme/pane-anim
           .width (if active? 6.0 4.0)
           .height (if active? 64.0 40.0)
           .decoration (m/BoxDecoration
                        .color (if active?
                                 (theme/sky)
                                 (.withOpacity (theme/ink-muted) 0.45))
                        .borderRadius (m/BorderRadius.circular 4.0)
                        .boxShadow (when active?
                                     [(m/BoxShadow
                                       .color (.withOpacity (theme/sky) 0.35)
                                       .blurRadius 8.0)])))))))))))

(defn- folder-mail-split []
  (f/widget
   :watch [{:keys [folder-pane-width]} store/app-state]
   (m/LayoutBuilder
    .builder
    (fn [_ctx ^m/BoxConstraints constraints]
      (let [avail (.-maxWidth constraints)
            ;; Subtract split-handle-width so the Row never overflows on narrow windows
            max-folder (max theme/folder-pane-min-width
                            (- avail theme/mail-list-min-width split-handle-width))
            folder-w (clamp-folder-width folder-pane-width max-folder)]
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/stretch
         .children
         [(m/SizedBox
           .width folder-w
           .child
           (m/ColoredBox
            .color (theme/paper-deep)
            .child (mailbox/mailbox-list)))
          (folder-split-handle max-folder)
          (m/Expanded
           .child
           (m/ColoredBox
            .color (theme/paper)
            .child (maillist/list-view)))]))))))

(defn screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [accounts selected-mailbox selected-message-ids mail-list
                   reading-mail? message-detail]}
           store/app-state]
   (if (empty? accounts)
     (signup/screen)
     (do
       (when (nil? selected-mailbox)
         (async/Future.microtask
          #(mail/select-mailbox! :inbox)))
       (let [msg (when message-detail
                   (.-message ^mc/MailMessageWithBody message-detail))
             archived? (when msg
                         (or (= (.-state ^mc/MailMessageDto msg) "archive")
                             (= (.-folderRole ^mc/MailMessageDto msg) "archive")))
             junked? (when msg
                       (or (= (.-state ^mc/MailMessageDto msg) "junk")
                           (= (.-folderRole ^mc/MailMessageDto msg) "junk")))
             draft? (when msg
                      (or (= (.-state ^mc/MailMessageDto msg) "draft")
                          (= (.-folderRole ^mc/MailMessageDto msg) "draft")))
             starred? (when msg (.-isStarred ^mc/MailMessageDto msg))
             read? (when msg (.-isRead ^mc/MailMessageDto msg))
             bindings
             (cond-> {(shortcuts/cmd-key s.LogicalKeyboardKey/keyA)
                      (fn []
                        (when (and (not reading-mail?) (seq mail-list))
                          (let [all-ids (map #(.-id ^mc/MailMessageDto %) mail-list)]
                            (store/set-selected-message-ids! all-ids)))
                        nil)
                      (shortcuts/raw-key s.LogicalKeyboardKey/escape)
                      (fn []
                        (cond
                          reading-mail?
                          (store/exit-reading!)
                          (seq selected-message-ids)
                          (store/clear-message-selection!))
                        nil)}
               reading-mail?
               (assoc (shortcuts/cmd-key s/LogicalKeyboardKey.keyR)
                      (fn []
                        (when (and message-detail (not draft?))
                          (mail-actions/start-reply! navigator message-detail fmt/format-date))
                        nil)
                      (shortcuts/cmd-shift-key s/LogicalKeyboardKey.keyR)
                      (fn []
                        (when (and message-detail (not draft?))
                          (mail-actions/start-reply-all! navigator message-detail fmt/format-date))
                        nil)
                      (shortcuts/raw-key s.LogicalKeyboardKey/delete)
                      (fn []
                        (when message-detail
                          (detail/confirm-delete! ctx navigator message-detail))
                        nil)
                      (shortcuts/raw-key s.LogicalKeyboardKey/backspace)
                      (fn []
                        (when message-detail
                          (detail/confirm-delete! ctx navigator message-detail))
                        nil)))]
         (shortcuts/with-shortcuts
          bindings
          (m/Scaffold
           .backgroundColor (theme/paper)
           .body
           (m/SafeArea
            .child
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/stretch
             .children
             [(topbar/shell
               :on-back (fn [] (store/exit-reading!) nil)
               :archived? archived?
               :junked? junked?
               :draft? draft?
               :starred? starred?
               :read? read?
               :on-reply (when (and message-detail (not draft?))
                           #(mail-actions/start-reply! navigator message-detail fmt/format-date))
               :on-reply-all (when (and message-detail (not draft?))
                               #(mail-actions/start-reply-all! navigator message-detail fmt/format-date))
               :on-forward (when (and message-detail (not draft?))
                             #(mail-actions/start-forward! navigator message-detail fmt/format-date))
               :on-edit-draft (when (and message-detail draft?)
                                #(mail-actions/start-edit-draft! navigator message-detail))
               :on-star (when msg
                          (fn []
                            (let [^mc/MailMessageDto m msg]
                              (mail/set-starred! (.-id m) (not (.-isStarred m)))
                              nil)))
               :on-toggle-read (when msg
                                 (fn []
                                   (let [^mc/MailMessageDto m msg]
                                     (mail/set-read! (.-id m) (not (.-isRead m)))
                                     nil)))
               :on-archive (when (and message-detail (not archived?) (not draft?))
                             #(detail/archive-pressed! ctx navigator message-detail))
               :on-unarchive (when (and message-detail archived?)
                               #(detail/move-to-inbox-pressed! ctx navigator message-detail))
               :on-junk (when (and message-detail (not junked?) (not draft?))
                          #(detail/junk-pressed! ctx navigator message-detail))
               :on-not-junk (when (and message-detail junked?)
                              #(detail/not-junk-pressed! ctx navigator message-detail))
               :on-delete (when message-detail
                            #(detail/confirm-delete! ctx navigator message-detail)))
              (err/banner)
              (m/Expanded
               .child
               (if reading-mail?
                 (m/ColoredBox
                  .color (theme/surface)
                  .child (reader-pane/pane))
                 (folder-mail-split)))])))))))))
