(ns mail-app.desktop.screens.compose
  "Desktop compose: header text fields + mongol block editor body.
   Reply/forward shows original mail in a toggle panel (toggle.cljd)."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [block-editor.widgets.editor :as editor]
            [block-editor.widgets.toolbar :as toolbar]
            [shared-ime.overlay-view :as overlay]
            [mail-app.desktop.shortcuts :as shortcuts]
            [mail-app.desktop.widgets.compose-fields :as fields]
            [mail-app.desktop.widgets.compose-quote :as quote]
            [mail-app.desktop.widgets.compose-topbar :as topbar]
            [mail-app.services.compose-export :as export]
            [mail-app.state.store :as store]
            [mail-app.theme :refer [font-family]]))

(def compose-editor-config
  {:text-block-types #{:paragraph :heading-1 :heading-2 :heading-3
                       :blockquote :list-item :ordered-list-item :toggle}
   :block-style
   (fn [b-type]
     (case b-type
       :heading-1 (m/TextStyle .fontSize 28.0 .fontWeight m/FontWeight.bold
                               .color m.Colors/black87 .fontFamily font-family)
       :heading-2 (m/TextStyle .fontSize 22.0 .fontWeight m/FontWeight.bold
                               .color m.Colors/black87 .fontFamily font-family)
       :heading-3 (m/TextStyle .fontSize 18.0 .fontWeight m/FontWeight.w600
                               .color m.Colors/black87 .fontFamily font-family)
       (m/TextStyle .fontSize 16.0 .color m.Colors/black87
                    .fontFamily font-family)))})

(defn- apply-fields!
  [draft to-ctrl cc-ctrl bcc-ctrl subject-ctrl !show-cc? !show-bcc?]
  (when draft
    (when-let [to (:to draft)]
      (set! (.-text to-ctrl) (str to)))
    (when-let [cc (:cc draft)]
      (when (seq (str/trim (str cc)))
        (reset! !show-cc? true)
        (set! (.-text cc-ctrl) (str cc))))
    (when-let [bcc (:bcc draft)]
      (when (seq (str/trim (str bcc)))
        (reset! !show-bcc? true)
        (set! (.-text bcc-ctrl) (str bcc))))
    (when-let [subject (:subject draft)]
      (set! (.-text subject-ctrl) (str subject)))))

(defn- initial-doc-state [draft signature]
  (cond
    ;; Reopen from drafts: restore saved editor state as-is.
    (:body-state draft) (:body-state draft)
    ;; Plain-text draft restore (also skip re-injecting signature).
    (:body-plain draft) (export/state-from-plain-text (:body-plain draft))
    ;; New / reply / forward: seed signature with two blank lines above.
    :else
    (let [text (if (seq signature) (str "\n\n-- \n" signature) "")]
      (export/state-from-plain-text text))))

(defn- dispose-auto-save!
  "Cancel pending timer and detach listeners registered by auto-save setup."
  [{:keys [!auto-save-timer to-ctrl cc-ctrl bcc-ctrl subject-ctrl
           !doc-state trigger!]}]
  (when-let [t @!auto-save-timer] (.cancel ^async/Timer t))
  (.removeListener ^m/TextEditingController to-ctrl trigger!)
  (.removeListener ^m/TextEditingController cc-ctrl trigger!)
  (.removeListener ^m/TextEditingController bcc-ctrl trigger!)
  (.removeListener ^m/TextEditingController subject-ctrl trigger!)
  (remove-watch !doc-state :auto-save)
  nil)

(defn screen []
  (let [draft (:compose-draft @store/app-state)
        _ (when draft (store/clear-compose-draft!))
        aid (or (:account-id draft) (:current-account-id @store/app-state))
        signature (store/get-signature aid)
        !doc-state (atom (initial-doc-state draft signature))
        !quote-state (atom (:quote-state draft))
        !show-cc? (atom false)
        !show-bcc? (atom false)
        !attachment-paths (atom (vec (or (:attachment-paths draft) [])))
        !fields-draft (atom draft)
        ;; Atom so silent auto-save can record the returned draft-message-id.
        !draft-meta (atom (select-keys (or draft {})
                                       [:draft-message-id :in-reply-to :references
                                        :account-id]))
        has-quote? (some? (:quote-state draft))
        !auto-save-timer (atom nil)
        !auto-save-gate (atom {:inflight? false :pending? false})]
    (f/widget
     :managed [to-ctrl (m/TextEditingController.)
               to-focus (m/FocusNode.)
               cc-ctrl (m/TextEditingController.)
               cc-focus (m/FocusNode.)
               bcc-ctrl (m/TextEditingController.)
               bcc-focus (m/FocusNode.)
               subject-ctrl (m/TextEditingController.)
               subject-focus (m/FocusNode.)
               auto-save
               (let [trigger!
                     (fn []
                       (when-let [t @!auto-save-timer] (.cancel ^async/Timer t))
                       (reset! !auto-save-timer
                               (async/Timer.
                                (dart:core/Duration. .seconds 5)
                                #(topbar/silent-save-draft!
                                  !doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl
                                  subject-ctrl @!show-cc? @!show-bcc?
                                  (:current-account-id @store/app-state)
                                  @!attachment-paths !draft-meta !auto-save-gate))))]
                 (.addListener ^m/TextEditingController to-ctrl trigger!)
                 (.addListener ^m/TextEditingController cc-ctrl trigger!)
                 (.addListener ^m/TextEditingController bcc-ctrl trigger!)
                 (.addListener ^m/TextEditingController subject-ctrl trigger!)
                 (add-watch !doc-state :auto-save
                            (fn [_ _ old new]
                              ;; Ignore selection-only updates (cursor moves).
                              (when (not= (:blocks old) (:blocks new))
                                (trigger!))))
                 {:!auto-save-timer !auto-save-timer
                  :to-ctrl to-ctrl
                  :cc-ctrl cc-ctrl
                  :bcc-ctrl bcc-ctrl
                  :subject-ctrl subject-ctrl
                  :!doc-state !doc-state
                  :trigger! trigger!})
               :dispose dispose-auto-save!
               :refresh-on nil]
     :context ctx
     :get [m/Navigator]
     :watch [show-cc? !show-cc?
             show-bcc? !show-bcc?
             {:keys [sending? current-account-id]} store/app-state
             attachment-paths !attachment-paths]
     (do
       (when-let [d @!fields-draft]
         (reset! !fields-draft nil)
         (apply-fields! d to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                        !show-cc? !show-bcc?))
       (shortcuts/with-shortcuts
        {;; Send
         (shortcuts/cmd-key s/LogicalKeyboardKey.enter)
         (fn []
           (topbar/send-pressed! ctx navigator !doc-state !quote-state
                                 to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                 show-cc? show-bcc? sending?
                                 current-account-id
                                 attachment-paths @!draft-meta)
           nil)

         ;; Save draft explicitly (manual save)
         (shortcuts/cmd-key s/LogicalKeyboardKey.keyS)
         (fn []
           (topbar/save-draft-pressed! ctx navigator !doc-state !quote-state
                                       to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                       show-cc? show-bcc? sending?
                                       current-account-id
                                       attachment-paths @!draft-meta)
           nil)}

        (m/Scaffold
         .backgroundColor m.Colors/white
         .body
         ;; One page-level IME overlay (like rich-editor desktop). Header fields
         ;; share !doc-state; editor uses :wrap-ime? false to avoid nested
         ;; candidates overlays.
         (overlay/ime-global-wrapper
          (m/SafeArea
           .child
           (m/Column
            .crossAxisAlignment m.CrossAxisAlignment/stretch
            .children
            [(topbar/topbar {:!doc-state !doc-state
                             :!quote-state !quote-state
                             :to-ctrl to-ctrl
                             :cc-ctrl cc-ctrl
                             :bcc-ctrl bcc-ctrl
                             :subject-ctrl subject-ctrl
                             :!show-cc? !show-cc?
                             :!show-bcc? !show-bcc?
                             :!attachment-paths !attachment-paths
                             :!draft-meta !draft-meta})
             (m/Divider .thickness 1.0 .height 1.0)
             (m/Expanded
              .child
              (m/Row
               .crossAxisAlignment m.CrossAxisAlignment/stretch
               .children
               (cond->
                 [(fields/header-row
                   {:!ime !doc-state
                    :to-ctrl to-ctrl :to-focus to-focus
                    :cc-ctrl cc-ctrl :cc-focus cc-focus
                    :bcc-ctrl bcc-ctrl :bcc-focus bcc-focus
                    :subject-ctrl subject-ctrl :subject-focus subject-focus
                    :show-cc? show-cc?
                    :show-bcc? show-bcc?})
                  (m/VerticalDivider .width 1.0 .thickness 1.0)
                  (m/Expanded
                   .flex 2
                   .child
                   (editor/mongol-block-editor
                    !doc-state
                    :editor-config compose-editor-config
                    :toolbar (toolbar/editor-toolbar !doc-state compose-editor-config)
                    :background-color m.Colors/white
                    :show-block-handles? false
                    :wrap-ime? false
                    :padding (m.EdgeInsets/all 24.0)))]
                 has-quote?
                 (conj (m/Expanded
                        .flex 1
                        .child (quote/panel !quote-state))))))])))))))))
