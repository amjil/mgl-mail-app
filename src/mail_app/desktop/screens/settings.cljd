(ns mail-app.desktop.screens.settings
  "Desktop settings: horizontal Mongolian layout via components.setting."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [components.setting :as cs]
            [mail-app.desktop.toast :as toast]
            [mail-app.desktop.widgets.account-menu :as accounts]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [current-account-id accounts]} store/app-state]
   (let [current (some #(when (= (.-id ^mc/MailAccountDto %) current-account-id) %)
                       accounts)
         current-email (when current (.-email ^mc/MailAccountDto current))
         current-sig (or (store/get-signature current-account-id) "")
         !auto-sync? (atom true)
         !notify? (atom true)
         acc-items (mapv
                    (fn [^mc/MailAccountDto acc]
                      (let [aid (.-id acc)
                            email (.-email acc)
                            active? (= aid current-account-id)]
                        {:leading (if active? m.Icons/check_circle m.Icons/account_circle_outlined)
                         :title email
                         :subtitle (if active? "Active" "Switch")
                         :show-arrow? false
                         :on-tap (fn []
                                   (if active?
                                     (toast/info! ctx "Already active")
                                     (do
                                       (mail/set-current-account! aid)
                                       (mail/select-mailbox! :inbox)
                                       (toast/success! ctx (str "Switched to " email))))
                                   nil)}))
                    (or accounts []))
         add-item {:leading m.Icons/add_circle_outline
                   :title "Add account"
                   :subtitle "Connect a new address"
                   :show-arrow? true
                   :on-tap (fn []
                             (.pushNamed navigator "/signup")
                             nil)}
         remove-item {:leading m.Icons/delete_outline_rounded
                      :title "Remove account"
                      :subtitle "Delete the active account"
                      :show-arrow? false
                      :on-tap (fn []
                                (when current-account-id
                                  (m/showDialog
                                   .context ctx
                                   .builder (fn [^m/BuildContext dialog-ctx]
                                              (m/AlertDialog
                                               .title (m/Text "Remove account")
                                               .content (m/Text (str "Remove "
                                                                     (or current-email "this account")
                                                                     "?"))
                                               .actions
                                               [(m/TextButton
                                                 .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx)) nil)
                                                 .child (m/Text "Cancel"))
                                                (m/TextButton
                                                 .onPressed (fn []
                                                              (.pop (m/Navigator.of dialog-ctx))
                                                              (-> (mail/remove-account! current-account-id)
                                                                  (.then (fn [_]
                                                                           (toast/success! ctx "Account removed")
                                                                           nil))
                                                                  (.catchError (fn [e]
                                                                                 (toast/error! ctx (str e))
                                                                                 nil)))
                                                              nil)
                                                 .child (m/Text "Remove"
                                                               .style (m/TextStyle .color theme/danger)))]))))
                                nil)}]
     (m/Scaffold
      .backgroundColor theme/paper
      .appBar
      (m/AppBar
       .elevation 0.0
       .backgroundColor theme/paper
       .foregroundColor theme/ink
       .leading (m/IconButton
                 .icon (m/Icon m.Icons/arrow_back_ios_new)
                 .tooltip "Back"
                 .onPressed (fn []
                              (when (.canPop navigator)
                                (.pop navigator))
                              nil))
       .title (m/Text "Settings"
                      .style (m/TextStyle .fontFamily font-family
                                          .fontWeight m.FontWeight/bold)))
      .body
      (m/SafeArea
       .child
       (m/SingleChildScrollView
        .scrollDirection m.Axis/horizontal
        .padding (m.EdgeInsets/symmetric .vertical 12.0 .horizontal 8.0)
        .child
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children
         [(cs/settings-section
           "Accounts"
           (conj acc-items add-item remove-item))
          (cs/settings-section
           "Signature"
           [{:leading m.Icons/edit_note_rounded
             :title "Signature"
             :subtitle (cond
                         (nil? current-account-id) "Select an account first"
                         (seq current-sig) "Configured"
                         :else "Empty")
             :show-arrow? true
             :on-tap (fn []
                       (when current-account-id
                         (accounts/signature-dialog!
                          ctx current-account-id current-email))
                       nil)}])
          (f/widget
           :watch [auto-sync? !auto-sync?
                   notify? !notify?]
           (cs/settings-section
            "Network & Notifications"
            [{:leading m.Icons/sync_rounded
              :title "Auto Sync"
              :subtitle "Every 5 minutes"
              :value auto-sync?
              :on-changed (fn [v] (reset! !auto-sync? v))}
             {:leading m.Icons/notifications_none_rounded
              :title "Notifications"
              :subtitle "When new mail arrives"
              :value notify?
              :on-changed (fn [v] (reset! !notify? v))}]))
          (cs/settings-section
           "Other"
           [{:leading m.Icons/cleaning_services_rounded
             :title "Clear Cache"
             :subtitle "Temporary data"
             :show-arrow? true
             :on-tap (fn []
                       (toast/success! ctx "Cache cleared")
                       nil)}
            {:leading m.Icons/info_outline_rounded
             :title "Version"
             :subtitle "v1.0.0 (Alpha)"
             :show-arrow? false}])])))))))
