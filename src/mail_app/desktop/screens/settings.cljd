(ns mail-app.desktop.screens.settings
  "Desktop settings: Pure vertical Traditional Mongolian layout."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [components.dialog :as dialog]
            [components.setting :as cs]
            [mail-app.desktop.widgets.account-menu :as accounts]
            [mail-app.services.mail-core :as mail]
            [mail-app.shared.toast :as toast]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- confirm-remove-account! [ctx account-id email]
  (m/showDialog
   .context ctx
   .builder
   (fn [d-ctx]
     (dialog/vertical-custom-dialog
      {:title "ᠳᠠᠩᠰᠠ ᠤᠰᠠᠳᠬᠠᠬᠤ" ;; Remove account
       :width-factor 0.65
       :height-factor 0.45
       :body (mgl/MongolText
              (str (or email "") "\nᠲᠠ ᠡᠨᠡ ᠳᠠᠩᠰᠠ ᠶᠢ ᠤᠰᠠᠳᠬᠠᠬᠤ ᠳᠠᠭᠠᠨ ᠢᠲᠡᠭᠡᠯᠲᠡᠢ ᠪᠠᠶᠢᠨ᠎ᠠ ᠤᠤ?")
              .style (m/TextStyle .fontFamily font-family
                                  .fontSize 18.0
                                  .color (theme/ink)
                                  .height 1.4))
       :actions
       [(mgl/MongolTextButton
         .onPressed (fn [] (.pop (m/Navigator.of d-ctx)) nil)
         .child (mgl/MongolText "ᠪᠣᠯᠢᠬᠤ"
                                .style (m/TextStyle .fontFamily font-family
                                                    .color (theme/ink-muted))))
        (mgl/MongolTextButton
         .onPressed (fn []
                      (.pop (m/Navigator.of d-ctx))
                      (-> (mail/remove-account! account-id)
                          (.then (fn [_]
                                   (toast/success! ctx "ᠳᠠᠩᠰᠠ ᠤᠰᠠᠳᠬᠠᠭᠳᠠᠪᠠ")
                                   nil))
                          (.catchError (fn [e]
                                         (toast/error! ctx (str e))
                                         nil)))
                      nil)
         .child (mgl/MongolText "ᠤᠰᠠᠳᠬᠠᠬᠤ"
                                .style (m/TextStyle .fontFamily font-family
                                                    .color (theme/danger))))]}))))

(defn screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [current-account-id accounts dark-mode?
                   auto-sync? notify? use-builtin-ime?]}
           store/app-state]
   (let [current (some #(when (= (.-id ^mc/MailAccountDto %) current-account-id) %)
                       accounts)
         current-email (when current (.-email ^mc/MailAccountDto current))
         current-sig (or (store/get-signature current-account-id) "")
         acc-items (mapv
                    (fn [^mc/MailAccountDto acc]
                      (let [aid (.-id acc)
                            email (.-email acc)
                            active? (= aid current-account-id)]
                        {:leading (if active?
                                    m.Icons/check_circle
                                    m.Icons/account_circle_outlined)
                         :title email
                         :subtitle (if active? "ᠢᠳᠡᠪᠬᠢᠲᠡᠢ" "ᠰᠣᠯᠢᠬᠤ") ;; Active / Switch
                         :show-arrow? false
                         :on-tap (fn []
                                   (if active?
                                     (toast/info! ctx "ᠢᠳᠡᠪᠬᠢᠲᠡᠢ ᠪᠠᠶᠢᠨ᠎ᠠ")
                                     (do
                                       (mail/set-current-account! aid)
                                       (mail/select-mailbox! :inbox)
                                       (toast/success! ctx (str email))))
                                   nil)}))
                    (or accounts []))
         add-item {:leading m.Icons/add_circle_outline
                   :title "ᠳᠠᠩᠰᠠ ᠨᠡᠮᠡᠬᠦ" ;; Add account
                   :subtitle "ᠰᠢᠨ᠎ᠡ ᠢᠮᠡᠢᠯ ᠬᠣᠯᠪᠣᠬᠤ" ;; Connect a new address
                   :show-arrow? true
                   :on-tap (fn []
                             (.pushNamed navigator "/signup")
                             nil)}
         remove-item {:leading m.Icons/delete_outline_rounded
                      :title "ᠳᠠᠩᠰᠠ ᠤᠰᠠᠳᠬᠠᠬᠤ" ;; Remove account
                      :subtitle "ᠢᠳᠡᠪᠬᠢᠲᠡᠢ ᠳᠠᠩᠰᠠ ᠶᠢ ᠤᠰᠠᠳᠬᠠᠬᠤ" ;; Remove active account
                      :show-arrow? false
                      :on-tap (fn []
                                (when current-account-id
                                  (confirm-remove-account! ctx current-account-id current-email))
                                nil)}]
     (m/Scaffold
      .backgroundColor (theme/paper)
      .body
      (m/SafeArea
       .child
       (m/Row
        .crossAxisAlignment m.CrossAxisAlignment/stretch
        .children
        [;; Left Vertical Header Strip (replaces horizontal AppBar)
         (m/Container
          .width 76.0
          .decoration (m/BoxDecoration
                       .color (theme/paper-deep)
                       .border (m/Border
                                .right (m/BorderSide .color (theme/divider) .width 0.8)))
          .child
          (m/Column
           .children
           [(m/Padding
             .padding (m.EdgeInsets/only .top 16.0 .bottom 12.0)
             .child
             (m/IconButton
              .icon (m/Icon m.Icons/arrow_back_ios_new .size 20.0 .color (theme/ink-muted))
              .onPressed (fn []
                           (when (.canPop navigator)
                             (.pop navigator))
                           nil)))
            (m/Divider .height 1.0 .thickness 0.5 .color (theme/divider))
            (m/Expanded
             .child
             (m/Center
              .child
              (mgl/MongolText
               "ᠲᠣᠬᠢᠷᠠᠭᠤᠯᠭ᠎ᠠ" ;; Settings
               .style (m/TextStyle .fontFamily font-family
                                   .fontSize 22.0
                                   .fontWeight m/FontWeight.bold
                                   .color (theme/ink)))))]))

         ;; Right Horizontal Scrollable Settings Sections
         (m/Expanded
          .child
          (m/SingleChildScrollView
           .scrollDirection m.Axis/horizontal
           .padding (m.EdgeInsets/symmetric .vertical 20.0 .horizontal 16.0)
           .child
           (m/Row
            .crossAxisAlignment m.CrossAxisAlignment/start
            .children
            [(cs/settings-section
              "ᠳᠠᠩᠰᠠ" ;; Accounts
              (conj acc-items add-item remove-item))
             (cs/settings-section
              "ᠭᠠᠷ ᠤᠨ ᠦᠰᠦᠭ" ;; Signature
              [{:leading m.Icons/edit_note_rounded
                :title "ᠭᠠᠷ ᠤᠨ ᠦᠰᠦᠭ"
                :subtitle (cond
                            (nil? current-account-id) "ᠳᠠᠩᠰᠠ ᠰᠣᠩᠭᠣᠨ᠎ᠠ ᠤᠤ"
                            (seq current-sig) "ᠲᠣᠬᠢᠷᠠᠭᠤᠯᠤᠭᠰᠠᠨ"
                            :else "ᠬᠣᠭᠣᠰᠣᠨ")
                :show-arrow? true
                :on-tap (fn []
                          (when current-account-id
                            (accounts/signature-dialog!
                             ctx current-account-id current-email))
                          nil)}])
             (cs/settings-section
              "ᠦᠵᠡᠭᠳᠡᠬᠦ ᠪᠠᠶᠢᠳᠠᠯ ᠪᠠ ᠦᠰᠦᠭ" ;; Appearance & Input
              [{:leading m.Icons/dark_mode_outlined
                :title "ᠰᠦᠨᠢ ᠶᠢᠨ ᠭᠣᠷᠢᠮ" ;; Dark Mode
                :subtitle "ᠬᠠᠷᠠᠩᠭᠤᠢ ᠳᠡᠪᠰᠢᠭᠦᠷ ᠥᠩᠭᠡ"
                :value (boolean dark-mode?)
                :on-changed (fn [_] (store/toggle-dark-mode!))}
               {:leading m.Icons/keyboard_alt_outlined
                :title "ᠳᠣᠲᠣᠭᠠᠳᠤ ᠮᠣᠩᠭᠣᠯ ᠭᠠᠷ" ;; Built-in Mongol IME
                :subtitle "ᠰᠢᠰᠲᠡᠮ ᠦᠨ ᠭᠠᠷ ᠲᠠᠢ ᠰᠣᠯᠢᠬᠤ"
                :value (boolean use-builtin-ime?)
                :on-changed (fn [_] (store/toggle-builtin-ime!))}])
             (cs/settings-section
              "ᠰᠦᠯᠵᠢᠶ᠎ᠡ ᠪᠠ ᠮᠡᠳᠡᠭᠳᠡᠯ" ;; Network & Notifications
              [{:leading m.Icons/sync_rounded
                :title "ᠠᠦ᠋ᠲ᠋ᠣ᠋ ᠢᠵᠢᠯᠡᠰᠦᠯ" ;; Auto Sync
                :subtitle "5 ᠮᠢᠨᠦ᠋ᠲ ᠲᠤᠲᠤᠮ"
                :value (boolean auto-sync?)
                :on-changed (fn [_] (store/toggle-auto-sync!))}
               {:leading m.Icons/notifications_none_rounded
                :title "ᠮᠡᠳᠡᠭᠳᠡᠯ" ;; Notifications
                :subtitle "ᠰᠢᠨ᠎ᠡ ᠵᠠᠬᠢᠳᠠᠯ ᠢᠷᠡᠬᠦ ᠦᠶ᠎ᠡ ᠳᠦ"
                :value (boolean notify?)
                :on-changed (fn [_] (store/toggle-notify!))}])
             (cs/settings-section
              "ᠪᠤᠰᠠᠳ" ;; Other
              [{:leading m.Icons/cleaning_services_rounded
                :title "ᠬᠡᠰ ᠴᠡᠪᠡᠷᠯᠡᠬᠦ" ;; Clear Cache
                :subtitle "ᠲᠦᠷ ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠰᠠᠨ ᠥᠭᠡᠭᠳᠡᠯ"
                :show-arrow? true
                :on-tap (fn []
                          (toast/success! ctx "ᠴᠡᠪᠡᠷᠯᠡᠭᠳᠡᠪᠡ")
                          nil)}
               {:leading m.Icons/info_outline_rounded
                :title "ᠬᠡᠪᠯᠡᠯ" ;; Version
                :subtitle "v1.0.0"
                :show-arrow? false}])])))]))))))
