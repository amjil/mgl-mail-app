(ns mail-app.desktop.screens.mail-detail
  "Mail actions + optional standalone /mail_detail route."
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/services.dart" :as s]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [components.dialog :as dialog]
            [mail-app.desktop.shortcuts :as shortcuts]
            [mail-app.desktop.toast :as toast]
            [mail-app.desktop.widgets.reader-pane :as reader-pane]
            [mail-app.desktop.widgets.topbar :as topbar]
            [mail-app.services.compose-export :as export]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme]))

(defn- body-text
  "Plain for reply/forward quotes. Prefer text/plain; else strip HTML."
  [^mc/MailMessageWithBody detail]
  (let [body (.-body detail)]
    (cond
      (nil? body) ""
      (seq (.-plainText body)) (.-plainText body)
      (seq (.-html body)) (mail/html->plain (.-html body))
      :else "")))

(defn- pad2 [n]
  (.padLeft (.toString n) 2 "0"))

(defn- format-date [d]
  (when d
    (let [^DateTime dt d]
      (str (.year dt) "-"
           (pad2 (.month dt)) "-"
           (pad2 (.day dt)) " "
           (pad2 (.hour dt)) ":"
           (pad2 (.minute dt))))))

(defn- ensure-prefix [subject prefix]
  (let [s (or subject "")]
    (if (str/starts-with? (str/lower-case s) (str/lower-case prefix))
      s
      (str prefix s))))

(defn- build-references [^mc/MailMessageDto msg]
  (let [mid (.-rfcMessageId msg)
        prev (.-referencesHeader msg)]
    (cond
      (and (seq prev) (seq mid)) (str prev " " mid)
      (seq mid) mid
      (seq prev) prev
      :else nil)))

(defn- finish-read! [navigator]
  (store/exit-reading!)
  (when (and navigator (.canPop navigator))
    (.pop navigator))
  nil)

(defn start-reply! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        from (or (.-from msg) "")
        subject (ensure-prefix (.-subject msg) "Re: ")
        text (body-text detail)
        date (format-date (.-date msg))
        mid (.-rfcMessageId msg)]
    (store/set-compose-draft!
     {:to from
      :subject subject
      :in-reply-to mid
      :references (build-references msg)
      :quote-state (export/quote-toggle-state from date text)})
    (.pushNamed navigator "/compose")
    nil))

(defn start-reply-all! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        from (or (.-from msg) "")
        subject (ensure-prefix (.-subject msg) "Re: ")
        text (body-text detail)
        date (format-date (.-date msg))
        mid (.-rfcMessageId msg)
        {:keys [to cc]} (mail/reply-all-recipients msg)]
    (store/set-compose-draft!
     (cond-> {:to to
              :subject subject
              :in-reply-to mid
              :references (build-references msg)
              :quote-state (export/quote-toggle-state from date text)}
       (seq cc) (assoc :cc cc)))
    (.pushNamed navigator "/compose")
    nil))

(defn start-forward! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        from (or (.-fromName msg) (.-from msg) "")
        subject (ensure-prefix (.-subject msg) "Fwd: ")
        text (body-text detail)
        date (format-date (.-date msg))]
    (store/set-compose-draft!
     {:to ""
      :subject subject
      :quote-state (export/quote-toggle-state from date text)})
    (.pushNamed navigator "/compose")
    nil))

(defn start-edit-draft! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)]
    (-> (mail/edit-draft! (.-id msg))
        (.then (fn [_]
                 (.pushNamed navigator "/compose")
                 nil))
        (.catchError (fn [_] nil)))
    nil))

(defn confirm-delete! [ctx navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        mid (.-id msg)
        tctx (toast/safe-ctx ctx)]
    (-> (m/showDialog
         .context ctx
         .builder
         (fn [dialog-ctx]
           (dialog/vertical-custom-dialog
            {:title "Delete message?"
             :width-factor 0.7
             :height-factor 0.5
             :body (mgl/MongolText "Move this message to Trash.")
             :actions
             [(m/TextButton
               .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx) false) nil)
               .child (mgl/MongolText "Cancel"))
              (m/TextButton
               .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx) true) nil)
               .child (mgl/MongolText "Delete"
                                     .style (m/TextStyle .color theme/danger)))]})))
        (.then (fn [ok?]
                 (when ok?
                   (-> (mail/delete-message! mid)
                       (.then (fn [ok]
                                (if ok
                                  (do
                                    (toast/success! tctx "Deleted")
                                    (store/clear-message-detail!)
                                    (finish-read! navigator)
                                    nil)
                                  (toast/error! tctx
                                                (or (:last-error @store/app-state)
                                                    "Delete failed")))))
                       (.catchError (fn [e]
                                      (toast/error! tctx (str e))
                                      nil))))
                 nil))
        (.catchError (fn [_] nil)))
    nil))

(defn archive-pressed! [ctx navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        mid (.-id msg)
        already? (or (= (.-state msg) "archive")
                     (= (.-folderRole msg) "archive"))
        tctx (toast/safe-ctx ctx)]
    (if already?
      (toast/info! tctx "Already archived")
      (-> (mail/archive-message! mid)
          (.then (fn [ok]
                   (if ok
                     (do
                       (toast/success! tctx "Archived")
                       (store/clear-message-detail!)
                       (finish-read! navigator)
                       nil)
                     (toast/error! tctx
                                   (or (:last-error @store/app-state)
                                       "Archive failed")))))
          (.catchError (fn [e]
                         (toast/error! tctx (str e))
                         nil))))
    nil))

(defn move-to-inbox-pressed! [ctx navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        mid (.-id msg)
        tctx (toast/safe-ctx ctx)]
    (-> (mail/move-to-inbox! mid)
        (.then (fn [ok]
                 (if ok
                   (do
                     (toast/success! tctx "Moved to Inbox")
                     (store/clear-message-detail!)
                     (finish-read! navigator)
                     nil)
                   (toast/error! tctx
                                 (or (:last-error @store/app-state)
                                     "Move to Inbox failed")))))
        (.catchError (fn [e]
                       (toast/error! tctx (str e))
                       nil)))
    nil))

(defn screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [message-detail]} store/app-state]
   (let [msg (when message-detail
               (.-message ^mc/MailMessageWithBody message-detail))
         archived? (when msg
                     (or (= (.-state ^mc/MailMessageDto msg) "archive")
                         (= (.-folderRole ^mc/MailMessageDto msg) "archive")))
         draft? (when msg
                  (or (= (.-state ^mc/MailMessageDto msg) "draft")
                      (= (.-folderRole ^mc/MailMessageDto msg) "draft")))
         starred? (when msg (.-isStarred ^mc/MailMessageDto msg))
         read? (when msg (.-isRead ^mc/MailMessageDto msg))]
     (shortcuts/with-shortcuts
      {(shortcuts/cmd-key s/LogicalKeyboardKey.keyR)
       (fn []
         (when (and message-detail (not draft?))
           (start-reply! navigator message-detail))
         nil)
       (shortcuts/cmd-shift-key s/LogicalKeyboardKey.keyR)
       (fn []
         (when (and message-detail (not draft?))
           (start-reply-all! navigator message-detail))
         nil)
       (shortcuts/raw-key s/LogicalKeyboardKey.delete)
       (fn []
         (when message-detail (confirm-delete! ctx navigator message-detail))
         nil)
       (shortcuts/raw-key s/LogicalKeyboardKey.backspace)
       (fn []
         (when message-detail (confirm-delete! ctx navigator message-detail))
         nil)}

      (m/Scaffold
       .body
       (m/SafeArea
        .child
        (m/Column
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children
         [(topbar/mail-detail
           :archived? archived?
           :draft? draft?
           :starred? starred?
           :read? read?
           :on-reply (when (and message-detail (not draft?))
                       #(start-reply! navigator message-detail))
           :on-reply-all (when (and message-detail (not draft?))
                           #(start-reply-all! navigator message-detail))
           :on-forward (when (and message-detail (not draft?))
                         #(start-forward! navigator message-detail))
           :on-edit-draft (when (and message-detail draft?)
                            #(start-edit-draft! navigator message-detail))
           :on-star (when msg
                      (fn []
                        (let [^mc/MailMessageDto m msg]
                          (mail/set-starred! (.-id m) (not (.-isStarred m)))
                          nil)))
           :on-toggle-read (when msg
                             (fn []
                               (let [^mc/MailMessageDto m msg]
                                 (mail/set-read! (.-id m) (not (.-isRead m)))
                                 nil)))
           :on-archive (when (and message-detail (not archived?) (not draft?))
                         #(archive-pressed! ctx navigator message-detail))
           :on-unarchive (when (and message-detail archived?)
                           #(move-to-inbox-pressed! ctx navigator message-detail))
           :on-delete (when message-detail
                        #(confirm-delete! ctx navigator message-detail)))
          (m/Divider .thickness 1.0 .height 1.0 .color theme/divider)
          (m/Expanded .child (reader-pane/pane))])))))))
