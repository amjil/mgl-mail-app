(ns mail-app.theme
  "Shared UI constants — Eternal Sky palette for desktop."
  (:require ["package:flutter/material.dart" :as m]))

(def font-family "OyunQaganTig")

;; --- Color tokens ---
(def sky (m/Color 0xFF1A6FA8))
(def sky-light (m/Color 0xFFE7F1F7))
(def paper (m/Color 0xFFF6F3EC))
(def surface (m/Color 0xFFFFFFFF))
(def ink (m/Color 0xFF1A2332))
(def ink-muted (m/Color 0xFF6B7380))
(def gold (m/Color 0xFFC4A035))
(def danger (m/Color 0xFFC62828))
(def divider (m/Color 0xFFD5DEE6))

;; --- Layout ---
(def folder-pane-width 320.0)
(def folder-col-width 60.0)
(def mail-col-width 100.0)
(def pane-anim (dart:core/Duration. .milliseconds 200))

(defn sky-theme
  "Material 3 ThemeData seeded from sky blue."
  []
  (m/ThemeData
   .useMaterial3 true
   .fontFamily font-family
   .colorScheme (m.ColorScheme/fromSeed
                 .seedColor sky
                 .brightness m.Brightness/light)
   .scaffoldBackgroundColor paper
   .dividerColor divider
   .iconTheme (m/IconThemeData .color ink .size 22.0)))
