(ns mail-app.theme
  "Shared UI constants — Eternal Sky palette for mobile and desktop."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]))

(def font-family "OyunQaganTig")

;; --- Color tokens ---
(def sky (m/Color 0xFF1A6FA8))
(def sky-deep (m/Color 0xFF145A8A))
(def sky-light (m/Color 0xFFF0F6FA)) ;; more translucent
(def sky-soft (m/Color 0xFFDCEAF5))
(def paper (m/Color 0xFFF8F9FA)) ;; closer to modern Mac clean gray-white
(def paper-deep (m/Color 0xFFF0F2F5)) ;; soft sidebar background
(def surface (m/Color 0xFFFFFFFF))
(def ink (m/Color 0xFF1C222B)) ;; darker text for stronger contrast
(def ink-muted (m/Color 0xFF7A8494))
(def gold (m/Color 0xFFD4AF37))
(def danger (m/Color 0xFFD32F2F))
(def danger-soft (m/Color 0xFFFDECEA))
(def divider (m/Color 0xFFE4E7EB)) ;; extremely soft dividers
(def hover (m/Color 0xFFF4F6F8))

;; --- Layout ---
(def folder-pane-width 320.0)
(def folder-pane-min-width 160.0)
(def folder-pane-max-width 720.0)
(def mail-list-min-width 200.0)
(def folder-col-width 76.0)  ;; slightly wider so folders feel more spacious
(def mail-col-width 130.0)   ;; slightly wider so mail titles and snippets breathe
(def chrome-height 64.0)     ;; taller top bar for more breathing room
(def radius-sm 8.0)
(def radius-md 12.0)         ;; rounder modern card corners
(def radius-lg 20.0)
(def pane-anim (dart:core/Duration. .milliseconds 250))

(defn empty-state
  "Centered sky-circle icon + vertical Mongol label."
  [icon label]
  (m/Center
   .child
   (m/Row
    .mainAxisSize m.MainAxisSize/min
    .children
    [(m/Container
      .width 80.0
      .height 80.0
      .decoration (m/BoxDecoration
                   .color sky-light
                   .shape m.BoxShape/circle)
      .child (m/Center
              .child (m/Icon icon .size 36.0 .color sky)))
     (m/SizedBox .width 24.0)
     (mgl/MongolText
      label
      .style (m/TextStyle .fontFamily font-family
                          .color ink-muted
                          .fontSize 20.0
                          .fontWeight m/FontWeight.w500
                          .height 1.4))])))

(defn card-shadow
  "Soft elevation for dialogs / signup card. Projecting slightly right."
  []
  [(m/BoxShadow
    .color (.withOpacity ink 0.08)
    .blurRadius 32.0
    .offset (m/Offset. 4.0 12.0))])

(defn hair-shadow
  "1px-feel drop under chrome, tailored for HORIZONTAL layout."
  []
  [(m/BoxShadow
    .color (.withOpacity ink 0.04)
    .blurRadius 12.0
    .offset (m/Offset. 6.0 0.0))]) ;; shadow projects right — for the horizontal scroll layout

(defn sky-theme []
  (m/ThemeData
   .useMaterial3 true
   .fontFamily font-family
   .colorScheme (m.ColorScheme/fromSeed
                 .seedColor sky
                 .brightness m.Brightness/light
                 .primary sky
                 .onPrimary m.Colors/white
                 .surface surface)
   .scaffoldBackgroundColor paper
   .dividerColor divider
   .iconTheme (m/IconThemeData .color ink-muted .size 20.0)
   .appBarTheme (m/AppBarTheme
                 .elevation 0.0
                 .scrolledUnderElevation 0.0
                 .backgroundColor surface
                 .foregroundColor ink
                 .iconTheme (m/IconThemeData .color ink-muted .size 22.0)
                 .actionsIconTheme (m/IconThemeData .color ink-muted .size 22.0)
                 .titleTextStyle (m/TextStyle
                                  .fontFamily font-family
                                  .fontSize 18.0
                                  .fontWeight m/FontWeight.w600
                                  .color ink))
   .floatingActionButtonTheme
   (m/FloatingActionButtonThemeData
    .backgroundColor sky
    .foregroundColor m.Colors/white
    .elevation 4.0
    .shape (m/RoundedRectangleBorder
            .borderRadius (m/BorderRadius.circular radius-lg)))
   .dialogTheme
   (m/DialogThemeData
    .backgroundColor surface
    .elevation 24.0
    .shape (m/RoundedRectangleBorder
            .borderRadius (m/BorderRadius.circular radius-lg)))
   .bottomSheetTheme
   (m/BottomSheetThemeData
    .backgroundColor surface
    .shape (m/RoundedRectangleBorder
            .borderRadius (m/BorderRadius.vertical
                           .top (m.Radius/circular radius-lg))))
   .dividerTheme (m/DividerThemeData
                  .color divider
                  .space 1.0
                  .thickness 1.0)
   .tooltipTheme (m/TooltipThemeData
                  .waitDuration (dart:core/Duration. .milliseconds 600))
   .inputDecorationTheme
   (m/InputDecorationTheme
    .filled true
    .fillColor paper
    .contentPadding (m.EdgeInsets/symmetric .horizontal 16.0 .vertical 16.0)
    .hintStyle (m/TextStyle .color ink-muted .fontSize 14.0)
    .border (m/OutlineInputBorder
             .borderRadius (m/BorderRadius.circular radius-md)
             .borderSide m.BorderSide/none)
    .enabledBorder (m/OutlineInputBorder
                    .borderRadius (m/BorderRadius.circular radius-md)
                    .borderSide m.BorderSide/none)
    .focusedBorder (m/OutlineInputBorder
                    .borderRadius (m/BorderRadius.circular radius-md)
                    .borderSide (m/BorderSide .color sky .width 2.0)))))