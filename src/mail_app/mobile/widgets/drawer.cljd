(ns mail-app.mobile.widgets.drawer
  "Home drawer: account header, vertical Mongol mailbox columns, settings."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [mail-app.services.mail-core :as mail]
            [mail-app.shared.i18n :as i18n]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- folder-item [label icon key current-sel ctx]
  (let [selected? (= key current-sel)]
    (m/Container
     .width 74.0
     .margin (m.EdgeInsets/symmetric .horizontal 5.0 .vertical 12.0)
     .decoration (m/BoxDecoration
                  .color (if selected? (theme/surface) m.Colors/transparent)
                  .borderRadius (m/BorderRadius.circular theme/radius-md)
                  .border (m/Border.all
                           .color (if selected? (theme/sky) m.Colors/transparent)
                           .width 1.2)
                  .boxShadow (when selected? (theme/hair-shadow)))
     .child
     (m/Stack
      .alignment m.Alignment/topCenter
      .children
      (cond->
        [(mgl/MongolListTile
          .leading (m/Container
                    .width 34.0
                    .height 34.0
                    .decoration (m/BoxDecoration
                                 .color (if selected? (theme/sky-light) m.Colors/transparent)
                                 .shape m.BoxShape/circle)
                    .child (m/Icon icon
                                   .size 19.0
                                   .color (if selected? (theme/sky) (theme/ink-muted))))
          .title (m/Padding
                  .padding (m.EdgeInsets/only .top 6.0)
                  .child
                  (mgl/MongolText label
                                  .style (m/TextStyle .fontFamily font-family
                                                      .fontSize 17.0
                                                      .height 1.4
                                                      .fontWeight (if selected?
                                                                    m/FontWeight.w700
                                                                    m/FontWeight.normal)
                                                      .color (if selected? (theme/ink) (theme/ink-muted)))))
          .selected selected?
          .onTap (fn []
                   (mail/select-mailbox! key)
                   (.pop (m/Navigator.of ctx))
                   nil))]
        selected?
        (conj (m/Positioned
               .top 0.0
               .left 16.0
               .right 16.0
               .child (m/Container
                       .height 3.5
                       .decoration (m/BoxDecoration
                                    .color (theme/sky)
                                    .borderRadius (m/BorderRadius.vertical
                                                   .bottom (m.Radius/circular 3.0)))))))))))

(defn- avatar-letter [display-name]
  (let [s (or display-name "")]
    (if (pos? (.-length s))
      (.substring s 0 1)
      "M")))

(defn drawer [ctx]
  (f/widget
   :watch [{:keys [accounts current-account-id selected-mailbox]} store/app-state]
   (let [current-acc
         (or (some #(when (= (.-id ^mc/MailAccountDto %) current-account-id) %) accounts)
             (first accounts))
         display-name (when current-acc (.-displayName ^mc/MailAccountDto current-acc))
         email (when current-acc (.-email ^mc/MailAccountDto current-acc))
         folder-tiles
         [(folder-item (i18n/t :inbox) m.Icons/inbox_outlined :inbox selected-mailbox ctx)
          (folder-item (i18n/t :sent) m.Icons/send_outlined :sent selected-mailbox ctx)
          (folder-item (i18n/t :draft) m.Icons/drafts_outlined :draft selected-mailbox ctx)
          (folder-item (i18n/t :outbox) m.Icons/outbox :outbox selected-mailbox ctx)
          (folder-item (i18n/t :archive) m.Icons/archive_outlined :archive selected-mailbox ctx)
          (folder-item (i18n/t :junk) m.Icons/report_outlined :junk selected-mailbox ctx)
          (folder-item (i18n/t :trash) m.Icons/delete_outline :trash selected-mailbox ctx)
          (m/Container
           .width 1.0
           .margin (m.EdgeInsets/symmetric .vertical 24.0 .horizontal 10.0)
           .color (theme/divider))
          (m/Container
           .width 74.0
           .margin (m.EdgeInsets/symmetric .horizontal 5.0 .vertical 12.0)
           .child
           (mgl/MongolListTile
            .leading (m/Icon m.Icons/settings_outlined .size 20.0 .color (theme/ink-muted))
            .title (mgl/MongolText (i18n/t :settings)
                                   .style (m/TextStyle .fontFamily font-family
                                                       .fontSize 17.0
                                                       .height 1.4
                                                       .color (theme/ink-muted)))
            .onTap (fn []
                     (.pop (m/Navigator.of ctx))
                     (.pushNamed (m/Navigator.of ctx) "/settings")
                     nil)))]]
     (m/Drawer
      .backgroundColor (theme/paper)
      .child
      (m/Column
       .crossAxisAlignment m.CrossAxisAlignment/stretch
       .children
       [(m/Container
         .padding (m.EdgeInsets/fromLTRB 20.0 52.0 20.0 20.0)
         .decoration (m/BoxDecoration
                      .gradient (m/LinearGradient
                                 .begin m.Alignment/topLeft
                                 .end m.Alignment/bottomRight
                                 .colors [(theme/sky) (theme/sky-deep)]))
         .child
         (m/Row
          .children
          [(m/CircleAvatar
            .radius 26.0
            .backgroundColor m.Colors/white
            .child (m/Text (avatar-letter (or display-name email))
                           .style (m/TextStyle .fontSize 20.0
                                               .fontWeight m/FontWeight.w700
                                               .color (theme/sky))))
           (m/SizedBox .width 14.0)
           (m/Expanded
            .child
            (m/Column
             .crossAxisAlignment m.CrossAxisAlignment/start
             .mainAxisSize m.MainAxisSize/min
             .children
             [(m/Text (or display-name email "MGL Mail")
                      .maxLines 1
                      .overflow m.TextOverflow/ellipsis
                      .style (m/TextStyle .fontSize 16.0
                                          .fontWeight m/FontWeight.w600
                                          .color m.Colors/white))
              (m/SizedBox .height 4.0)
              (m/Text (or email "")
                      .maxLines 1
                      .overflow m.TextOverflow/ellipsis
                      .style (m/TextStyle .fontSize 12.0
                                          .color (.withOpacity m.Colors/white 0.85)))]))]))
        (m/Expanded
         .child
         (m/ListView
          .scrollDirection m.Axis/horizontal
          .padding (m.EdgeInsets/symmetric .horizontal 10.0)
          .children folder-tiles))])))))
