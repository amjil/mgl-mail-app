(ns mail-app.mobile.widgets.maillist
  "Mobile specific horizontally scrolling mail list with vertical swipe actions and bulk selection."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [components.slide :as slide]
            [mail-app.shared.toast :as toast]
            [mail-app.shared.utils.format :as fmt]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- format-date [^DateTime d]
  (when d (str (fmt/pad2 (.month d)) "/" (fmt/pad2 (.day d)))))

(defn- subject-of [^mc/MailMessageDto msg]
  (let [s (.-subject msg)]
    (if (or (nil? s) (empty? s)) "No Subject" s)))

(defn- sender-subtitle [^mc/MailMessageDto msg]
  (let [name (or (.-fromName msg) "")
        addr (or (.-from msg) "")]
    (cond
      (and (seq name) (seq addr)
           (not= name addr))
      (str name "\n" addr)
      (seq name) name
      :else addr)))

(defn- sender-initial [^mc/MailMessageDto msg]
  (let [s (or (.-fromName msg) (.-from msg) "")]
    (if (pos? (.-length s))
      (.substring s 0 1)
      "?")))

(defn empty-state [icon label]
  (m/Center
   .child (m/Row
           .mainAxisSize m.MainAxisSize/min
           .crossAxisAlignment m.CrossAxisAlignment/center
           .children
           [(m/Container
             .width 96.0
             .height 96.0
             .decoration (m/BoxDecoration
                          .color (theme/sky-light)
                          .shape m.BoxShape/circle
                          .boxShadow [(m/BoxShadow
                                       .color (.withOpacity (theme/sky) 0.08)
                                       .blurRadius 24.0
                                       .offset (m/Offset. 0.0 4.0))])
             .child (m/Center
                     .child (m/Icon icon .size 44.0 .color (theme/sky))))
            (m/SizedBox .width theme/space-xl)
            (mgl/MongolText label
                            .style (m/TextStyle .fontFamily font-family
                                                .color (theme/ink-muted)
                                                .fontSize theme/text-lg
                                                .fontWeight m/FontWeight.w500
                                                .height 1.5
                                                .letterSpacing 0.3))])))

(defn mail-tile
  ([navigator msg]
   (mail-tile navigator msg nil nil))
  ([navigator msg on-tap on-long-press]
   (let [^mc/MailMessageDto msg msg
         unread? (not (.-isRead msg))
         handle-tap (or on-tap
                        (fn []
                          (mail/open-message! (.-id msg))
                          (.pushNamed navigator "/mail_detail")
                          nil))]
     (mgl/MongolListTile
      .leading (m/Container
                .width 34.0
                .height 34.0
                .alignment m.Alignment/center
                .decoration (m/BoxDecoration
                             .color (if unread? (theme/sky-soft) (theme/paper-deep))
                             .shape m.BoxShape/circle)
                .child
                (m/Text (sender-initial msg)
                        .style (m/TextStyle
                                .fontSize theme/text-base
                                .fontWeight m/FontWeight.w600
                                .color (if unread? (theme/sky-deep) (theme/ink-muted))
                                .fontFamily font-family)))
      .title (m/Padding
              .padding (m.EdgeInsets/only .top theme/space-md)
              .child (mgl/MongolText
                      (subject-of msg)
                      .style (m/TextStyle .fontFamily font-family
                                          .fontSize theme/text-lg
                                          .height 1.5
                                          .letterSpacing 0.2
                                          .fontWeight (if unread? m/FontWeight.w700 m/FontWeight.normal)
                                          .color (if unread? (theme/ink) (theme/ink-muted)))))
      .subtitle (m/Column
                 .crossAxisAlignment m.CrossAxisAlignment/start
                 .mainAxisSize m.MainAxisSize/min
                 .children
                 (cond->
                   [(mgl/MongolText (sender-subtitle msg)
                                    .style (m/TextStyle .fontFamily font-family
                                                        .fontSize theme/text-base
                                                        .height 1.45
                                                        .letterSpacing 0.1
                                                        .color (if unread? (theme/ink-muted)
                                                                    (.withOpacity (theme/ink-muted) 0.8))))
                    (m/SizedBox .height theme/space-md)
                    (mgl/MongolText (or (format-date (.-date msg)) "")
                                    .style (m/TextStyle .fontSize theme/text-sm
                                                        .letterSpacing 0.1
                                                        .color (theme/ink-muted)))]
                   (.-isStarred msg)
                   (conj (m/Padding
                          .padding (m.EdgeInsets/only .top theme/space-md)
                          .child (m/Icon m.Icons/star .size 16.0 .color (theme/gold))))))
      .onTap handle-tap
      .onLongPress on-long-press))))

(defn result-item [^mc/MailSearchResultDto hit]
  (f/widget
   :get [m/Navigator]
   (m/Container
    .width 152.0
    .margin (m.EdgeInsets/symmetric .horizontal theme/space-xs)
    .padding (m.EdgeInsets/symmetric .horizontal theme/space-md .vertical theme/space-lg)
    .decoration (m/BoxDecoration
                 .color (theme/surface)
                 .borderRadius (m/BorderRadius.circular theme/radius-md)
                 .border (m/Border.all .color (theme/divider) .width 0.5)
                 .boxShadow (theme/hair-shadow))
    .child
    (mgl/MongolListTile
     .title (m/Padding
             .padding (m.EdgeInsets/only .top theme/space-md)
             .child
             (mgl/MongolText
              (let [s (.-subject hit)]
                (if (or (nil? s) (empty? s)) "No Subject" s))
              .style (m/TextStyle .fontFamily font-family
                                  .fontSize theme/text-lg
                                  .height 1.5
                                  .letterSpacing 0.2
                                  .fontWeight m/FontWeight.w700
                                  .color (theme/ink))))
     .subtitle (m/Padding
                .padding (m.EdgeInsets/only .top theme/space-md)
                .child
                (mgl/MongolText
                 (or (.-snippet hit) "")
                 .style (m/TextStyle .fontFamily font-family
                                     .fontSize theme/text-base
                                     .height 1.45
                                     .letterSpacing 0.1
                                     .color (theme/ink-muted))))
     .onTap (fn []
              (mail/open-message! (.-messageId hit))
              (.pushNamed navigator "/mail_detail")
              nil)))))

;; ==========================================
;; Single mail item (vertical swipe + long-press multi-select)
;; ==========================================
(defn- mail-item [ctx navigator msg]
  (f/widget
   :watch [{:keys [selected-message-ids]} store/app-state]
   (let [^mc/MailMessageDto msg msg
         mid (.-id msg)
         unread? (not (.-isRead msg))
         in-selection-mode? (seq selected-message-ids)
         selected? (contains? selected-message-ids mid)]
     (slide/item
      {:id mid
       :top-actions
       [{:icon m.Icons/archive_outlined
         :color m.Colors/green
         :label "Архив"
         :on-pressed (fn []
                       (mail/archive-message! mid)
                       (toast/success! (toast/safe-ctx ctx) "Archived"))}]
       :on-dismiss-top
       (fn []
         (mail/archive-message! mid)
         (toast/success! (toast/safe-ctx ctx) "Archived"))
       :bottom-actions
       [{:icon m.Icons/delete_outline
         :color m.Colors/red
         :label "Устгах"
         :on-pressed (fn []
                       (mail/delete-message! mid)
                       (toast/success! (toast/safe-ctx ctx) "Deleted"))}]
       :on-dismiss-bottom
       (fn []
         (mail/delete-message! mid)
         (toast/success! (toast/safe-ctx ctx) "Deleted"))
       :child
       (let [tile (mail-tile
                   navigator msg
                   (fn []
                     (if in-selection-mode?
                       (store/toggle-message-selection! mid)
                       (do
                         (mail/open-message! mid)
                         (.pushNamed navigator "/mail_detail")
                         nil)))
                   (fn []
                     (when-not (contains? selected-message-ids mid)
                       (store/toggle-message-selection! mid))
                     nil))]
         (m/Container
          .width 152.0
          .margin (m.EdgeInsets/symmetric .horizontal theme/space-xs)
          .decoration (m/BoxDecoration
                       .color (if selected? (theme/sky-soft) (theme/surface))
                       .borderRadius (m/BorderRadius.circular theme/radius-md)
                       .border (m/Border.all
                                .color (if selected? (theme/sky) (theme/divider))
                                .width (if selected? 1.5 0.5))
                       .boxShadow (if selected? 
                                    (theme/card-shadow) 
                                    (theme/hair-shadow)))
          .child
          (m/ClipRRect
           .borderRadius (m/BorderRadius.circular theme/radius-md)
           .child
           (m/Stack
            .children
            (cond-> [tile]
              unread?
              (conj (m/Positioned
                     .left 0.0
                     .top theme/space-md
                     .bottom theme/space-md
                     .child (m/Container
                             .width 3.5
                             .decoration (m/BoxDecoration
                                          .color (theme/sky)
                                          .borderRadius (m/BorderRadius.circular 2.0)
                                          .boxShadow [(m/BoxShadow
                                                       .color (.withOpacity (theme/sky) 0.3)
                                                       .blurRadius 4.0
                                                       .spreadRadius 1.0)]))))
              in-selection-mode?
              (conj (m/Positioned
                     .top theme/space-md
                     .right theme/space-md
                     .child (m/Container
                             .padding (m.EdgeInsets/all 2.0)
                             .decoration (when selected?
                                           (m/BoxDecoration
                                            .color (theme/surface)
                                            .shape m.BoxShape/circle))
                             .child
                             (m/Icon (if selected?
                                       m.Icons/check_circle
                                       m.Icons/radio_button_unchecked)
                                     .color (if selected? (theme/sky) (theme/ink-muted))
                                     .size 24.0)))))))))}))))

;; ==========================================
;; Horizontally scrolling mail list with infinite loading
;; ==========================================
(defn- make-scroll-resource []
  (let [ctrl (m/ScrollController.)
        listener
        (fn []
          (when (.-hasClients ctrl)
            (let [pos (.-position ctrl)]
              (when (>= (.-pixels pos)
                        (- (.-maxScrollExtent pos) 150.0))
                (mail/load-more!)))))]
    (.addListener ctrl listener)
    {:controller ctrl :listener listener}))

(defn- dispose-scroll-resource! [{:keys [controller listener]}]
  (.removeListener ^m/ScrollController controller listener)
  (.dispose ^m/ScrollController controller)
  nil)

(defn list-view []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :managed [scroll-resource (make-scroll-resource)
             :dispose dispose-scroll-resource!]
   :watch [{:keys [mail-list loading-more?]} store/app-state]
   (let [scroll-ctrl (:controller scroll-resource)]
     (if (empty? mail-list)
       (empty-state m.Icons/inbox_outlined "Хоосон байна")
       (m/ListView.separated
        .controller scroll-ctrl
        .scrollDirection m.Axis/horizontal
        .padding (m.EdgeInsets/symmetric .horizontal theme/space-md .vertical theme/space-md)
        .itemCount (if loading-more?
                     (inc (count mail-list))
                     (count mail-list))
        .separatorBuilder (fn [_ _] (m/SizedBox .width theme/space-xs))
        .itemBuilder (fn [_ idx]
                       (if (= idx (count mail-list))
                         (m/Container
                          .width 80.0
                          .alignment m.Alignment/center
                          .child 
                          (m/Column
                           .mainAxisSize m.MainAxisSize/min
                           .children
                           [(m/CircularProgressIndicator.
                             .strokeWidth 2.5
                             .color (theme/sky))
                            (m/SizedBox .height theme/space-md)
                            (m/Text "Loading..."
                                    .style (m/TextStyle
                                            .fontSize theme/text-xs
                                            .color (theme/ink-muted)))]))
                         (mail-item ctx navigator
                                    (nth mail-list idx)))))))))
