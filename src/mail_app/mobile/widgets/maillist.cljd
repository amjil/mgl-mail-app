(ns mail-app.mobile.widgets.maillist
  "Mobile specific horizontally scrolling mail list with vertical swipe actions and bulk selection."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [components.slide :as slide]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- pad2 [n] (.padLeft (.toString n) 2 "0"))

(defn- format-date [^DateTime d]
  (when d (str (pad2 (.month d)) "/" (pad2 (.day d)))))

(defn- subject-of [^mc/MailMessageDto msg]
  (let [s (.-subject msg)]
    (if (or (nil? s) (empty? s)) "No Subject" s)))

(defn- sender-initial [^mc/MailMessageDto msg]
  (let [s (or (.-fromName msg) (.-from msg) "")]
    (if (pos? (.-length s))
      (.substring s 0 1)
      "?")))

(defn empty-state [icon label]
  (m/Center
   .child (m/Row
           .mainAxisSize m.MainAxisSize/min
           .children
           [(m/Container
             .width 88.0
             .height 88.0
             .decoration (m/BoxDecoration
                          .color theme/sky-light
                          .shape m.BoxShape/circle)
             .child (m/Center
                     .child (m/Icon icon .size 40.0 .color theme/sky)))
            (m/SizedBox .width 20.0)
            (mgl/MongolText label
                            .style (m/TextStyle .fontFamily font-family
                                                .color theme/ink-muted
                                                .fontSize 18.0
                                                .height 1.4))])))

(defn mail-tile
  ([navigator msg]
   (mail-tile navigator msg nil nil))
  ([navigator msg on-tap on-long-press]
   (let [^mc/MailMessageDto msg msg
         unread? (not (.-isRead msg))
         handle-tap (or on-tap
                        (fn []
                          (mail/open-message! (.-id msg))
                          (.pushNamed navigator "/mail_detail")
                          nil))]
     (mgl/MongolListTile
      .leading (m/Container
                .width 28.0
                .height 28.0
                .alignment m.Alignment/center
                .decoration (m/BoxDecoration
                             .color (if unread? theme/sky-soft theme/paper-deep)
                             .shape m.BoxShape/circle)
                .child
                (m/Text (sender-initial msg)
                        .style (m/TextStyle
                                .fontSize 13.0
                                .fontWeight m/FontWeight.w600
                                .color (if unread? theme/sky-deep theme/ink-muted)
                                .fontFamily font-family)))
      .title (m/Padding
              .padding (m.EdgeInsets/only .top 8.0)
              .child (mgl/MongolText
                      (subject-of msg)
                      .style (m/TextStyle .fontFamily font-family
                                          .fontSize 18.0
                                          .height 1.4
                                          .fontWeight (if unread? m/FontWeight.w700 m/FontWeight.normal)
                                          .color (if unread? theme/ink theme/ink-muted))))
      .subtitle (m/Column
                 .crossAxisAlignment m.CrossAxisAlignment/start
                 .mainAxisSize m.MainAxisSize/min
                 .children
                 (cond->
                   [(mgl/MongolText (or (.-fromName msg) (.-from msg) "")
                                    .style (m/TextStyle .fontFamily font-family
                                                        .fontSize 14.0
                                                        .height 1.35
                                                        .color (if unread? theme/ink-muted
                                                                    (.withOpacity theme/ink-muted 0.8))))
                    (m/SizedBox .height 8.0)
                    (mgl/MongolText (or (format-date (.-date msg)) "")
                                    .style (m/TextStyle .fontSize 12.0
                                                        .color theme/ink-muted))]
                   (.-isStarred msg)
                   (conj (m/Padding
                          .padding (m.EdgeInsets/only .top 8.0)
                          .child (m/Icon m.Icons/star .size 14.0 .color theme/gold)))))
      .onTap handle-tap
      .onLongPress on-long-press))))

(defn result-item [^mc/MailSearchResultDto hit]
  (f/widget
   :get [m/Navigator]
   (m/Container
    .width 148.0
    .margin (m.EdgeInsets/symmetric .horizontal 4.0)
    .decoration (m/BoxDecoration
                 .color theme/surface
                 .borderRadius (m/BorderRadius.circular theme/radius-md)
                 .border (m/Border.all .color theme/divider .width 0.5)
                 .boxShadow (theme/hair-shadow))
    .child
    (mgl/MongolListTile
     .title (m/Padding
             .padding (m.EdgeInsets/only .top 8.0)
             .child
             (mgl/MongolText
              (let [s (.-subject hit)]
                (if (or (nil? s) (empty? s)) "No Subject" s))
              .style (m/TextStyle .fontFamily font-family
                                  .fontSize 18.0
                                  .height 1.4
                                  .fontWeight m/FontWeight.w700
                                  .color theme/ink)))
     .subtitle (m/Padding
                .padding (m.EdgeInsets/only .top 8.0)
                .child
                (mgl/MongolText
                 (or (.-snippet hit) "")
                 .style (m/TextStyle .fontFamily font-family
                                     .fontSize 14.0
                                     .height 1.35
                                     .color theme/ink-muted)))
     .onTap (fn []
              (mail/open-message! (.-messageId hit))
              (.pushNamed navigator "/mail_detail")
              nil)))))

;; ==========================================
;; Single mail item (vertical swipe + long-press multi-select)
;; ==========================================
(defn- mail-item [ctx navigator msg !selected-ids]
  (f/widget
   :watch [selected-ids !selected-ids]
   (let [^mc/MailMessageDto msg msg
         mid (.-id msg)
         unread? (not (.-isRead msg))
         in-selection-mode? (seq selected-ids)
         selected? (contains? selected-ids mid)]
     (slide/item
      {:id mid
       :top-actions
       [{:icon m.Icons/archive_outlined
         :color m.Colors/green
         :label "Архив"
         :on-pressed (fn []
                       (mail/archive-message! mid)
                       (toast/success! (toast/safe-ctx ctx) "Archived"))}]
       :on-dismiss-top
       (fn []
         (mail/archive-message! mid)
         (toast/success! (toast/safe-ctx ctx) "Archived"))
       :bottom-actions
       [{:icon m.Icons/delete_outline
         :color m.Colors/red
         :label "Устгах"
         :on-pressed (fn []
                       (mail/delete-message! mid)
                       (toast/success! (toast/safe-ctx ctx) "Deleted"))}]
       :on-dismiss-bottom
       (fn []
         (mail/delete-message! mid)
         (toast/success! (toast/safe-ctx ctx) "Deleted"))
       :child
       (let [tile (mail-tile
                   navigator msg
                   (fn []
                     (if in-selection-mode?
                       (if selected?
                         (swap! !selected-ids disj mid)
                         (swap! !selected-ids conj mid))
                       (do
                         (mail/open-message! mid)
                         (.pushNamed navigator "/mail_detail")
                         nil)))
                   (fn []
                     (swap! !selected-ids conj mid)
                     nil))]
         (m/Container
          .width 148.0
          .margin (m.EdgeInsets/symmetric .horizontal 4.0)
          .decoration (m/BoxDecoration
                       .color (if selected? theme/sky-soft theme/surface)
                       .borderRadius (m/BorderRadius.circular theme/radius-md)
                       .border (m/Border.all
                                .color (if selected? theme/sky theme/divider)
                                .width (if selected? 1.5 0.5))
                       .boxShadow (theme/hair-shadow))
          .child
          (m/ClipRRect
           .borderRadius (m/BorderRadius.circular theme/radius-md)
           .child
           (m/Stack
            .children
            (cond-> [tile]
              unread?
              (conj (m/Positioned
                     .left 0.0
                     .top 12.0
                     .bottom 12.0
                     .child (m/Container
                             .width 3.0
                             .decoration (m/BoxDecoration
                                          .color theme/sky
                                          .borderRadius (m/BorderRadius.circular 2.0)))))
              in-selection-mode?
              (conj (m/Positioned
                     .top 10.0
                     .right 10.0
                     .child (m/Icon (if selected?
                                      m.Icons/check_circle
                                      m.Icons/radio_button_unchecked)
                                    .color (if selected? theme/sky theme/ink-muted)
                                    .size 22.0))))))))}))))

;; ==========================================
;; Horizontally scrolling mail list
;; ==========================================
(defn list-view [!selected-ids]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [mail-list]} store/app-state]
   (if (empty? mail-list)
     (empty-state m.Icons/inbox_outlined "Хоосон байна")
     (m/ListView.separated
      .scrollDirection m.Axis/horizontal
      .padding (m.EdgeInsets/symmetric .horizontal 12.0 .vertical 12.0)
      .itemCount (count mail-list)
      .separatorBuilder (fn [_ _] (m/SizedBox .width 2.0))
      .itemBuilder (fn [_ idx]
                     (mail-item ctx navigator (nth mail-list idx) !selected-ids))))))
