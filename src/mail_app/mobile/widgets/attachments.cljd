(ns mail-app.mobile.widgets.attachments
  "Attachment list tile and bottom sheet for mail detail."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            ["package:url_launcher/url_launcher.dart" :as ul]
            [clojure.string :as str]
            [mail-app.desktop.toast :as toast]
            [mail-app.services.mail-core :as mail]
            [mail-app.theme :as theme]
            [mail-app.widgets.image-gallery :as gallery]))

(defn- open-local-path! [ctx path]
  (when (seq path)
    (-> (ul/launchUrl (dart:core/Uri.file path))
        (.catchError (fn [e]
                       (toast/error! ctx (str "Cannot open: " e))
                       nil)))))

(defn- image-attachment? [^mc/MailAttachmentDto att]
  (let [mime (str/lower-case (or (.-mimeType att) ""))
        name (str/lower-case (or (.-filename att) ""))]
    (or (str/starts-with? mime "image/")
        (str/ends-with? name ".jpg")
        (str/ends-with? name ".jpeg")
        (str/ends-with? name ".png")
        (str/ends-with? name ".gif")
        (str/ends-with? name ".webp"))))

(defn- attachment-tile
  [ctx ^mc/MailMessageWithBody detail ^mc/MailAttachmentDto att downloading?]
  (let [name (or (.-filename att) "file")
        ready? (and (.-isDownloaded att) (seq (.-localPath att)))
        is-img? (image-attachment? att)]
    (m/ListTile
     .leading (m/Icon (if is-img? m.Icons/image m.Icons/attach_file)
                      .color (theme/ink-muted))
     .title (m/Text name .style (m/TextStyle .fontSize 14.0 .color (theme/ink)))
     .subtitle (when (.-size att)
                 (m/Text (str (.-size att) " bytes")
                         .style (m/TextStyle .fontSize 12.0 .color (theme/ink-muted))))
     .trailing
     (cond
       downloading?
       (m/SizedBox
        .width 20.0 .height 20.0
        .child (m/CircularProgressIndicator. .strokeWidth 2.0 .color (theme/sky)))

       ready?
       (m/IconButton
        .icon (m/Icon (if is-img? m.Icons/visibility m.Icons/open_in_new))
        .onPressed
        (fn []
          (if is-img?
            (let [all-atts (vec (or (.-attachments detail) []))
                  img-atts (filter image-attachment? all-atts)
                  urls (mapv #(.-localPath ^mc/MailAttachmentDto %) img-atts)
                  idx (.indexOf urls (.-localPath att))]
              (gallery/open! ctx urls (max 0 idx)))
            (open-local-path! ctx (.-localPath att)))
          nil))

       :else
       (m/IconButton
        .icon (m/Icon m.Icons/download)
        .onPressed
        (fn []
          (-> (mail/download-attachment! (.-id att))
              (.then (fn [dto]
                       (toast/success! ctx "Downloaded")
                       (when (and dto (.-localPath dto))
                         (if (image-attachment? dto)
                           (gallery/open! ctx [(.-localPath dto)] 0)
                           (open-local-path! ctx (.-localPath dto))))
                       nil))
              (.catchError (fn [e]
                             (toast/error! ctx (str e))
                             nil)))
          nil))))))

(defn show-sheet! [ctx detail downloading-ids]
  (let [atts (vec (or (.-attachments ^mc/MailMessageWithBody detail) []))]
    (when (seq atts)
      (m/showModalBottomSheet
       .context ctx
       .showDragHandle true
       .backgroundColor (theme/surface)
       .builder
       (fn [sheet-ctx]
         (m/SafeArea
          .child
          (m/Column
           .mainAxisSize m.MainAxisSize/min
           .crossAxisAlignment m.CrossAxisAlignment/stretch
           .children
           (into [(m/Padding
                   .padding (m.EdgeInsets/fromLTRB 16.0 8.0 16.0 8.0)
                   .child
                   (m/Text "Attachments"
                           .style (m/TextStyle .fontWeight m/FontWeight.w600
                                               .fontSize 16.0
                                               .color (theme/ink))))]
                 (mapv (fn [^mc/MailAttachmentDto a]
                         (attachment-tile sheet-ctx detail a
                                          (contains? downloading-ids (.-id a))))
                       atts))))))
      nil)))
