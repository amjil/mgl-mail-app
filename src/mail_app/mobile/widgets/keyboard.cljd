(ns mail-app.mobile.widgets.keyboard
  "Shared in-app Mongolian virtual keyboard: IME install, candidates, bottom bar."
  (:require ["package:flutter/material.dart" :as m]
            [virtual-keyboard.input-control :as input-control]
            [virtual-keyboard.keyboard :as vk]
            [virtual-keyboard.options :as vk-options]
            [mail-app.theme :as theme]))

(def info
  (merge vk-options/keyboard-option
         {:keyboard/mongol-font-family "OyunQaganTig"
          :keyboard/key-container-color theme/ink-muted
          :keyboard/font-size 16}))

(defn install []
  (input-control/set-control)
  true)

(defn restore-ime! [_]
  (input-control/restore-control)
  nil)

(defn candidates []
  (vk/candidates nil))

(defn bar []
  (m/Container
   .decoration (m/BoxDecoration
                .color theme/paper
                .border (m/Border .top (m/BorderSide .color theme/divider .width 1.0)))
   .child (vk/keyboard {})))
