(ns mail-app.mobile.screens.home
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [mail-app.shared.toast :as toast]
            [mail-app.shared.i18n :as i18n]
            [mail-app.mobile.screens.signup :as signup]
            [mail-app.mobile.widgets.drawer :as drawer]
            [mail-app.mobile.widgets.error-banner :as err]
            [mail-app.mobile.widgets.maillist :as mobile-list]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- bulk-then! [ctx f success-msg]
  (when-let [result (f)]
    (-> result
        (.then (fn [ok]
                 (when ok
                   (toast/success! (toast/safe-ctx ctx) success-msg))
                 nil))
        (.catchError (fn [_] nil))))
  nil)

(defn screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [accounts selected-mailbox syncing? current-account-id
                   selected-message-ids]}
           store/app-state]
   (if (empty? accounts)
     (signup/screen)
     (do
       (when (and (or current-account-id (seq accounts))
                  (nil? selected-mailbox))
         (async/Future.microtask
          #(mail/select-mailbox! :inbox)))
       (let [in-selection-mode? (seq selected-message-ids)
             sync-action
             (if syncing?
               (m/Padding
                .padding (m.EdgeInsets/all 16.0)
                .child
                (m/SizedBox
                 .width 22.0
                 .height 22.0
                 .child (m/CircularProgressIndicator
                         .strokeWidth 2.0
                         .color (theme/sky))))
               (m/IconButton
                .icon (m/Icon m.Icons/sync)
                .tooltip (i18n/t :auto-sync)
                .onPressed #(mail/sync!)))]
         (m/Scaffold
          .backgroundColor (theme/paper)
          .drawer (when-not in-selection-mode? (drawer/drawer ctx))
          .appBar
          (if in-selection-mode?
            (m/AppBar
             .backgroundColor (theme/sky-light)
             .foregroundColor (theme/sky-deep)
             .elevation 0.0
             .scrolledUnderElevation 0.0
             .leading (m/IconButton
                       .icon (m/Icon m.Icons/close .color (theme/sky-deep))
                       .onPressed (fn []
                                    (store/clear-message-selection!)
                                    nil))
             .title (m/Text (str (count selected-message-ids))
                            .style (m/TextStyle .fontFamily font-family
                                                .fontWeight m/FontWeight.w600
                                                .color (theme/sky-deep)))
             .actions
             [(m/IconButton
               .icon (m/Icon m.Icons/archive_outlined .color (theme/sky-deep))
               .tooltip (i18n/t :archive)
               .onPressed (fn []
                            (bulk-then! ctx mail/bulk-archive! (i18n/t :archive))
                            nil))
              (m/IconButton
               .icon (m/Icon m.Icons/delete_outline .color (theme/danger))
               .tooltip (i18n/t :delete)
               .onPressed (fn []
                            (bulk-then! ctx mail/bulk-delete! (i18n/t :delete))
                            nil))])
            (m/AppBar
             .title (m/SizedBox.shrink)
             .actions
             [(m/IconButton
               .icon (m/Icon m.Icons/search)
               .tooltip (i18n/t :search-hint)
               .onPressed (fn []
                            (.pushNamed (m/Navigator.of ctx) "/search")
                            nil))
              sync-action]))
          .body (m/Column
                 .crossAxisAlignment m.CrossAxisAlignment/stretch
                 .children
                 [(err/banner)
                  (m/Expanded
                   .child
                   (m/Row
                    .crossAxisAlignment m.CrossAxisAlignment/stretch
                    .children
                    [;; Left: vertical Mongolian mailbox label
                     (m/Container
                      .width 42.0
                      .padding (m.EdgeInsets/symmetric .vertical 16.0)
                      .decoration (m/BoxDecoration
                                   .color (theme/paper-deep)
                                   .border (m/Border
                                            .right (m/BorderSide .color (theme/divider) .width 0.8)))
                      .child
                      (m/Column
                       .children
                       [(m/Container
                         .width 6.0 .height 6.0
                         .decoration (m/BoxDecoration .color (theme/sky) .shape m.BoxShape/circle))
                        (m/SizedBox .height 12.0)
                        (m/Expanded
                         .child
                         (mgl/MongolText
                          (i18n/mailbox-label selected-mailbox (i18n/t :app-title))
                          .style (m/TextStyle .fontFamily font-family
                                              .fontSize 18.0
                                              .fontWeight m/FontWeight.w700
                                              .color (theme/ink))))]))
                     ;; Right: infinite-scroll mail list with swipe-to-refresh
                     (m/Expanded .child (mobile-list/list-view))]))])
          .floatingActionButton
          (when-not in-selection-mode?
            (m/FloatingActionButton
             .tooltip (i18n/t :compose)
             .child (m/Icon m.Icons/edit_outlined)
             .onPressed (fn []
                          (store/clear-compose-draft!)
                          (.pushNamed navigator "/compose")
                          nil)))))))))
