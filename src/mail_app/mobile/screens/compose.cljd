(ns mail-app.mobile.screens.compose
  "Mobile compose: App bar actions, horizontal scrolling header fields,
   and Mongol block editor with the in-app virtual keyboard."
  (:require ["package:flutter/material.dart" :as m]
            ["package:file_selector/file_selector.dart" :as fs]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [block-editor.widgets.editor :as editor]
            [mail-app.desktop.widgets.compose-fields :as fields]
            [mail-app.desktop.widgets.compose-quote :as quote]
            [mail-app.desktop.widgets.compose-topbar :as topbar]
            [mail-app.mobile.widgets.keyboard :as kb]
            [mail-app.services.compose-screen :as compose]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme :refer [font-family]]))

(defn- pick-attachments! [!paths]
  (-> (fs/openFiles)
      (.then (fn [files]
               (let [new-paths (->> (or files [])
                                    (map #(.-path ^fs/XFile %))
                                    (remove empty?)
                                    vec)]
                 (when (seq new-paths)
                   (swap! !paths #(vec (distinct (concat % new-paths))))))
               nil))
      (.catchError (fn [_] nil))))

(defn- cancel-timer! [^async/Timer t]
  (when t (.cancel t))
  nil)

(defn screen []
  (let [{:keys [has-quote? !doc-state !quote-state !show-cc? !show-bcc?
                !attachment-paths !fields-draft !draft-meta !auto-save-gate]}
        (compose/prepare-state!)
        !last-snapshot (atom nil)
        editor-config (compose/editor-config :mobile)]
    (f/widget
     :managed [scaffold-key (m/GlobalKey)
               :dispose nil
               ime-control (kb/install)
               :dispose kb/restore-ime!
               to-ctrl (m/TextEditingController.)
               to-focus (m/FocusNode.)
               cc-ctrl (m/TextEditingController.)
               cc-focus (m/FocusNode.)
               bcc-ctrl (m/TextEditingController.)
               bcc-focus (m/FocusNode.)
               subject-ctrl (m/TextEditingController.)
               subject-focus (m/FocusNode.)
               auto-save-timer
               (async/Timer.periodic
                (dart:core/Duration. .seconds 5)
                (compose/periodic-auto-save-callback
                 to-ctrl cc-ctrl bcc-ctrl subject-ctrl !doc-state !attachment-paths
                 !last-snapshot !show-cc? !show-bcc? !quote-state !draft-meta
                 !auto-save-gate))
               :dispose cancel-timer!]
     :let [vk-info kb/info]
     :bind {:info vk-info}
     :context ctx
     :get [m/Navigator]
     :watch [show-cc? !show-cc?
             show-bcc? !show-bcc?
             {:keys [sending? current-account-id]} store/app-state
             attachment-paths !attachment-paths]

     (let [screen-w (.-width (.-size (m/MediaQuery.of ctx)))]
       (do
         (compose/apply-pending-fields! !fields-draft to-ctrl cc-ctrl bcc-ctrl
                                        subject-ctrl !show-cc? !show-bcc?)

         (m/Scaffold
          .key scaffold-key
          .backgroundColor theme/paper
          .resizeToAvoidBottomInset false
          .endDrawer
          (when has-quote?
            (m/Drawer
             .backgroundColor theme/paper
             .child
             (m/SafeArea
              .child
              (quote/panel !quote-state :toggle? false))))
          .appBar (m/AppBar
                   .title (m/Text "Compose" .style (m/TextStyle .fontFamily font-family
                                                               .fontWeight m/FontWeight.w600
                                                               .color theme/ink))
                   .actions
                   (cond-> []
                     has-quote?
                     (conj (m/IconButton
                            .icon (m/Icon m.Icons/format_quote)
                            .tooltip "Original Email"
                            .onPressed (fn [] (-> scaffold-key .-currentState .openEndDrawer) nil)))

                     true
                     (conj (m/IconButton
                            .icon (m/Icon m.Icons/save_outlined)
                            .tooltip "Save Draft"
                            .onPressed (fn []
                                         (topbar/save-draft-pressed!
                                          ctx navigator !doc-state !quote-state
                                          to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                          show-cc? show-bcc? sending?
                                          current-account-id attachment-paths
                                          @!draft-meta)
                                         nil)))

                     true
                     (conj (m/IconButton
                            .icon (m/Icon m.Icons/attach_file)
                            .tooltip "Attach"
                            .onPressed #(pick-attachments! !attachment-paths)))

                     true
                     (conj (m/IconButton
                            .icon (m/Icon m.Icons/more_vert)
                            .tooltip "Options"
                            .onPressed (fn []
                                         (swap! !show-cc? not)
                                         nil)))

                     sending?
                     (conj (m/Padding
                            .padding (m.EdgeInsets/all 16.0)
                            .child
                            (m/SizedBox .width 20.0 .height 20.0
                                        .child (m/CircularProgressIndicator .strokeWidth 2.0 .color theme/sky))))

                     (not sending?)
                     (conj (m/IconButton
                            .icon (m/Icon m.Icons/send .color theme/sky)
                            .tooltip "Send"
                            .onPressed (fn []
                                         (topbar/send-pressed! ctx navigator !doc-state !quote-state
                                                               to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                                               show-cc? show-bcc? sending?
                                                               current-account-id attachment-paths
                                                               @!draft-meta)
                                         nil)))))
          .body
          (m/SafeArea
           .child
           (m/Column
            .crossAxisAlignment m.CrossAxisAlignment/stretch
            .children
            (cond-> []
              (seq attachment-paths)
              (conj
               (m/Padding
                .padding (m.EdgeInsets/all 8.0)
                .child
                (m/Wrap
                 .spacing 6.0 .runSpacing 4.0
                 .children
                 (mapv (fn [path]
                         (m/InputChip
                          .backgroundColor theme/sky-light
                          .side (m/BorderSide .color theme/sky-soft)
                          .label (m/Text (compose/basename path)
                                         .style (m/TextStyle .fontSize 12.0 .color theme/ink))
                          .onDeleted (fn [] (swap! !attachment-paths #(vec (remove #{path} %))) nil)))
                       attachment-paths))))

              true
              (conj
               (m/Expanded
                .child
                (m/Stack
                 .children
                 [(m/SingleChildScrollView
                   .scrollDirection m.Axis/horizontal
                   .child
                   (m/Row
                    .crossAxisAlignment m.CrossAxisAlignment/stretch
                    .children
                    [(fields/header-row
                      {:!ime !doc-state
                       :to-ctrl to-ctrl :to-focus to-focus
                       :cc-ctrl cc-ctrl :cc-focus cc-focus
                       :bcc-ctrl bcc-ctrl :bcc-focus bcc-focus
                       :subject-ctrl subject-ctrl :subject-focus subject-focus
                       :show-cc? show-cc?
                       :show-bcc? show-bcc?})
                     (m/VerticalDivider .width 1.0 .thickness 1.0 .color theme/divider)
                     (m/Container
                      .width screen-w
                      .child
                      (editor/mongol-block-editor
                       !doc-state
                       :editor-config editor-config
                       :background-color theme/surface
                       :show-block-handles? false
                       :wrap-ime? false
                       :padding (m.EdgeInsets/all 16.0)))]))
                  (kb/candidates)])))
              true
              (conj (compose/bottom-toolbar !doc-state editor-config))
              true
              (conj (kb/bar)))))))))))
