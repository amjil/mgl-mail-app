(ns mail-app.mobile.screens.mail-detail
  "Mobile mail detail: Header, body, and quotes share one horizontal scroll,
   with AppBar actions for reply/forward/move/delete."
  (:require ["package:flutter/material.dart" :as m]
            ["package:mongol/mongol.dart" :as mgl]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            ["dart:async" :as async]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [components.bottom-sheet :as bottom-sheet]
            [components.dialog :as dialog]
            [mail-app.desktop.toast :as toast]
            [mail-app.mobile.widgets.attachments :as attachments]
            [mail-app.mobile.widgets.mail-body :as mail-body]
            [mail-app.services.compose-export :as export]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :refer [font-family]]))

(defn- pad2 [n] (.padLeft (.toString n) 2 "0"))

(defn- format-date [d]
  (when d
    (let [^DateTime dt d]
      (str (.year dt) "-" (pad2 (.month dt)) "-" (pad2 (.day dt)) " "
           (pad2 (.hour dt)) ":" (pad2 (.minute dt))))))

(defn- body-text [^mc/MailMessageWithBody detail]
  (let [body (.-body detail)]
    (cond
      (nil? body) ""
      (seq (.-plainText body)) (.-plainText body)
      (seq (.-html body)) (mail/html->plain (.-html body))
      :else "")))

(defn- ensure-prefix [subject prefix]
  (let [s (or subject "")]
    (if (str/starts-with? (str/lower-case s) (str/lower-case prefix)) s (str prefix s))))

(defn- build-references [^mc/MailMessageDto msg]
  (let [mid (.-rfcMessageId msg)
        prev (.-referencesHeader msg)]
    (cond
      (and (seq prev) (seq mid)) (str prev " " mid)
      (seq mid) mid
      (seq prev) prev
      :else nil)))

(defn- execute-with-loading!
  "Shows a non-dismissible loading dialog, executes the action-thunk,
   refreshes the current mailbox, and pops back to the list screen."
  [ctx navigator action-thunk success-msg]
  (let [tctx (toast/safe-ctx ctx)]
    (m/showDialog
     .context ctx
     .barrierDismissible false
     .builder
     (fn [_]
       (m/PopScope
        .canPop false
        .child
        (m/Center
         .child
         (m/Material
          .color m.Colors/transparent
          .child
          (m/Container
           .padding (m.EdgeInsets/all 24.0)
           .decoration (m/BoxDecoration .color m.Colors/white .borderRadius (m.BorderRadius/circular 12.0))
           .child (m/Column
                   .mainAxisSize m.MainAxisSize/min
                   .children [(m/CircularProgressIndicator.)
                              (m/SizedBox .height 16.0)
                              (mgl/MongolText "Зөөж байна..."
                                              .style (m/TextStyle .fontFamily font-family
                                                                  .fontSize 16.0
                                                                  .color m.Colors/black87))])))))))
    (async/Future.delayed
     (dart:core/Duration. .milliseconds 500)
     (fn []
       (try
         (-> (action-thunk)
             (.then (fn [ok]
                      (.pop navigator)
                      (if ok
                        (do
                          (toast/success! tctx success-msg)
                          (when-let [box (:selected-mailbox @store/app-state)]
                            (mail/select-mailbox! box))
                          (when (.canPop navigator) (.pop navigator))
                          nil)
                        (toast/error! tctx (or (:last-error @store/app-state) "Operation failed")))))
             (.catchError (fn [e]
                            (.pop navigator)
                            (toast/error! tctx (str e))
                            nil)))
         (catch dart:core/Object e
           (.pop navigator)
           (toast/error! tctx (str "Error: " e))))))
    nil))

(defn- start-reply! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        from (or (.-from msg) "")
        subject (ensure-prefix (.-subject msg) "Re: ")
        text (body-text detail)
        date (format-date (.-date msg))
        mid (.-rfcMessageId msg)]
    (store/set-compose-draft!
     {:to from :subject subject :in-reply-to mid :references (build-references msg)
      :quote-state (export/quote-toggle-state from date text)})
    (.pushNamed navigator "/compose")
    nil))

(defn- start-forward! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        from (or (.-fromName msg) (.-from msg) "")
        subject (ensure-prefix (.-subject msg) "Fwd: ")
        text (body-text detail)
        date (format-date (.-date msg))]
    (store/set-compose-draft!
     {:to "" :subject subject :quote-state (export/quote-toggle-state from date text)})
    (.pushNamed navigator "/compose")
    nil))

(defn- start-edit-draft! [navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)]
    (-> (mail/edit-draft! (.-id msg))
        (.then (fn [_]
                 (.pushNamed navigator "/compose")
                 nil))
        (.catchError (fn [_] nil)))
    nil))

(defn- confirm-delete! [ctx navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        mid (.-id msg)]
    (-> (m/showDialog
         .context ctx
         .builder
         (fn [dialog-ctx]
           (dialog/vertical-custom-dialog
            {:title "Delete message?"
             :width-factor 0.7
             :height-factor 0.5
             :body (mgl/MongolText "Move this message to Trash.")
             :actions
             [(m/TextButton
               .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx) false) nil)
               .child (mgl/MongolText "Cancel"))
              (m/TextButton
               .onPressed (fn [] (.pop (m/Navigator.of dialog-ctx) true) nil)
               .child (mgl/MongolText "Delete"
                                     .style (m/TextStyle .color m.Colors/red)))]})))
        (.then (fn [ok?]
                 (when ok?
                   (async/Future.delayed
                    (dart:core/Duration. .milliseconds 300)
                    (fn []
                      (execute-with-loading! ctx navigator #(mail/delete-message! mid) "Deleted"))))
                 nil))
        (.catchError (fn [_] nil)))
    nil))

(defn- move-to-folder-pressed! [ctx navigator ^mc/MailMessageWithBody detail role label]
  (let [^mc/MailMessageDto msg (.-message detail)
        mid (.-id msg)]
    (.pop navigator)
    (async/Future.delayed
     (dart:core/Duration. .milliseconds 300)
     (fn []
       (execute-with-loading!
        ctx navigator
        #(case role
           "inbox" (mail/move-to-inbox! mid)
           "archive" (mail/archive-message! mid)
           "trash" (mail/delete-message! mid)
           (mail/move-to-folder! mid role))
        (str "Moved to " label))))
    nil))

(def ^:private move-targets
  [{:role "inbox" :label "Inbox" :icon m.Icons/inbox}
   {:role "archive" :label "Archive" :icon m.Icons/archive_outlined}
   {:role "trash" :label "Trash" :icon m.Icons/delete_outline}])

(defn- folder-label [^mc/MailFolderDto f fallback]
  (let [n (.-name f)]
    (if (seq n) n fallback)))

(defn- folder-icon [role]
  (case role
    "inbox" m.Icons/inbox
    "archive" m.Icons/archive_outlined
    "trash" m.Icons/delete_outline
    m.Icons/folder_outlined))

(defn- current-folder-role [^mc/MailMessageDto msg]
  (or (.-folderRole msg)
      (when (#{"inbox" "archive" "trash" "sent" "draft" "junk"} (.-state msg))
        (.-state msg))))

(defn- move-targets-for [^mc/MailMessageDto msg]
  (let [current (current-folder-role msg)
        folders (:folder-list @store/app-state)
        by-role (into {}
                      (keep (fn [^mc/MailFolderDto f]
                              (when-let [r (.-role f)]
                                (when (#{"inbox" "archive" "trash"} r)
                                  [r f])))
                            folders))]
    (->> move-targets
         (remove #(= (:role %) current))
         (mapv (fn [{:keys [role label icon]}]
                 (let [^mc/MailFolderDto f (get by-role role)]
                   {:role role
                    :label (if f (folder-label f label) label)
                    :icon (if f (folder-icon role) icon)}))))))

(defn- show-move-to-sheet! [ctx navigator ^mc/MailMessageWithBody detail]
  (let [^mc/MailMessageDto msg (.-message detail)
        targets (move-targets-for msg)]
    (if (empty? targets)
      (toast/info! (toast/safe-ctx ctx) "No folders to move to")
      (bottom-sheet/bottom-sheet
       ctx
       (into [{:type :header :title "Move to Folder"}]
             (map (fn [{:keys [role label icon]}]
                    {:type :action
                     :title label
                     :icon icon
                     :on-tap #(move-to-folder-pressed!
                               ctx navigator detail role label)})
                  targets))
       :height-factor 0.4
       :show-handle? true
       :layout-mode :scroll))
    nil))

(defn screen []
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [message-detail downloading-attachment-ids last-error]} store/app-state]
   (let [msg (when message-detail (.-message ^mc/MailMessageWithBody message-detail))
         draft? (when msg (or (= (.-state ^mc/MailMessageDto msg) "draft")
                              (= (.-folderRole ^mc/MailMessageDto msg) "draft")))
         subject (if (or (nil? msg) (empty? (.-subject msg))) "No Subject" (.-subject msg))
         from (if msg (or (.-fromName msg) (.-from msg) "") "")
         to (if msg (or (.-to msg) "") "")
         date (if msg (format-date (.-date msg)) "")
         loading-body? (if msg (not (.-hasBody msg)) true)
         atts (when message-detail
                (vec (or (.-attachments ^mc/MailMessageWithBody message-detail) [])))
         cs (.-colorScheme (m/Theme.of ctx))
         meta-colors {:on-surface (.-onSurface cs)
                      :on-surface-variant (.-onSurfaceVariant cs)}
         leading (mail-body/meta-leading subject from to date meta-colors)]
     (m/Scaffold
      .appBar (m/AppBar
               .elevation 0.0
               .actions
               (cond-> []
                 (and msg draft?)
                 (conj (m/IconButton
                        .tooltip "Edit"
                        .icon (m/Icon m.Icons/edit_outlined)
                        .onPressed #(start-edit-draft! navigator message-detail)))
                 (and msg (not draft?))
                 (conj (m/IconButton
                        .tooltip "Reply"
                        .icon (m/Icon m.Icons/reply)
                        .onPressed #(start-reply! navigator message-detail))
                       (m/IconButton
                        .tooltip "Forward"
                        .icon (m/Icon m.Icons/forward)
                        .onPressed #(start-forward! navigator message-detail)))
                 (seq atts)
                 (conj (m/IconButton
                        .tooltip "Attachments"
                        .icon (m/Icon m.Icons/attach_file)
                        .onPressed #(attachments/show-sheet!
                                     ctx message-detail downloading-attachment-ids)))
                 (and msg (not draft?))
                 (conj (m/IconButton
                        .tooltip "Move to Folder"
                        .icon (m/Icon m.Icons/drive_file_move_outlined)
                        .onPressed #(show-move-to-sheet!
                                     ctx navigator message-detail)))
                 msg
                 (conj (m/IconButton
                        .icon (m/Icon m.Icons/delete_outline)
                        .onPressed #(confirm-delete! ctx navigator message-detail)))))
      .body
      (cond
        (nil? message-detail)
        (m/Center .child (if (seq last-error)
                           (m/Text (str last-error) .style (m/TextStyle .color m.Colors/red))
                           (m/CircularProgressIndicator.)))
        :else
        (m/SafeArea
         .child
         (if loading-body?
           (m/Padding
            .padding (m.EdgeInsets/all 16.0)
            .child
            (m/Row
             .crossAxisAlignment m.CrossAxisAlignment/start
             .children
             (conj
              leading
              (m/Expanded
               .child
               (m/Center
                .child
                (if (seq last-error)
                  (m/Padding
                   .padding (m.EdgeInsets/all 24.0)
                   .child
                   (m/Text (str "Failed to load body:\n" last-error)
                           .textAlign m.TextAlign/center
                           .style (m/TextStyle .color m.Colors/red .fontSize 13.0)))
                  (m/CircularProgressIndicator.)))))))
           (mail-body/body-view message-detail leading))))))))
