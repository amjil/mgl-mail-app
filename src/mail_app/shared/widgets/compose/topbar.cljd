(ns mail-app.shared.widgets.compose.topbar
  (:require ["package:flutter/material.dart" :as m]
            ["package:file_selector/file_selector.dart" :as fs]
            [cljd.flutter :as f]
            [clojure.string :as str]
            [mail-app.shared.toast :as toast]
            [mail-app.shared.actions.compose-actions :as compose-actions]
            [mail-app.services.compose-export :as export]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]
            [mail-app.theme :as theme]))

(defn- parse-ready? [to]
  (seq (str/trim (or to ""))))

(defn- basename [path]
  (or (last (str/split (or path "") #"[\\/]")) path))

(defn- pick-attachments! [!paths]
  (-> (fs/openFiles)
      (.then (fn [files]
               (let [new-paths (->> (or files [])
                                    (map #(.-path ^fs/XFile %))
                                    (remove empty?)
                                    vec)]
                 (when (seq new-paths)
                   (swap! !paths #(vec (distinct (concat % new-paths))))))
               nil))
      (.catchError (fn [_] nil))))


(defn send-pressed!
  [ctx navigator !doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
   show-cc? show-bcc? sending? current-account-id attachment-paths draft-meta]
  (let [tctx (toast/safe-ctx ctx)]
    (cond
      sending?
      nil

      (nil? current-account-id)
      (toast/error! tctx "No account configured")

      (not (parse-ready? (.-text to-ctrl)))
      (toast/warn! tctx "Recipient required")

      :else
      (let [payload (compose-actions/compose-body !doc-state !quote-state to-ctrl cc-ctrl
                                  bcc-ctrl subject-ctrl show-cc? show-bcc?
                                  attachment-paths draft-meta)]
        (-> (mail/send! payload)
            (.then (fn [_]
                     (toast/success! tctx "Queued for send")
                     (when (.canPop navigator) (.pop navigator))
                     nil))
            (.catchError (fn [e]
                           (toast/error! tctx (str "Send failed: " e))
                           nil)))))
    nil))

(defn save-draft-pressed!
  [ctx navigator !doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
   show-cc? show-bcc? sending? current-account-id attachment-paths draft-meta]
  (let [tctx (toast/safe-ctx ctx)]
    (cond
      sending?
      nil

      (nil? current-account-id)
      (toast/error! tctx "No account configured")

      :else
      (let [payload (compose-actions/compose-body !doc-state !quote-state to-ctrl cc-ctrl
                                  bcc-ctrl subject-ctrl show-cc? show-bcc?
                                  attachment-paths draft-meta)]
        (-> (mail/save-draft! payload)
            (.then (fn [_]
                     (toast/success! tctx "Saved to Drafts")
                     (when (.canPop navigator) (.pop navigator))
                     nil))
            (.catchError (fn [e]
                           (toast/error! tctx (str "Save draft failed: " e))
                           nil)))))
    nil))


(defn topbar
  "Back, Cc/Bcc toggle, attach, insert image, Save Draft, and Send."
  [{:keys [!doc-state !quote-state to-ctrl cc-ctrl bcc-ctrl subject-ctrl
           !show-cc? !show-bcc? !attachment-paths !draft-meta !auto-save-gate
           on-insert-image]}]
  (f/widget
   :context ctx
   :get [m/Navigator]
   :watch [{:keys [sending? current-account-id]} store/app-state
           show-cc? !show-cc?
           show-bcc? !show-bcc?
           attachment-paths !attachment-paths
           auto-save-state !auto-save-gate]
   :let [auto-saving? (:inflight? auto-save-state)
         send-blocked? (or sending? auto-saving?)]
   (m/Container
    .decoration (m/BoxDecoration
                 .color (theme/surface)
                 .boxShadow (theme/hair-shadow))
    .child
    (m/Column
     .mainAxisSize m.MainAxisSize/min
     .children
     (cond->
       [(m/SizedBox
         .height theme/chrome-height
         .child
         (m/Padding
          .padding (m.EdgeInsets/symmetric .horizontal theme/space-md)
          .child
          (m/Row
           .mainAxisAlignment m.MainAxisAlignment/spaceBetween
           .children
           [(m/IconButton
             .padding (m.EdgeInsets/all theme/space-md)
             .constraints (m/BoxConstraints. .minWidth 44.0 .minHeight 44.0)
             .style (m/IconButton.styleFrom
                     .hoverColor (theme/sky-light)
                     .highlightColor (theme/sky-soft)
                     .shape (m/RoundedRectangleBorder
                             .borderRadius (m/BorderRadius.circular theme/radius-md)))
             .tooltip "Back"
             .onPressed (fn [] (.pop navigator) nil)
             .icon (m/Icon m.Icons/arrow_back_ios_new .size 20.0 .color (theme/ink-muted)))
            (m/Row
             .children
             [(m/TextButton
               .onPressed (fn [] (swap! !show-cc? not) nil)
               .style (m/TextButton.styleFrom
                       .foregroundColor (if show-cc? (theme/sky) (theme/ink-muted))
                       .backgroundColor (when show-cc? (theme/sky-light))
                       .padding (m.EdgeInsets/symmetric .horizontal theme/space-md .vertical theme/space-sm)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .child (m/Text "Cc"
                              .style (m/TextStyle
                                      .fontSize theme/text-base
                                      .fontWeight (if show-cc?
                                                    m/FontWeight.w600
                                                    m/FontWeight.w500))))
              (m/SizedBox .width theme/space-xs)
              (m/TextButton
               .onPressed (fn [] (swap! !show-bcc? not) nil)
               .style (m/TextButton.styleFrom
                       .foregroundColor (if show-bcc? (theme/sky) (theme/ink-muted))
                       .backgroundColor (when show-bcc? (theme/sky-light))
                       .padding (m.EdgeInsets/symmetric .horizontal theme/space-md .vertical theme/space-sm)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .child (m/Text "Bcc"
                              .style (m/TextStyle
                                      .fontSize theme/text-base
                                      .fontWeight (if show-bcc?
                                                    m/FontWeight.w600
                                                    m/FontWeight.w500))))
              (m/SizedBox .width theme/space-md)
              (m/IconButton
               .padding (m.EdgeInsets/all theme/space-md)
               .constraints (m/BoxConstraints. .minWidth 44.0 .minHeight 44.0)
               .style (m/IconButton.styleFrom
                       .hoverColor (theme/sky-light)
                       .highlightColor (theme/sky-soft)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .tooltip "Attach"
               .onPressed (fn [] (pick-attachments! !attachment-paths) nil)
               .icon (m/Icon m.Icons/attach_file .size 20.0 .color (theme/ink-muted)))
              (m/IconButton
               .padding (m.EdgeInsets/all theme/space-md)
               .constraints (m/BoxConstraints. .minWidth 44.0 .minHeight 44.0)
               .style (m/IconButton.styleFrom
                       .hoverColor (theme/sky-light)
                       .highlightColor (theme/sky-soft)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .tooltip "Insert Image"
               .onPressed (fn []
                            (when on-insert-image (on-insert-image))
                            nil)
               .icon (m/Icon m.Icons/insert_photo_outlined .size 20.0 .color (theme/ink-muted)))
              (m/IconButton
               .padding (m.EdgeInsets/all theme/space-md)
               .constraints (m/BoxConstraints. .minWidth 44.0 .minHeight 44.0)
               .style (m/IconButton.styleFrom
                       .hoverColor (theme/sky-light)
                       .highlightColor (theme/sky-soft)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .tooltip "Save Draft"
               .onPressed (when-not send-blocked?
                            (fn []
                              (save-draft-pressed! ctx navigator !doc-state !quote-state
                                                   to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                                   show-cc? show-bcc? send-blocked?
                                                   current-account-id
                                                   attachment-paths @!draft-meta)))
               .icon (m/Icon m.Icons/drafts_outlined .size 20.0 .color (theme/ink-muted)))
              (m/SizedBox .width theme/space-md)
              (m/FilledButton.icon
               .onPressed (when-not send-blocked?
                            (fn []
                              (send-pressed! ctx navigator !doc-state !quote-state
                                             to-ctrl cc-ctrl bcc-ctrl subject-ctrl
                                             show-cc? show-bcc? send-blocked?
                                             current-account-id
                                             attachment-paths @!draft-meta)))
               .style (m/FilledButton.styleFrom
                       .backgroundColor (theme/sky)
                       .foregroundColor m.Colors/white
                       .elevation 2.0
                       .shadowColor (.withOpacity (theme/sky) 0.3)
                       .padding (m.EdgeInsets/symmetric .horizontal theme/space-xl .vertical theme/space-md)
                       .shape (m/RoundedRectangleBorder
                               .borderRadius (m/BorderRadius.circular theme/radius-md)))
               .icon (if sending?
                       (m/SizedBox
                        .width 18.0
                        .height 18.0
                        .child (m/CircularProgressIndicator.
                                .strokeWidth 2.5
                                .color m.Colors/white))
                       (m/Icon m.Icons/send .size 18.0))
               .label (m/Text "Send"
                              .style (m/TextStyle
                                      .fontSize theme/text-base
                                      .fontWeight m/FontWeight.w600)))])])))]
       (seq attachment-paths)
       (conj
        (m/Padding
         .padding (m.EdgeInsets/only .left theme/space-md 
                                     .right theme/space-md 
                                     .bottom theme/space-md)
         .child
         (m/Wrap
          .spacing theme/space-sm
          .runSpacing theme/space-sm
          .children
          (mapv (fn [path]
                  (m/InputChip
                   .label (m/Text (basename path)
                                  .style (m/TextStyle 
                                          .fontSize theme/text-sm 
                                          .color (theme/ink)
                                          .fontWeight m/FontWeight.w500))
                   .backgroundColor (theme/sky-light)
                   .side (m/BorderSide .color (theme/sky-soft) .width 1.0)
                   .padding (m.EdgeInsets/symmetric .horizontal theme/space-md .vertical theme/space-sm)
                   .deleteIconColor (theme/sky-deep)
                   .onDeleted (fn []
                                (swap! !attachment-paths
                                       #(vec (remove #{path} %)))
                                nil)))
                attachment-paths)))))))))
