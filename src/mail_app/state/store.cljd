(ns mail-app.state.store
  (:require ["package:shared_preferences/shared_preferences.dart" :as sp]
            ["dart:async" :as async]
            [clojure.string :as str]))

(def ^:private sig-prefix "mail_sig_")
(def ^:private pref-account "ui_current_account_id")
(def ^:private pref-folder-width "ui_folder_pane_width")
(def ^:private pref-mailbox "ui_selected_mailbox")

(defn- sig-key [account-id]
  (str sig-prefix account-id))

(defn- encode-mailbox [sel]
  (cond
    (nil? sel) nil
    (keyword? sel) (str ":" (name sel))
    :else (str "#" sel)))

(defn- decode-mailbox [s]
  (cond
    (or (nil? s) (empty? s)) nil
    (str/starts-with? s ":") (keyword (subs s 1))
    (str/starts-with? s "#")
    (try
      (dart:core/int.parse (subs s 1))
      (catch Exception _ nil))
    :else nil))

(defn- prefs-write!
  "Fire-and-forget SharedPreferences mutation. `write-fn` receives prefs and
  should return the Future from set*/remove."
  [write-fn]
  (-> (.getInstance sp/SharedPreferences)
      (.then write-fn)
      (.catchError (fn [e]
                     (dart:core/print (str "ui prefs write failed: " e))
                     nil)))
  nil)

(defn- persist-account-id! [account-id]
  (prefs-write!
   (fn [prefs]
     (if account-id
       (.setString prefs pref-account account-id)
       (.setString prefs pref-account "")))))

(defn- persist-mailbox! [sel]
  (prefs-write!
   (fn [prefs]
     (if-let [enc (encode-mailbox sel)]
       (.setString prefs pref-mailbox enc)
       (.remove prefs pref-mailbox)))))

(defn- persist-folder-width! [w]
  (prefs-write!
   (fn [prefs]
     (.setDouble prefs pref-folder-width (double w)))))

(defonce ^:private !folder-width-timer (atom nil))

(defonce app-state
  (atom {:accounts []
         :current-account-id nil
         :sending? false
         :syncing? false
         :last-error nil
         ;; IMAP folders for current account filter
         :folder-list []
         ;; :outbox | folder-id (int) | nil
         :selected-mailbox nil
         :mail-list []
         :outbox-list []
         :selected-message-id nil
         :message-detail nil
         ;; Home shell: reading pane expanded, folders+list collapsed
         :reading-mail? false
         ;; Desktop folder pane width (user-draggable)
         :folder-pane-width 320.0
         ;; search
         :search-query ""
         :search-results []
         :searching? false
         ;; attachment download in progress (id set)
         :downloading-attachment-ids #{}
         ;; compose prefill: {:to :cc :subject :body-plain :body-state :quote-state} or nil
         :compose-draft nil
         ;; multi-select / bulk actions
         :selected-message-ids #{}
         :last-clicked-index nil
         ;; expanded conversation thread keys
         :expanded-threads #{}
         ;; account-id -> signature plain text
         :signatures {}}))

(defn load-ui-prefs!
  "Hydrate account / mailbox / folder-pane width from SharedPreferences."
  []
  (try
    (let [prefs (await (.getInstance sp/SharedPreferences))
          aid (.getString prefs pref-account)
          width (.getDouble prefs pref-folder-width)
          mailbox (decode-mailbox (.getString prefs pref-mailbox))]
      (swap! app-state
             (fn [s]
               (cond-> s
                 ;; "" means explicit "all accounts"; missing key leaves default nil
                 (some? aid)
                 (assoc :current-account-id (if (empty? aid) nil aid))

                 (some? width)
                 (assoc :folder-pane-width (double width))

                 (some? mailbox)
                 (assoc :selected-mailbox mailbox)))))
    (catch Exception e
      (dart:core/print (str "load-ui-prefs failed: " e)))))

(defn set-accounts! [accounts]
  (swap! app-state assoc :accounts (or accounts [])))

(defn set-current-account! [account-id]
  (swap! app-state assoc :current-account-id account-id)
  (persist-account-id! account-id))

(defn set-sending! [v]
  (swap! app-state assoc :sending? (boolean v)))

(defn set-syncing! [v]
  (swap! app-state assoc :syncing? (boolean v)))

(defn set-error! [msg]
  (swap! app-state assoc :last-error msg))

(defn set-folder-list! [folders]
  (swap! app-state assoc :folder-list (or folders [])))

(defn set-selected-mailbox! [sel]
  (swap! app-state assoc :selected-mailbox sel)
  (persist-mailbox! sel))

(defn set-mail-list! [msgs]
  (swap! app-state assoc :mail-list (or msgs [])))

(defn set-outbox-list! [rows]
  (swap! app-state assoc :outbox-list (or rows [])))

(defn set-selected-message! [id]
  (swap! app-state assoc :selected-message-id id))

(defn set-message-detail! [detail]
  (swap! app-state assoc :message-detail detail))

(defn clear-message-detail! []
  (swap! app-state assoc :selected-message-id nil :message-detail nil))

(defn set-reading-mail! [v]
  (swap! app-state assoc :reading-mail? (boolean v)))

(defn set-folder-pane-width! [w]
  (let [w (double w)]
    (swap! app-state assoc :folder-pane-width w)
    (when-let [^async/Timer t @!folder-width-timer]
      (.cancel t))
    (reset! !folder-width-timer
            (async/Timer.
             (dart:core/Duration. .milliseconds 250)
             (fn []
               (reset! !folder-width-timer nil)
               (persist-folder-width! (:folder-pane-width @app-state)))))))

(defn exit-reading!
  "Leave reading mode; keep selected-message-id highlight and body cache."
  []
  (swap! app-state assoc :reading-mail? false))

(defn set-search-query! [q]
  (swap! app-state assoc :search-query (or q "")))

(defn set-search-results! [rows]
  (swap! app-state assoc :search-results (or rows [])))

(defn set-searching! [v]
  (swap! app-state assoc :searching? (boolean v)))

(defn mark-downloading! [att-id on?]
  (swap! app-state update :downloading-attachment-ids
         (fn [s]
           (let [s (or s #{})]
             (if on? (conj s att-id) (disj s att-id))))))

(defn set-compose-draft! [draft]
  (swap! app-state assoc :compose-draft draft))

(defn clear-compose-draft! []
  (swap! app-state assoc :compose-draft nil))

(defn clear-error! []
  (swap! app-state assoc :last-error nil))

(defn set-selected-message-ids! [ids]
  (swap! app-state assoc :selected-message-ids (set ids)))

(defn clear-message-selection! []
  (swap! app-state assoc :selected-message-ids #{}
                         :last-clicked-index nil))

(defn toggle-message-selection! [id]
  (swap! app-state update :selected-message-ids
         (fn [ids]
           (if (contains? ids id)
             (disj ids id)
             (conj ids id)))))

(defn set-last-clicked-index! [idx]
  (swap! app-state assoc :last-clicked-index idx))

(defn toggle-thread-expansion! [thread-key]
  (swap! app-state update :expanded-threads
         (fn [s]
           (let [s (or s #{})]
             (if (contains? s thread-key)
               (disj s thread-key)
               (conj s thread-key))))))

(defn clear-thread-expansion! []
  (swap! app-state assoc :expanded-threads #{}))

(defn load-signatures!
  "Hydrate :signatures from SharedPreferences (key mail_sig_<accountId>)."
  []
  (try
    (let [prefs (await (.getInstance sp/SharedPreferences))
          keys (.getKeys prefs)
          sigs (into {}
                     (for [k keys
                           :let [ks (str k)]
                           :when (str/starts-with? ks sig-prefix)]
                       [(subs ks (count sig-prefix))
                        (or (.getString prefs ks) "")]))]
      (swap! app-state assoc :signatures sigs))
    (catch Exception e
      (dart:core/print (str "load-signatures failed: " e)))))

(defn set-signature!
  "Update in-memory signature and persist to SharedPreferences."
  [account-id sig]
  (let [text (or sig "")]
    (swap! app-state assoc-in [:signatures account-id] text)
    (try
      (let [prefs (await (.getInstance sp/SharedPreferences))]
        (await (.setString prefs (sig-key account-id) text)))
      (catch Exception e
        (dart:core/print (str "persist signature failed: " e))))))

(defn clear-signature!
  "Drop signature for a removed account (memory + prefs)."
  [account-id]
  (swap! app-state update :signatures dissoc account-id)
  (try
    (let [prefs (await (.getInstance sp/SharedPreferences))]
      (await (.remove prefs (sig-key account-id))))
    (catch Exception e
      (dart:core/print (str "clear signature failed: " e)))))

(defn get-signature [account-id]
  (get-in @app-state [:signatures account-id]
          "Sent from MGL Mail\nwww.mglmail.com"))
