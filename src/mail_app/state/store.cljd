(ns mail-app.state.store)

(defonce app-state
  (atom {:accounts []
         :current-account-id nil
         :sending? false
         :syncing? false
         :last-error nil
         ;; IMAP folders for current account filter
         :folder-list []
         ;; :outbox | folder-id (int) | nil
         :selected-mailbox nil
         :mail-list []
         :outbox-list []
         :selected-message-id nil
         :message-detail nil
         ;; Home shell: reading pane expanded, folders+list collapsed
         :reading-mail? false
         ;; search
         :search-query ""
         :search-results []
         :searching? false
         ;; attachment download in progress (id set)
         :downloading-attachment-ids #{}
         ;; compose prefill: {:to :cc :subject :body-plain :body-state :quote-state} or nil
         :compose-draft nil
         ;; multi-select / bulk actions
         :selected-message-ids #{}
         :last-clicked-index nil
         ;; expanded conversation thread keys
         :expanded-threads #{}
         ;; account-id -> signature plain text
         :signatures {}}))

(defn set-accounts! [accounts]
  (swap! app-state assoc :accounts (or accounts [])))

(defn set-current-account! [account-id]
  (swap! app-state assoc :current-account-id account-id))

(defn set-sending! [v]
  (swap! app-state assoc :sending? (boolean v)))

(defn set-syncing! [v]
  (swap! app-state assoc :syncing? (boolean v)))

(defn set-error! [msg]
  (swap! app-state assoc :last-error msg))

(defn set-folder-list! [folders]
  (swap! app-state assoc :folder-list (or folders [])))

(defn set-selected-mailbox! [sel]
  (swap! app-state assoc :selected-mailbox sel))

(defn set-mail-list! [msgs]
  (swap! app-state assoc :mail-list (or msgs [])))

(defn set-outbox-list! [rows]
  (swap! app-state assoc :outbox-list (or rows [])))

(defn set-selected-message! [id]
  (swap! app-state assoc :selected-message-id id))

(defn set-message-detail! [detail]
  (swap! app-state assoc :message-detail detail))

(defn clear-message-detail! []
  (swap! app-state assoc :selected-message-id nil :message-detail nil))

(defn set-reading-mail! [v]
  (swap! app-state assoc :reading-mail? (boolean v)))

(defn exit-reading!
  "Leave reading mode; keep selected-message-id highlight and body cache."
  []
  (swap! app-state assoc :reading-mail? false))

(defn set-search-query! [q]
  (swap! app-state assoc :search-query (or q "")))

(defn set-search-results! [rows]
  (swap! app-state assoc :search-results (or rows [])))

(defn set-searching! [v]
  (swap! app-state assoc :searching? (boolean v)))

(defn mark-downloading! [att-id on?]
  (swap! app-state update :downloading-attachment-ids
         (fn [s]
           (let [s (or s #{})]
             (if on? (conj s att-id) (disj s att-id))))))

(defn set-compose-draft! [draft]
  (swap! app-state assoc :compose-draft draft))

(defn clear-compose-draft! []
  (swap! app-state assoc :compose-draft nil))

(defn clear-error! []
  (swap! app-state assoc :last-error nil))

(defn set-selected-message-ids! [ids]
  (swap! app-state assoc :selected-message-ids (set ids)))

(defn clear-message-selection! []
  (swap! app-state assoc :selected-message-ids #{}
                         :last-clicked-index nil))

(defn toggle-message-selection! [id]
  (swap! app-state update :selected-message-ids
         (fn [ids]
           (if (contains? ids id)
             (disj ids id)
             (conj ids id)))))

(defn set-last-clicked-index! [idx]
  (swap! app-state assoc :last-clicked-index idx))

(defn toggle-thread-expansion! [thread-key]
  (swap! app-state update :expanded-threads
         (fn [s]
           (let [s (or s #{})]
             (if (contains? s thread-key)
               (disj s thread-key)
               (conj s thread-key))))))

(defn clear-thread-expansion! []
  (swap! app-state assoc :expanded-threads #{}))

(defn set-signature! [account-id sig]
  (swap! app-state assoc-in [:signatures account-id] sig))

(defn get-signature [account-id]
  (get-in @app-state [:signatures account-id]
          "Sent from MGL Mail\nwww.mglmail.com"))
