(ns mail-app.bootstrap.mobile
  "Mobile startup: FST / next-word dictionaries for the in-app virtual keyboard.
   `TextInput.setInputControl` is installed per-screen (compose) so signup
   and other Material fields keep the platform IME."
  (:require [mail-app.bootstrap.ime :as ime]))

(defn init!
  "Load IME dictionaries used by mgl-block-editor's mobile virtual keyboard."
  []
  (ime/init! "mobile"))
