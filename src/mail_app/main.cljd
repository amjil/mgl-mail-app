(ns mail-app.main
  (:require ["package:flutter/material.dart" :as m]
            ["package:mgl_mail_app/mail_core/mail_core.dart" :as mc]
            [cljd.flutter :as f]
            [mail-app.platform :as platform]
            [mail-app.bootstrap.desktop :as desktop-boot]
            [mail-app.bootstrap.mobile :as mobile-boot]
            [mail-app.desktop :as desktop]
            [mail-app.mobile :as mobile]
            [mail-app.services.mail-core :as mail]
            [mail-app.state.store :as store]))

(defn main []
  (m/WidgetsFlutterBinding.ensureInitialized)

  ;; Native mobile notification permissions + periodic background sync.
  (when (platform/mobile?)
    (try
      (await (mc.NotificationService/initialize))
      (await (mc.BackgroundService/initialize))
      (await (mc.BackgroundService/registerPeriodicSync))
      (catch Exception e
        (dart:core/print (str "notification/background init failed: " e)))))

  (try
    (if (platform/desktop?)
      (await (desktop-boot/init!))
      (mobile-boot/init!))
    (catch Exception e
      (dart:core/print (str "bootstrap failed: " e))))

  ;; UI prefs + signatures (SharedPreferences) — soft-fail; prefs before mail init
  (try
    (await (store/load-ui-prefs!))
    (catch Exception e
      (dart:core/print (str "load ui prefs failed: " e))))
  (try
    (await (store/load-signatures!))
    (catch Exception e
      (dart:core/print (str "load signatures failed: " e))))

  ;; MailBridge init — soft-fail so UI still launches without DB issues
  (try
    (await (mail/init!))
    (catch Exception e
      (dart:core/print (str "mail-core init failed: " e))))

  (f/run
   (if (platform/desktop?)
     (desktop/app)
     (mobile/app))))
